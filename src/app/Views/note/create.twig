{% extends "layouts/mobile_base.twig" %}

{% import "components/_icons.twig" as icons %}

{% set employee_label = employee.display_name ?? employee.employee_name ?? ((employee.name ?? '') ~ ' ' ~ (employee.surname ?? ''))|trim %}
{% set back_url = shop_id
    ? (employee_id
        ? (ROOT ~ '/shops/' ~ shop_id ~ '/employees/' ~ employee_id ~ '/notes')
        : (ROOT ~ '/shops/' ~ shop_id ~ '/notes'))
    : (ROOT ~ '/notes') %}

{% block title %}{{ translations.new_note ?? 'Nouvelle note' }} — Consultant Panel{% endblock %}
{% block page_title %}{{ translations.new_note ?? 'Nouvelle note' }}{% endblock %}
{% block page_subtitle %}{{ translations.note_target_hint ?? 'Choisissez la boutique et, au besoin, la personne concernée' }}{% endblock %}

{% block head %}
<style>
    .nt-ctx {
        background:#fff; border:1px solid rgba(141,29,44,.14); border-radius:16px;
        padding:14px; margin-bottom:16px; box-shadow:0 2px 8px rgba(0,0,0,.05);
    }
    .nt-ctx-title { font-size:.7rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; color:#8D1D2C; margin-bottom:10px; display:flex; align-items:center; gap:6px; }
    .nt-ctx .form-label { font-size:.8rem; font-weight:700; color:#495057; margin-bottom:4px; }
    .nt-ctx select { font-size:.9rem; }
    .nt-ctx-row + .nt-ctx-row { margin-top:10px; }

    /* Bouton « retour » (tap-target clair, à la charte). */
    .nt-back-btn {
        display:inline-flex; align-items:center; gap:6px;
        padding:7px 14px 7px 10px; margin-bottom:14px;
        border:1.5px solid rgba(141,29,44,.18); border-radius:999px; background:#fff;
        color:#8D1D2C; font-size:.82rem; font-weight:700; text-decoration:none;
        box-shadow:0 1px 4px rgba(0,0,0,.05);
        transition:background .15s, border-color .15s, transform .1s;
        -webkit-tap-highlight-color:transparent;
    }
    .nt-back-btn:active { background:rgba(141,29,44,.06); border-color:rgba(141,29,44,.4); transform:scale(.98); }

    /* Boutons photo : tuiles icône + libellé, à la charte (accent #8D1D2C). */
    .nt-photo-actions { display:flex; gap:10px; }
    .nt-photo-btn {
        flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px;
        margin:0; padding:12px 8px;
        border:1.5px solid rgba(141,29,44,.18); border-radius:14px; background:#fff;
        color:#8D1D2C; font-size:.76rem; font-weight:700; text-align:center; line-height:1.2;
        cursor:pointer; transition:background .15s, border-color .15s, transform .1s;
        -webkit-tap-highlight-color:transparent;
    }
    .nt-photo-btn:active { background:rgba(141,29,44,.06); border-color:rgba(141,29,44,.4); transform:scale(.98); }
    .nt-photo-btn svg { width:22px; height:22px; }
</style>
{% endblock %}

{% block content %}
<div class="page-content-loaded">

    <a href="{{ back_url }}" class="nt-back-btn">
        {{ icons.svg('chevron-left', 16) }}
        <span>{{ translations.notes_back ?? 'Notes' }}</span>
    </a>

    {% if errors.save is defined %}
        <div class="alert alert-danger rounded-3 mb-3" role="alert">
            <span class="me-2">{{ icons.svg('circle-alert') }}</span>{{ errors.save }}
        </div>
    {% endif %}

    <form method="POST" action="{{ ROOT }}/notes/new"
          enctype="multipart/form-data" novalidate>

        {# ── Cible de la note : toujours visible et modifiable ── #}
        <div class="nt-ctx">
            <div class="nt-ctx-title">{{ icons.svg('map-pin', 14) }}{{ translations.note_target ?? 'Cible de la note' }}</div>

            <div class="nt-ctx-row">
                <label class="form-label" for="ntShop">{{ translations.shop ?? 'Boutique' }} <span class="text-danger">*</span></label>
                <select name="shop_id" id="ntShop" required
                        class="form-select form-select-sm rounded-3 {{ errors.shop is defined ? 'is-invalid' : '' }}">
                    <option value="">{{ translations.choose_shop ?? '— Choisir une boutique —' }}</option>
                    {% for s in shops %}
                        <option value="{{ s.id }}" {{ shop_id == s.id ? 'selected' : '' }}>
                            {{ s.representative_name ?? s.name }}
                        </option>
                    {% endfor %}
                </select>
                {% if errors.shop is defined %}
                    <div class="invalid-feedback">{{ errors.shop }}</div>
                {% endif %}
            </div>

            <div class="nt-ctx-row">
                <label class="form-label" for="ntEmployee">
                    {{ icons.svg('user', 13) }} {{ translations.staff_member ?? 'Personne' }}
                    <span class="text-muted" style="font-weight:400;">{{ translations.optional ?? '(optionnel)' }}</span>
                </label>
                <select name="employee_id" id="ntEmployee" class="form-select form-select-sm rounded-3"
                        data-selected="{{ employee_id ?? '' }}">
                    <option value="">{{ translations.whole_shop ?? 'Toute la boutique' }}</option>
                    {% for e in employees %}
                        {% set enm = e.display_name ?? e.employee_name ?? ((e.name ?? '') ~ ' ' ~ (e.surname ?? ''))|trim %}
                        <option value="{{ e.id }}" {{ employee_id == e.id ? 'selected' : '' }}>
                            {{ enm ?: ('#' ~ e.id) }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-600" style="font-size:.88rem;">{{ translations.category ?? 'Catégorie' }}
                <span class="text-muted fw-400">{{ translations.optional ?? '(optionnelle)' }}</span>
            </label>
            <select name="note_type_id" class="form-select form-select-sm rounded-3">
                <option value="">{{ translations.no_category_option ?? '- sans catégorie -' }}</option>
                {% for type in note_types %}
                    <option value="{{ type.id }}"
                        {{ old('note_type_id') == type.id ? 'selected' : '' }}>
                        {{ type.name }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-600" style="font-size:.88rem;">
                {{ translations.note_content ?? 'Contenu de la note' }} <span class="text-danger">*</span>
            </label>
            <textarea name="content" rows="5"
                      class="form-control rounded-3 {{ errors.content is defined ? 'is-invalid' : '' }}"
                      placeholder="{{ translations.describe_ph ?? "Décrivez l'observation ou le problème..." }}" style="font-size:.9rem;">{{ old('content') }}</textarea>
            {% if errors.content is defined %}
                <div class="invalid-feedback">{{ errors.content }}</div>
            {% endif %}
        </div>

        {# Photos : « Prendre une photo » (capture caméra) OU « Choisir » (galerie). Max 4. #}
        <div class="mb-3">
            <div class="form-label" style="font-size:.82rem;color:#6c757d;">
                <span class="me-1">{{ icons.svg('camera') }}</span>{{ translations.photos ?? 'Photos' }}
                <span class="text-muted">{{ translations.attachments_hint ?? '(optionnel, max 4 × 10 Mo, jpg/png/webp)' }}</span>
            </div>
            <div class="nt-photo-actions">
                <label class="nt-photo-btn">
                    {{ icons.svg('camera', 22) }}
                    <span>{{ translations.take_photo ?? 'Prendre une photo' }}</span>
                    <input type="file" name="photos[]" accept="image/*" capture="environment" style="display:none" onchange="ntPhotoNames(this)">
                </label>
                <label class="nt-photo-btn">
                    {{ icons.svg('paperclip', 22) }}
                    <span>{{ translations.choose_photo ?? 'Choisir' }}</span>
                    <input type="file" name="photos[]" accept="image/*" multiple style="display:none" onchange="ntPhotoNames(this)">
                </label>
            </div>
            <div id="ntPhotoNames" class="mt-2" style="font-size:.76rem;font-weight:700;color:#2D7A3E;"></div>
        </div>

        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-700">
            <span class="me-2">{{ icons.svg('check') }}</span>{{ translations.save_note ?? 'Enregistrer la note' }}
        </button>
    </form>

</div>
{% endblock %}

{% block scripts %}
<script>
/* Photos : redimensionnement + ré-encodage JPEG côté navigateur avant l'envoi.
 * Les photos prises par l'appareil sont souvent très lourdes (plusieurs Mo) et
 * parfois en HEIC (iOS) → rejetées par la limite d'upload ou non affichables.
 * On les ramène à ~1600px / JPEG qualité .82, ce qui règle les deux et allège
 * l'envoi. La FileList de l'input est remplacée par les versions compressées. */
function ntCompress(file, maxDim, quality) {
    return new Promise(function (resolve) {
        if (!(file.type || '').match(/^image\//) && !(file.name || '').match(/\.(jpe?g|png|gif|webp|heic|heif|bmp|avif)$/i)) {
            return resolve(file); // pas une image → tel quel
        }
        var url = URL.createObjectURL(file);
        var img = new Image();
        img.onload = function () {
            URL.revokeObjectURL(url);
            var w = img.naturalWidth || img.width, h = img.naturalHeight || img.height;
            if (!w || !h) return resolve(file);
            var scale = Math.min(1, maxDim / Math.max(w, h));
            var cw = Math.round(w * scale), ch = Math.round(h * scale);
            var canvas = document.createElement('canvas');
            canvas.width = cw; canvas.height = ch;
            try {
                canvas.getContext('2d').drawImage(img, 0, 0, cw, ch);
            } catch (e) { return resolve(file); }
            canvas.toBlob(function (blob) {
                if (!blob) return resolve(file);
                var name = (file.name || 'photo').replace(/\.(heic|heif|png|webp|bmp|gif|avif)$/i, '.jpg');
                if (!name.match(/\.jpe?g$/i)) name += '.jpg';
                try {
                    resolve(new File([blob], name, { type: 'image/jpeg', lastModified: Date.now() }));
                } catch (e) { resolve(blob); }
            }, 'image/jpeg', quality);
        };
        img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
    });
}

function ntPhotoNames(input) {
    var box = document.getElementById('ntPhotoNames');
    var files = Array.prototype.slice.call(input.files || []);
    if (!files.length) return;
    if (box) box.textContent = '…';
    if (typeof DataTransfer === 'undefined' || typeof File === 'undefined') {
        if (box) box.textContent = '✓ ' + files.map(function (f) { return f.name; }).join(', ');
        return; // navigateur ancien : envoi tel quel
    }
    Promise.all(files.slice(0, 4).map(function (f) { return ntCompress(f, 800, 0.82); }))
        .then(function (out) {
            try {
                var dt = new DataTransfer();
                out.forEach(function (f) { dt.items.add(f); });
                input.files = dt.files;
            } catch (e) { /* si le remplacement échoue, on garde les fichiers d'origine */ }
            if (box) box.textContent = '✓ ' + out.map(function (f) { return f.name; }).join(', ');
        });
}
</script>
<script>
/* Charge la liste du personnel de la boutique choisie (via le proxy) et
 * repeuple le select « Personne ». Endpoint déjà autorisé : /shops/{id}/employees. */
(function () {
    'use strict';
    var shopSel = document.getElementById('ntShop');
    var empSel  = document.getElementById('ntEmployee');
    if (!shopSel || !empSel || typeof ConsultantAjax === 'undefined') return;

    var WHOLE = empSel.options.length ? empSel.options[0].textContent : 'Toute la boutique';

    function label(e) {
        var n = e.display_name || e.employee_name
            || ((e.name || '') + ' ' + (e.surname || '')).trim();
        return n || ('#' + e.id);
    }

    function fillEmployees(list, selectedId) {
        empSel.innerHTML = '';
        var opt0 = document.createElement('option');
        opt0.value = ''; opt0.textContent = WHOLE;
        empSel.appendChild(opt0);
        (list || []).forEach(function (e) {
            if (e == null || e.id == null) return;
            var o = document.createElement('option');
            o.value = e.id;
            o.textContent = label(e);
            if (selectedId && String(selectedId) === String(e.id)) o.selected = true;
            empSel.appendChild(o);
        });
    }

    function loadEmployees(shopId, selectedId) {
        if (!shopId) { fillEmployees([], null); return; }
        empSel.disabled = true;
        ConsultantAjax.load({
            endpoint: '/shops/' + shopId + '/employees',
            onSuccess: function (data) { fillEmployees(data || [], selectedId); empSel.disabled = false; },
            onError:   function ()     { fillEmployees([], null); empSel.disabled = false; },
        });
    }

    // Au changement de boutique → recharge le personnel (aucune sélection reprise).
    shopSel.addEventListener('change', function () {
        loadEmployees(shopSel.value, null);
    });

    // Les employés de la boutique déjà choisie sont rendus côté serveur ; on ne
    // recharge donc que si aucune option n'est présente (ex. retour arrière).
    if (shopSel.value && empSel.options.length <= 1) {
        loadEmployees(shopSel.value, empSel.dataset.selected || null);
    }
})();
</script>
{% endblock %}
