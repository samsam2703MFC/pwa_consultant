{# layouts/mobile_base.twig #}
{% import "components/_icons.twig" as icons %}
<!DOCTYPE html>
<html lang="{{ lang_code ?? 'pl' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{% block title %}{{ translations.consultant_panel ?? 'Consultant Panel' }}{% endblock %}</title>

    {# Racine de l'application, définie AVANT tout autre script.
       Elle vivait en bas de page, après le bloc `content` : un script inline
       placé dans `content` — plusieurs écrans le font — s'exécutait donc avec
       une racine VIDE et appelait « /trends/data » à la racine du domaine au
       lieu de « /pwa_consultant/trends/data ». Résultat : 404, écran vide. #}
    <script>window.__consultantRoot = {{ (ROOT ?? '')|json_encode|raw }};</script>

    {# Ouvre la connexion aux serveurs de polices en amont (DNS+TLS) pendant que
       le HTML se parse → la police bloque moins le premier rendu. #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    {# bootstrap-icons (police, ~98 Ko bloquant) retiré : les icônes sont en SVG
       inline (_icons.twig) ; les rares icônes générées en JS le sont aussi. #}
    <link rel="stylesheet" href="{{ ROOT }}/assets/mazer/compiled/css/app.css?v={{ assetv('assets/mazer/compiled/css/app.css') }}">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/atelier-theme.css?v={{ assetv('assets/css/atelier-theme.css') }}">

    <link rel="manifest" href="{{ ROOT }}/manifest.webmanifest">
    <meta name="theme-color" content="#8D1D2C">

    {# iOS PWA #}
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="apple-touch-icon" href="{{ ROOT }}/assets/pwa/icon-192.png">

    <style>
        :root {
            --app-tabbar-h: 72px;
        }

        body {
            background: #f2f7ff;
        }

        /* CONTENT */
        .app-content {
            padding-bottom: 24px;
        }
        /* TOP BAR */
        .app-topbar {
            position: sticky;
            top: 0;
            z-index: 1020;
            padding-top: env(safe-area-inset-top, 0px);
            background: rgba(242, 247, 255, .92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0, 0, 0, .05);
        }
        .app-topbar-inner {
            min-height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px;
            padding: 8px 0;
        }
        .app-title {
            font-weight: 800;
            letter-spacing: -0.02em;
            margin: 0;
            font-size: 1.05rem;
        }
        .app-subtitle {
            margin: 0;
            font-size: .85rem;
            color: #6c757d;
        }
        /* HAMBURGER BUTTON */
        /* Le menu est le bouton le plus utilisé de l'application : il vit sur
           tous les écrans. Il mesurait 29×25 — sous le seuil au-dessous duquel
           une cible tactile devient un pari. */
        .app-hamburger {
            background: none;
            border: none;
            min-width: 44px;
            min-height: 44px;
            padding: 6px 8px;
            border-radius: 12px;
            color: #8D1D2C;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s;
            -webkit-tap-highlight-color: transparent;
        }
        .app-hamburger:active { background: rgba(141,29,44,.1); }
        .app-hamburger i { font-size: 1.5rem; line-height: 1; }
        /* BACKDROP */
        .app-nav-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1040;
            background: rgba(0,0,0,.4);
            opacity: 0;
            transition: opacity .25s;
        }
        .app-nav-backdrop.is-open {
            display: block;
            opacity: 1;
        }
        /* TOP SHEET */
        .app-nav-sheet {
            position: fixed;
            left: 0;
            right: 0;
            top: 0;
            z-index: 1050;
            background: #fff;
            border-radius: 0 0 28px 28px;
            box-shadow: 0 12px 48px rgba(0,0,0,.16);
            padding-top: env(safe-area-inset-top, 0px);
            transform: translateY(-100%);
            transition: transform .32s cubic-bezier(.32,1.08,.64,1);
            will-change: transform;
            max-height: 92dvh;
            overflow-y: auto;
            overscroll-behavior: contain;
        }
        .app-nav-sheet.is-open {
            transform: translateY(0);
        }
        .app-nav-sheet-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px 12px;
            border-bottom: 1px solid rgba(0,0,0,.06);
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 1;
        }
        .app-nav-sheet-title {
            font-weight: 800;
            font-size: .95rem;
            color: #212529;
            margin: 0;
            letter-spacing: -.01em;
        }
        /* Fermer le menu : 30×30 auparavant, dans un coin d'écran — l'endroit
           le plus difficile à viser au pouce. */
        .app-nav-sheet-close {
            background: rgba(0,0,0,.06);
            border: none;
            width: 44px; height: 44px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            font-size: .95rem;
            color: #6c757d;
            transition: background .15s;
            flex-shrink: 0;
        }
        .app-nav-sheet-close:active { background: rgba(0,0,0,.12); }
        .app-nav-sheet-handle {
            width: 40px; height: 4px;
            background: #dee2e6;
            border-radius: 2px;
            margin: 6px auto 0;
        }
        /* NAV LIST */
        .app-nav-grid {
            display: flex;
            flex-direction: column;
            gap: 2px;
            padding: 8px 12px 16px;
        }
        .app-nav-card {
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 11px 12px;
            border-radius: 14px;
            background: transparent;
            transition: background .15s;
            -webkit-tap-highlight-color: transparent;
            color: #212529;
        }
        .app-nav-card:active { background: rgba(141,29,44,.07); }
        .app-nav-card.is-active { background: rgba(141,29,44,.08); }
        .app-nav-card-icon {
            width: 38px; height: 38px;
            border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .app-nav-card-icon i { font-size: 1.1rem; }
        .app-nav-card-label {
            font-weight: 700;
            font-size: .9rem;
            flex: 1;
        }
        .app-nav-card.is-active .app-nav-card-label { color: #8D1D2C; }

        /* ── Bouton « retour » unifié (toute l'app) ──
           Même affordance de retour partout : pastille claire à la charte,
           chevron + libellé adéquat. `--block` : pleine largeur (pieds de page
           / écrans d'action). ── */
        .app-back-btn {
            display: inline-flex; align-items: center; gap: 6px;
            /* 36 px auparavant : le retour est une action fréquente, elle
               mérite la même hauteur que les autres. */
            min-height: 44px;
            padding: 7px 14px 7px 10px; margin-bottom: 14px;
            border: 1.5px solid rgba(141,29,44,.18); border-radius: 999px; background: #fff;
            color: #8D1D2C; font-size: .82rem; font-weight: 700; text-decoration: none;
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
            transition: background .15s, border-color .15s, transform .1s;
            -webkit-tap-highlight-color: transparent;
        }
        .app-back-btn:active { background: rgba(141,29,44,.06); border-color: rgba(141,29,44,.4); transform: scale(.98); }
        .app-back-btn svg { width: 16px; height: 16px; flex-shrink: 0; }
        .app-back-btn--block { display: flex; width: 100%; justify-content: center; padding: 11px 14px; margin-bottom: 0; }
    </style>

    {% block head %}{% endblock %}

    <style>
        @keyframes shimmer {
            0%   { background-position: -200% 0; }
            100% { background-position:  200% 0; }
        }
        .skeleton-line {
            height: 16px; border-radius: 8px; margin-bottom: 10px;
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
        }
        .skeleton-card {
            background: #fff; border-radius: 16px; padding: 16px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 12px;
        }
        .skeleton-hero {
            border-radius: 20px; padding: 22px; margin-bottom: 12px;
            background: linear-gradient(90deg, #e8e8e8 25%, #d8d8d8 50%, #e8e8e8 75%);
            background-size: 200% 100%;
            animation: shimmer 1.4s infinite;
            min-height: 110px;
        }
        .page-content-loaded { animation: fadeIn .3s ease; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── Transitions de page (View Transitions API — navigateurs compatibles,
           ignoré ailleurs). Fondu doux entre pages au lieu du flash blanc ; la
           barre du haut et la tabbar gardent leur place (mêmes noms → pas de
           scintillement). Couplé au prefetch spéculatif → navigation fluide. ── */
        @view-transition { navigation: auto; }
        ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .2s; }
        .app-topbar     { view-transition-name: app-topbar; }
        .app-tabbar-bar { view-transition-name: app-tabbar; }
        @media (prefers-reduced-motion: reduce) {
            ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
        }

        /* ── Barre de progression de navigation : le tap est acquitté
           instantanément, même avant que la page suivante s'affiche. ── */
        #nav-progress {
            position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 3000;
            transform: scaleX(0); transform-origin: 0 50%;
            background: linear-gradient(90deg, #8D1D2C, #b2455a);
            opacity: 0; transition: transform .2s ease, opacity .2s ease; pointer-events: none;
        }
        #nav-progress.is-active { opacity: 1; }

        /* ── Allègement du rendu des longues listes (le navigateur ne peint que
           ce qui est visible). contain-intrinsic-size réserve la hauteur pour
           éviter les sauts de scroll. ── */
        .tk-card { content-visibility: auto; contain-intrinsic-size: auto 120px; }

        /* ── Utilitaires courants conservés même après purge CSS (sinon absents
           d'app.css purgé s'ils n'étaient pas utilisés au moment de la purge). ── */
        .d-none { display: none !important; }
        .flex-fill { flex: 1 1 auto !important; }
        .visually-hidden {
            position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
            overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
        }
    </style>
</head>
<body>

<div id="nav-progress" aria-hidden="true"></div>

{% if dev_no_auth %}
<div style="position:sticky;top:0;z-index:2000;background:#8D1D2C;color:#fff;font-family:'Gotham',sans-serif;font-size:.72rem;font-weight:600;text-align:center;padding:4px 8px;letter-spacing:.04em;">
    ⚠ MODE TEST — sans authentification (DEV_NO_AUTH). À désactiver avant mise en production.
</div>
{% endif %}

{% block topbar %}
    <div class="app-topbar">
        <div class="container">
            <div class="app-topbar-inner">
                <div>
                    <p class="app-title">{% block page_title %}{{ translations.consultant ?? 'Consultant' }}{% endblock %}</p>
                    <p class="app-subtitle">{% block page_subtitle %}{% endblock %}</p>
                </div>

                <div class="d-flex align-items-center gap-2">
                    {% block topbar_actions %}{% endblock %}
                    <button class="app-hamburger" id="appHamburger" aria-label="{{ translations.menu ?? 'Menu' }}" aria-expanded="false" aria-controls="appNavSheet">
                        {{ icons.svg('menu') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

<main class="app-content">
    <div class="container py-3">
        {% block content %}{% endblock %}
    </div>
</main>

{% include "components/bottom_nav.twig" with { active_nav: active_nav ?? '' } %}

{# ── Bottom tab bar (primary navigation) ──
     « Checklists » et « Tâches » désignaient le même objet vu de deux côtés —
     le réseau et le mien. Un seul onglet TERRAIN les réunit, avec deux segments
     en haut de l'écran, et la place libérée va aux RAPPORTS : c'est l'écran de
     fin de mois, et il fallait jusqu'ici passer par le menu pour l'atteindre.

     Le surlignage lit PLUSIEURS valeurs d'`active_nav` : les écrans envoient
     encore 'checklists' ou 'tasks' selon leur origine, et les renommer tous
     serait l'occasion d'en oublier un — un onglet éteint sur un écran est un
     bogue silencieux. Le 5e onglet reste la page 6L. #}
{% set nav = active_nav ?? '' %}
<nav class="app-tabbar-bar" aria-label="{{ translations.primary_navigation ?? 'Navigation' }}">
    <a href="{{ ROOT }}/dashboard"       class="app-tab {{ nav == 'dashboard' ? 'is-active' : '' }}">{{ icons.svg('home', 23) }}<span>{{ translations.nav_home ?? 'Accueil' }}</span></a>
    <a href="{{ ROOT }}/shops"           class="app-tab {{ nav == 'shops'     ? 'is-active' : '' }}">{{ icons.svg('store', 23) }}<span>{{ translations.nav_shops ?? 'Boutiques' }}</span></a>
    <a href="{{ ROOT }}/checklists/tasks" class="app-tab {{ nav in ['field', 'checklists', 'tasks'] ? 'is-active' : '' }}">{{ icons.svg('clipboard-check', 23) }}<span>{{ translations.nav_field ?? 'Terrain' }}</span></a>
    <a href="{{ ROOT }}/reports"         class="app-tab {{ nav == 'reports'   ? 'is-active' : '' }}">{{ icons.svg('file-text', 23) }}<span>{{ translations.nav_reports ?? 'Rapports' }}</span></a>
    <a href="{{ ROOT }}/levers"          class="app-tab {{ nav == 'sixl'      ? 'is-active' : '' }}">{{ icons.svg('hexm', 23) }}<span>{{ translations.nav_management ?? 'Management' }}</span></a>
</nav>

{# `window.__consultantRoot` n'est plus défini ici : il l'est dans le <head>,
   avant le bloc `content`, sinon les scripts inline de `content` lisaient une
   racine vide. #}
<script src="{{ ROOT }}/assets/mazer/compiled/js/app.js?v={{ assetv('assets/mazer/compiled/js/app.js') }}"></script>
<script src="{{ ROOT }}/assets/js/consultant-ajax.js?v={{ assetv('assets/js/consultant-ajax.js') }}"></script>

{# ── Prefetch spéculatif de la page suivante ──
   Sur les navigateurs qui le supportent, le HTML de la page pointée est
   pré-téléchargé au survol / pointerdown (eagerness « moderate ») → le clic
   sur un onglet est quasi instantané. `prefetch` seulement (pas `prerender`) :
   le document est récupéré mais son JS n'est PAS exécuté à l'avance, donc aucun
   appel API dupliqué. Les navigateurs sans support ignorent ce bloc. #}
<script type="speculationrules">
{
  "prefetch": [
    {
      "source": "document",
      "where": { "href_matches": "/pwa_consultant/*" },
      "eagerness": "moderate"
    }
  ]
}
</script>
{% block scripts %}{% endblock %}

<script>
/* Barre de progression : démarre au clic sur un lien interne ou à la soumission
 * d'un formulaire (filtres), se termine quand la page suivante s'affiche (ou
 * revient du cache bfcache). Donne un retour immédiat au tap. */
(function () {
    var bar = document.getElementById('nav-progress');
    if (!bar) return;
    function start() {
        bar.classList.add('is-active');
        bar.style.transform = 'scaleX(0.08)';
        requestAnimationFrame(function () { bar.style.transform = 'scaleX(0.85)'; });
    }
    function done() {
        bar.style.transform = 'scaleX(1)';
        setTimeout(function () { bar.classList.remove('is-active'); bar.style.transform = 'scaleX(0)'; }, 200);
    }
    document.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        if (a.target === '_blank' || a.hasAttribute('download')) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        var href = a.getAttribute('href') || '';
        if (href.charAt(0) === '#' || href.indexOf('javascript:') === 0) return;
        if (a.origin && a.origin !== location.origin) return;
        start();
    }, true);
    document.addEventListener('submit', function () { start(); }, true);
    window.addEventListener('pagehide', start);
    window.addEventListener('pageshow', done);
})();
</script>

<script>
    (function () {
        if (!("serviceWorker" in navigator)) return;
        window.addEventListener("load", async () => {
            try {
                const reg = await navigator.serviceWorker.register("/pwa_consultant/sw.js", { scope: "/pwa_consultant/" });
                console.log("SW registered", reg);
            } catch (e) {
                console.warn("SW register failed", e);
            }
        });
    })();
</script>

{# ── PWA INSTALL BANNER ── #}
<style>
    #pwa-banner {
        position: fixed;
        bottom: calc(var(--app-tabbar-h, 72px) + env(safe-area-inset-bottom, 0px) + 10px);
        left: 12px; right: 12px;
        z-index: 2000;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 8px 32px rgba(141,29,44,.18), 0 2px 8px rgba(0,0,0,.08);
        padding: 14px 16px 14px 14px;
        display: flex; align-items: center; gap: 12px;
        animation: pwa-slide-up .35s cubic-bezier(.34,1.56,.64,1) both;
        border: 1.5px solid rgba(141,29,44,.12);
    }
    @keyframes pwa-slide-up {
        from { opacity: 0; transform: translateY(24px) scale(.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    #pwa-banner .pwa-icon { width: 48px; height: 48px; border-radius: 12px; flex-shrink: 0; object-fit: cover; }
    #pwa-banner .pwa-body { flex: 1; min-width: 0; }
    #pwa-banner .pwa-title { font-weight: 800; font-size: .9rem; color: #212529; line-height: 1.2; }
    #pwa-banner .pwa-sub   { font-size: .72rem; color: #6c757d; margin-top: 2px; }
    #pwa-banner .pwa-btn-install {
        background: linear-gradient(135deg,#8D1D2C,#6b7ff5);
        color: #fff; border: none; padding: 7px 14px; border-radius: 20px;
        font-size: .78rem; font-weight: 700; white-space: nowrap; cursor: pointer; flex-shrink: 0;
    }
    #pwa-banner .pwa-btn-close {
        background: none; border: none; color: #adb5bd;
        font-size: 1.1rem; cursor: pointer; padding: 0 0 0 6px; line-height: 1; flex-shrink: 0;
    }
    #pwa-ios-tip {
        position: fixed;
        bottom: calc(var(--app-tabbar-h, 72px) + env(safe-area-inset-bottom, 0px) + 10px);
        left: 12px; right: 12px; z-index: 2000;
        background: #1c1c1e; color: #fff; border-radius: 16px;
        padding: 14px 16px; font-size: .82rem; line-height: 1.5;
        box-shadow: 0 8px 32px rgba(0,0,0,.25);
        animation: pwa-slide-up .35s cubic-bezier(.34,1.56,.64,1) both;
        display: flex; align-items: flex-start; gap: 12px;
    }
    #pwa-ios-tip .pwa-ios-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }
    #pwa-ios-tip .pwa-ios-body { flex: 1; }
    #pwa-ios-tip .pwa-ios-close { background: none; border: none; color: #ffffffaa; font-size: 1.1rem; cursor: pointer; padding: 0; flex-shrink: 0; }
    #pwa-ios-tip strong { color: #fff; }
    #pwa-ios-tip .ios-share-icon {
        display: inline-block; background: #0a84ff; color: #fff;
        border-radius: 6px; padding: 1px 5px; font-size: .7rem; vertical-align: middle; margin: 0 2px;
    }
</style>

<script>
(function () {
    const SNOOZE_KEY  = 'pwa_banner_snoozed';
    const SNOOZE_DAYS = 30;

    function isSnoozed() {
        try {
            const ts = localStorage.getItem(SNOOZE_KEY);
            if (!ts) return false;
            return (Date.now() - parseInt(ts, 10)) < SNOOZE_DAYS * 86400_000;
        } catch { return false; }
    }
    function snooze() {
        try { localStorage.setItem(SNOOZE_KEY, Date.now()); } catch {}
    }

    const isStandalone = window.matchMedia('(display-mode: standalone)').matches
        || window.navigator.standalone === true;
    if (isStandalone || isSnoozed()) return;

    const isIos    = /iphone|ipad|ipod/i.test(navigator.userAgent);
    const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);

    if (isIos && isSafari) {
        window.addEventListener('load', () => {
            const tip = document.createElement('div');
            tip.id = 'pwa-ios-tip';
            tip.innerHTML = `
                <span class="pwa-ios-icon">📲</span>
                <div class="pwa-ios-body">
                    <strong>{{ translations.install_app ?? "Installer l'application" }}</strong><br>
                    {{ translations.ios_share_hint ?? '⬆ Partager puis « Sur l’écran d’accueil »' }}
                </div>
                <button class="pwa-ios-close" aria-label="{{ translations.close ?? 'Fermer' }}">✕</button>`;
            document.body.appendChild(tip);
            tip.querySelector('.pwa-ios-close').onclick = () => { snooze(); tip.remove(); };
        });
        return;
    }

    let deferredPrompt = null;
    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;

        const banner = document.createElement('div');
        banner.id = 'pwa-banner';
        banner.innerHTML = `
            <img class="pwa-icon" src="/pwa_consultant/assets/pwa/icon-192.png" alt="icon">
            <div class="pwa-body">
                <div class="pwa-title">{{ translations.install_app ?? "Installer l'application" }}</div>
                <div class="pwa-sub">{{ translations.install_offline_hint ?? "Ajouter à l'écran d'accueil — fonctionne hors ligne" }}</div>
            </div>
            <button class="pwa-btn-install">{{ translations.install ?? 'Installer' }}</button>
            <button class="pwa-btn-close" aria-label="{{ translations.close ?? 'Fermer' }}">✕</button>`;
        document.body.appendChild(banner);

        banner.querySelector('.pwa-btn-install').onclick = async () => {
            banner.remove();
            deferredPrompt.prompt();
            const { outcome } = await deferredPrompt.userChoice;
            if (outcome === 'accepted') snooze();
            deferredPrompt = null;
        };
        banner.querySelector('.pwa-btn-close').onclick = () => { snooze(); banner.remove(); };
    });

    window.addEventListener('appinstalled', () => {
        snooze();
        const b = document.getElementById('pwa-banner');
        if (b) b.remove();
    });
})();
</script>

</body>
</html>

