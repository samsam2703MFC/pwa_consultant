{# layouts/error_mobile.twig #}
{% import "components/_icons.twig" as icons %}
<!DOCTYPE html>
<html lang="{{ lang_code ?? 'pl' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{{ translations.error ?? 'Błąd' }} — {{ translations.consultant_panel ?? 'Consultant Panel' }}</title>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ ROOT }}/assets/mazer/compiled/css/app.css">
    {# bootstrap-icons retiré (aucune icône `bi-` sur cette page). #}
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/atelier-theme.css">

    <style>
        body {
            background: #f2f7ff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .error-card {
            background: #fff;
            border-radius: 20px;
            padding: 32px 24px;
            text-align: center;
            box-shadow: 0 4px 24px rgba(0,0,0,.08);
            max-width: 360px;
            width: 100%;
            margin: 16px;
        }
        .error-icon { font-size: 2.5rem; margin-bottom: 16px; color: #435ebe; }
        h1 { font-size: 1.15rem; font-weight: 800; margin: 0 0 8px; color: #212529; }
        p  { color: #6c757d; font-size: .9rem; margin: 0 0 20px; }

        /* Bouton « retour » unifié (même identité que le reste de l'app). */
        .app-back-btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 14px 7px 10px;
            border: 1.5px solid rgba(141,29,44,.18); border-radius: 999px; background: #fff;
            color: #8D1D2C; font-size: .82rem; font-weight: 700; text-decoration: none;
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
            transition: background .15s, border-color .15s, transform .1s;
            -webkit-tap-highlight-color: transparent;
        }
        .app-back-btn:active { background: rgba(141,29,44,.06); border-color: rgba(141,29,44,.4); transform: scale(.98); }
        .app-back-btn svg { width: 16px; height: 16px; flex-shrink: 0; }
    </style>
</head>
<body>
<div class="error-card">
    <div class="error-icon">
        {{ icons.svg('alert-triangle') }}
    </div>
    <h1>{% block error_title %}{{ translations.something_went_wrong ?? 'Coś poszło nie tak' }}{% endblock %}</h1>
    <p>{% block error_desc %}{{ translations.try_again_or_go_back ?? 'Spróbuj ponownie lub wróć.' }}{% endblock %}</p>
    <a href="{{ ROOT }}/dashboard" class="app-back-btn">
        {{ icons.svg('chevron-left', 16) }}<span>{{ translations.back ?? 'Wróć' }}</span>
    </a>
</div>
</body>
</html>

