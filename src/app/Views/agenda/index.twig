{% extends "layouts/mobile_base.twig" %}
{% import "components/_icons.twig" as icons %}
{% set active_nav = 'agenda' %}
{% block title %}{{ translations.title ?? 'Agenda' }} — Consultant Panel{% endblock %}
{% block page_title %}{{ translations.title ?? 'Agenda' }}{% endblock %}
{% block page_subtitle %}{{ translations.subtitle ?? 'Mes visites franchisés' }}{% endblock %}

{% block head %}
<style>
  .ag-sync { display:inline-flex; align-items:center; gap:6px; font-size:.66rem; font-weight:700; color:#5f6368; background:#f1f3f4; border:1px solid #e3e6ea; border-radius:999px; padding:3px 10px 3px 7px; margin-bottom:12px; }
  .ag-gdot { width:12px; height:12px; border-radius:50%; background:conic-gradient(#4285F4 0 25%,#EA4335 0 50%,#FBBC05 0 75%,#34A853 0); }
  .ag-nav { display:flex; align-items:center; gap:12px; margin-bottom:8px; }
  .ag-nav .mo { font-size:1.05rem; font-weight:800; color:#241f1c; text-transform:capitalize; }
  .ag-nav .arr { width:30px; height:30px; border-radius:9px; border:1px solid #e7ded2; background:#fff; color:#8D1D2C; font-weight:800; display:flex; align-items:center; justify-content:center; text-decoration:none; }
  .ag-nav .sum { margin-left:auto; font-size:.7rem; color:#7a7168; font-weight:700; }
  .ag-cal { background:#fff; border:1px solid #ece4d8; border-radius:16px; padding:8px; box-shadow:0 3px 12px -8px rgba(70,40,25,.3); }
  .ag-wk, .ag-grid { display:grid; grid-template-columns:repeat(7,1fr); }
  .ag-wk .wd { text-align:center; font-size:.6rem; font-weight:800; color:#9a9086; text-transform:uppercase; padding:2px 0 6px; }
  .ag-grid { gap:3px; }
  .ag-day { min-height:52px; border-radius:9px; background:#faf7f2; border:1px solid #f1e9dd; padding:3px 3px 2px; display:flex; flex-direction:column; }
  .ag-day.out { background:transparent; border-color:transparent; }
  .ag-day.out .n { color:#c4bcae; }
  .ag-day .n { font-size:.7rem; font-weight:700; color:#3a352f; text-align:right; line-height:1; margin-bottom:2px; }
  .ag-day.today { border:2px solid #8D1D2C; }
  .ag-day.today .n { color:#8D1D2C; font-weight:800; }
  .ev { display:block; font-size:.56rem; font-weight:700; color:#fff; border-radius:4px; padding:1px 4px; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-decoration:none; }
  .ev-plan { background:#1a73e8; } .ev-done { background:#2D7A3E; } .ev-cancel { background:#adb5bd; }
  .ag-legend { display:flex; gap:14px; padding:10px 2px 0; font-size:.64rem; color:#7a7168; }
  .ag-legend i { display:inline-block; width:9px; height:9px; border-radius:3px; margin-right:4px; vertical-align:-1px; }
  .ag-sec { font-size:.64rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#8D1D2C; margin:18px 2px 8px; }
  .ag-vitem { display:flex; gap:11px; background:#fff; border:1px solid #ece4d8; border-radius:13px; padding:11px 12px; margin-bottom:9px; }
  .ag-vt { flex-shrink:0; width:48px; text-align:center; }
  .ag-vt .d { font-size:1.05rem; font-weight:800; color:#8D1D2C; line-height:1; }
  .ag-vt .h { font-size:.62rem; color:#9a9086; margin-top:2px; }
  .ag-vc { flex:1; min-width:0; }
  .ag-vc .s { font-size:.86rem; font-weight:800; color:#241f1c; }
  .ag-chips { display:flex; gap:6px; margin-top:7px; flex-wrap:wrap; }
  .ag-chip { display:inline-flex; align-items:center; gap:4px; font-size:.64rem; font-weight:700; border-radius:8px; padding:3px 9px; text-decoration:none; }
  .ag-chip.p { background:rgba(26,115,232,.12); color:#1a73e8; }
  .ag-chip.g { background:rgba(141,29,44,.09); color:#8D1D2C; }
  .ag-empty { font-size:.82rem; color:#adb5bd; font-style:italic; padding:6px 2px; }
  .ag-fab { position:sticky; bottom:14px; margin-top:16px; }
  .ag-fab a { display:flex; align-items:center; justify-content:center; gap:8px; background:#8D1D2C; color:#fff; border-radius:999px; padding:13px; font-size:.9rem; font-weight:800; text-decoration:none; box-shadow:0 8px 20px -8px rgba(141,29,44,.6); }
</style>
{% endblock %}

{% block content %}
<div class="page-content-loaded px-3 pb-4">
  {% set mv = month_view %}
  {% set y = mv.year ?? ('now'|date('Y')) %}
  {% set m = mv.month ?? ('now'|date('n')) %}

  <div class="ag-sync"><span class="ag-gdot"></span> {{ translations.google_sync ?? 'Synchronisé avec Google Agenda' }}</div>

  <div class="ag-nav">
    <a class="arr" href="{{ ROOT }}/agenda?year={{ mv.prev.format('Y') }}&month={{ mv.prev.format('n') }}">‹</a>
    <span class="mo">{{ mv.label }}</span>
    <a class="arr" href="{{ ROOT }}/agenda?year={{ mv.next.format('Y') }}&month={{ mv.next.format('n') }}">›</a>
    <span class="sum">{{ mv.count }} {{ translations.visits ?? 'visites' }}</span>
  </div>

  <div class="ag-cal">
    <div class="ag-wk">
      {% for d in ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'] %}<div class="wd">{{ d }}</div>{% endfor %}
    </div>
    <div class="ag-grid">
      {% for week in mv.weeks %}{% for c in week %}
        <div class="ag-day{{ c.in_month ? '' : ' out' }}{{ c.today ? ' today' : '' }}">
          <div class="n">{{ c.day }}</div>
          {% for v in c.visits %}
            <a class="ev ev-{{ v.status_class }}" href="{{ ROOT }}/agenda/shop/{{ v.id_shop }}">{{ v.shop_name ?? '—' }}</a>
          {% endfor %}
        </div>
      {% endfor %}{% endfor %}
    </div>
    <div class="ag-legend">
      <span><i style="background:#8D1D2C"></i>{{ translations.today ?? "aujourd'hui" }}</span>
      <span><i style="background:#1a73e8"></i>{{ translations.planned ?? 'planifiée' }}</span>
      <span><i style="background:#2D7A3E"></i>{{ translations.done ?? 'faite' }}</span>
    </div>
  </div>

  <div class="ag-sec">{{ translations.this_month ?? 'Visites du mois' }}</div>
  {% if mv.visits is empty %}
    <div class="ag-empty">{{ translations.no_visits ?? 'Aucune visite ce mois-ci.' }}</div>
  {% else %}
    {% for v in mv.visits %}
      <div class="ag-vitem">
        <div class="ag-vt"><div class="d">{{ v.date|slice(8,2) }}</div><div class="h">{{ v.time }}</div></div>
        <div class="ag-vc">
          <div class="s">{{ v.shop_name ?? '—' }}</div>
          {% if v.goal %}<div style="font-size:.74rem;color:#7a7168;margin-top:2px;">{{ v.goal }}</div>{% endif %}
          <div class="ag-chips">
            <a class="ag-chip g" href="{{ ROOT }}/agenda/shop/{{ v.id_shop }}">{{ icons.svg('store', 12) }} {{ translations.shop_agenda ?? 'Agenda boutique' }}</a>
            <a class="ag-chip p" href="{{ ROOT }}/agenda/visits/{{ v.id }}/ics">📅 {{ translations.ics ?? 'Invitation (.ics)' }}</a>
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}

  <div class="ag-fab"><a href="{{ ROOT }}/agenda/new">＋ {{ translations.plan_visit ?? 'Planifier une visite' }}</a></div>
</div>
{% endblock %}
