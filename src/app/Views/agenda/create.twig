{% extends "layouts/mobile_base.twig" %}
{% import "components/_icons.twig" as icons %}
{% set active_nav = 'agenda' %}
{% set is_edit = edit is defined and edit %}
{% block title %}{{ is_edit ? (translations.edit_visit ?? 'Modifier la visite') : (translations.plan_visit ?? 'Planifier une visite') }} — Consultant Panel{% endblock %}
{% block page_title %}{{ is_edit ? (translations.edit_visit ?? 'Modifier la visite') : (translations.plan_visit ?? 'Planifier une visite') }}{% endblock %}

{% block head %}
<style>
  .af { margin-bottom:14px; }
  .af .fl { font-size:.66rem; font-weight:800; color:#7a7168; text-transform:uppercase; letter-spacing:.03em; margin-bottom:5px; }
  .af input, .af select, .af textarea { width:100%; background:#fff; border:1.5px solid #e7ded2; border-radius:11px; padding:10px 12px; font-size:.85rem; color:#241f1c; font-family:inherit; }
  .af textarea { min-height:64px; resize:vertical; }
  /* min-width:0 : sans lui, les inputs en width:100% dans un flex débordent. */
  .af .two { display:flex; gap:10px; } .af .two > div { flex:1 1 0; min-width:0; }
  /* box-sizing : le padding ne doit pas ajouter à la largeur (débordement). */
  .af input, .af select, .af textarea { max-width:100%; box-sizing:border-box; }
  .lev-row { display:flex; align-items:center; gap:9px; margin-bottom:8px; }
  .lev-badge { flex-shrink:0; width:26px; height:26px; border-radius:7px; display:flex; align-items:center; justify-content:center; color:#fff; font-size:.78rem; font-weight:800; }
  .st-ok { background:#2D7A3E; } .st-mid { background:#e67e22; } .st-bad { background:#c0182b; } .st-nd { background:#cfc7bb; color:#fff; }
  .lev-row input { flex:1; }
  .treflo { display:flex; flex-wrap:wrap; gap:5px; margin-bottom:8px; }
  .treflo .tf { border:0; cursor:pointer; -webkit-tap-highlight-color:transparent; }
  /* Levier à travailler (⚠ ou ●) : liseré + pastille d'alerte. */
  .treflo .tf.todo { box-shadow:0 0 0 2px rgba(0,0,0,.12) inset; }
  .treflo .tf.todo::after { content:'!'; font-size:.6rem; opacity:.9; }
  .treflo .tf.picked { outline:2.5px solid #241f1c; outline-offset:1px; }
  /* Période + bouton sur une ligne, sans débordement sur mobile. */
  .lp-row { display:flex; gap:8px; align-items:stretch; }
  .lp-row > input { flex:1 1 auto; min-width:0; }
  .lp-load { flex:0 0 auto; white-space:nowrap; border:1.5px solid #8D1D2C; background:#fff; color:#8D1D2C; font-size:.74rem; font-weight:800; border-radius:9px; padding:8px 12px; cursor:pointer; }
  .lp-load:disabled { opacity:.55; }
  .lp-hint { font-size:.64rem; color:#9a9086; margin:4px 0 7px; line-height:1.4; }
  .lev-row.hl input { border-color:#8D1D2C; background:#fffaf9; }
  .treflo .tf { display:inline-flex; align-items:center; gap:5px; font-size:.66rem; font-weight:800; color:#fff; border-radius:8px; padding:3px 9px; }
  .note { background:#fff8ec; border:1px solid #f3e2c2; border-left:3px solid #e6a817; border-radius:10px; padding:10px 12px; font-size:.76rem; color:#7a5a12; line-height:1.45; margin:6px 0 14px; }
  .send { background:#f6fbf7; border:1px solid #cfe7d5; border-radius:11px; padding:10px 12px; margin:6px 0 14px; }
  .send.off { opacity:.45; }
  .send .h { font-size:.7rem; font-weight:800; color:#2D7A3E; margin-bottom:5px; }
  .send .l { font-size:.74rem; color:#4a5f4e; padding:2px 0; }
  .shared { display:flex; align-items:center; gap:10px; background:#fff; border:1.5px solid #e7ded2; border-radius:11px; padding:10px 12px; }
  .shared input { width:auto; }
  .rep { display:flex; align-items:center; gap:9px; background:#faf7f2; border:1px solid #ece4d8; border-radius:11px; padding:9px 11px; }
  .rep .ic { width:30px; height:34px; border-radius:5px; background:#8D1D2C; color:#fff; display:flex; align-items:center; justify-content:center; font-size:.55rem; font-weight:800; flex-shrink:0; }
  .rep a { color:#8D1D2C; font-weight:800; font-size:.78rem; text-decoration:none; }
  .subm { width:100%; background:#8D1D2C; color:#fff; border:0; border-radius:999px; padding:13px; font-size:.9rem; font-weight:800; }
  .sechd { font-size:.64rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:#8D1D2C; margin:16px 2px 9px; }
  .surprise-note { display:none; background:#f3eaf6; border:1px solid #e2cdec; border-left:3px solid #8e44ad; border-radius:10px; padding:9px 12px; font-size:.75rem; color:#6c3483; margin:6px 0 12px; }
</style>
{% endblock %}

{% block content %}
<div class="page-content-loaded px-3 pb-4">

  <a href="{{ ROOT }}/agenda" class="app-back-btn" style="margin-bottom:14px;">{{ icons.svg('chevron-left', 16) }}<span>{{ translations.back ?? 'Agenda' }}</span></a>

  <form method="POST" action="{{ is_edit ? (ROOT ~ '/agenda/visits/' ~ edit.id ~ '/update') : (ROOT ~ '/agenda/visits') }}">
    <div class="af">
      <div class="fl">{{ translations.shop ?? 'Boutique' }}</div>
      <select name="shop_id" required>
        <option value="">—</option>
        {% for s in shops %}
          <option value="{{ s.id }}" {{ ((is_edit ? edit.id_shop : shop_id) == s.id) ? 'selected' : '' }}>{{ s.representative_name ?? s.name }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="af">
      <div class="fl">{{ translations.visit_type ?? 'Type de visite' }}</div>
      <select name="type" id="visit-type">
        {% for k, lbl in (types ?? {'surprise':'Surprise','development':'Développement','quality':'Qualité','other':'Autres'}) %}
          <option value="{{ k }}" {{ ((is_edit ? edit.type : 'development') == k) ? 'selected' : '' }}>{{ translations['type_' ~ k] ?? lbl }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="surprise-note" id="surprise-note">🙈 {{ translations.surprise_note ?? 'Visite surprise : non partagée au franchisé (aucun envoi).' }}</div>

    <div class="af two">
      <div><div class="fl">{{ translations.date ?? 'Date' }}</div><input type="date" name="date" value="{{ is_edit ? edit.date : date }}" required></div>
      <div><div class="fl">{{ translations.time ?? 'Heure' }}</div><input type="time" name="time" value="{{ is_edit ? edit.time : '10:00' }}"></div>
    </div>

    {# ── Période de référence + résultats TREFLO (chargés à la demande) ── #}
    <div class="af" id="lever-block">
      <div class="fl">{{ translations.lever_period ?? 'Période de référence des leviers' }}</div>
      <div class="lp-row">
        <input type="month" name="lever_period" id="lever-period" value="{{ lever_period ?? '' }}">
        <button type="button" class="lp-load" id="lever-load">{{ translations.load_levers ?? 'Charger les leviers' }}</button>
      </div>
      <div class="lp-hint">{{ translations.lever_period_hint ?? 'Cliquez un levier en ⚠ ou ● pour le marquer à travailler.' }}</div>
      <div class="treflo" id="treflo-box">
        {% for lev in levers %}
          {% set res = lever_results[lev.key] ?? null %}
          {% set st = res ? res.status : 'nd' %}
          <button type="button" class="tf st-{{ st }} {{ (st == 'mid' or st == 'bad') ? 'todo' : '' }}"
                  data-lever="{{ lev.key }}" data-status="{{ st }}" title="{{ lev.name }}">{{ lev.letter }} {{ lev.name }}</button>
        {% endfor %}
      </div>
      <div class="lp-hint" id="lever-msg"></div>
    </div>

    {# ── Checklist liée à la visite ── #}
    <div class="af">
      <div class="fl">{{ translations.checklist_link ?? 'Checklist liée' }}</div>
      <select name="id_checklist" id="checklist-sel">
        <option value="">{{ translations.no_checklist ?? '— Aucune —' }}</option>
        {% for c in checklists ?? [] %}
          <option value="{{ c.id }}" {{ (is_edit and edit.id_checklist == c.id) ? 'selected' : '' }}>{{ c.name }}</option>
        {% endfor %}
        {# Checklist enregistrée mais absente de la liste du jour : on la garde. #}
        {% if is_edit and edit.id_checklist and edit.checklist_name %}
          {% set known = false %}
          {% for c in checklists ?? [] %}{% if c.id == edit.id_checklist %}{% set known = true %}{% endif %}{% endfor %}
          {% if not known %}<option value="{{ edit.id_checklist }}" selected>{{ edit.checklist_name }}</option>{% endif %}
        {% endif %}
      </select>
      <input type="hidden" name="checklist_name" id="checklist-name" value="{{ is_edit ? (edit.checklist_name ?? '') : '' }}">
      {% if is_edit and edit.id_checklist %}
        <div class="rep" style="margin-top:7px;">
          <span class="ic">✓</span>
          <a href="{{ ROOT }}/checklists/shops/{{ is_edit ? edit.id_shop : shop_id }}/tasks" target="_blank">{{ translations.open_checklist ?? 'Ouvrir la checklist de la boutique' }} ↗</a>
        </div>
      {% endif %}
    </div>

    <div class="af">
      <div class="fl">{{ translations.goal ?? 'But de la visite' }}</div>
      <textarea name="goal" placeholder="{{ translations.goal_hint ?? 'Ex. Travailler les leviers en difficulté au dernier rapport…' }}">{{ is_edit ? edit.goal : '' }}</textarea>
    </div>

    {# ── Ce qu'il faut travailler, par levier ── #}
    <div class="sechd">{{ translations.lever_actions ?? 'À travailler par levier' }}</div>
    {% for lev in levers %}
      {% set res = lever_results[lev.key] ?? null %}
      <div class="lev-row">
        <span class="lev-badge st-{{ res ? res.status : 'nd' }}" title="{{ lev.name }}">{{ lev.letter }}</span>
        <input type="text" name="action_{{ lev.key }}" value="{{ is_edit and existing[lev.key] is defined ? existing[lev.key] : '' }}" placeholder="{{ lev.name }} — {{ translations.action_hint ?? 'action à travailler' }}">
      </div>
    {% endfor %}

    {# ── Rapport lié (lien qui exécute le rapport de la boutique) ── #}
    <div class="af" style="margin-top:14px;">
      <div class="fl">{{ translations.report_ref ?? 'Rapport lié' }}</div>
      <div class="rep">
        <span class="ic">PDF</span>
        <a href="{{ ROOT }}/reports/view?type=month&scope={{ is_edit ? edit.id_shop : shop_id }}" target="_blank">{{ translations.open_report ?? 'Ouvrir le rapport mensuel' }} ↗</a>
      </div>
    </div>

    <div class="af">
      <label class="shared"><input type="checkbox" name="shared" id="shared-cb" value="1" {{ (is_edit ? (edit.shared ? 'checked' : '') : 'checked') }}> <span>{{ translations.share_franchisee ?? 'Partager au franchisé' }}</span></label>
    </div>

    <div class="send" id="send-block">
      <div class="h">✉ {{ translations.auto_send ?? "À l'enregistrement (envoi serveur SMTP — à configurer)" }}</div>
      <div class="l">📧 {{ translations.send_email ?? 'E-mail au franchisé (but + rapport)' }}</div>
      <div class="l">📅 {{ translations.send_ics ?? 'Invitation Google Agenda (.ics)' }}</div>
      <div class="l">📄 {{ translations.send_pdf ?? 'PDF du rapport en pièce jointe' }}</div>
    </div>

    <div class="note">⚠ {{ translations.checklist_note ?? 'Pendant la visite, respectez votre checklist — elle génère le rapport de visite à la fin.' }}</div>

    <button type="submit" class="subm">{{ is_edit ? (translations.save_changes ?? 'Enregistrer les modifications') : (translations.save_visit ?? 'Enregistrer la visite') }}</button>
  </form>
</div>

<script>
(function () {
  var sel = document.getElementById('visit-type');
  var note = document.getElementById('surprise-note');
  var send = document.getElementById('send-block');
  var cb = document.getElementById('shared-cb');
  function sync() {
    var surprise = sel && sel.value === 'surprise';
    if (note) note.style.display = surprise ? 'block' : 'none';
    if (send) send.classList.toggle('off', surprise);
    if (cb) { cb.checked = surprise ? false : cb.checked; cb.disabled = surprise; }
  }
  if (sel) { sel.addEventListener('change', sync); sync(); }

  // ── Leviers TREFLO : chargement par période + sélection « à travailler » ──
  var ROOT = window.__consultantRoot || '';
  var box    = document.getElementById('treflo-box');
  var perIn  = document.getElementById('lever-period');
  var loadBt = document.getElementById('lever-load');
  var msg    = document.getElementById('lever-msg');
  var shopSel = document.querySelector('select[name="shop_id"]');
  var LBL = {
    todo:   {{ (translations.levers_todo ?? 'levier(s) à travailler')|json_encode|raw }},
    none:   {{ (translations.levers_none ?? 'Aucun levier en difficulté sur cette période.')|json_encode|raw }},
    load:   {{ (translations.load_levers ?? 'Charger les leviers')|json_encode|raw }},
    wait:   {{ (translations.loading ?? 'Chargement…')|json_encode|raw }},
    err:    {{ (translations.levers_error ?? 'Chargement impossible pour cette période.')|json_encode|raw }}
  };

  // Champ « action » du levier : surligné et focus quand on clique la pastille.
  function actionInput(key) { return document.querySelector('[name="action_' + key + '"]'); }

  function wire(btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-lever');
      var inp = actionInput(key);
      btn.classList.toggle('picked');
      if (inp) {
        var row = inp.closest('.lev-row');
        if (row) { row.classList.toggle('hl', btn.classList.contains('picked')); }
        if (btn.classList.contains('picked')) { inp.focus(); }
      }
    });
  }
  function wireAll() { box && box.querySelectorAll('.tf').forEach(wire); }

  function summarize() {
    if (!box || !msg) { return; }
    var n = box.querySelectorAll('.tf.todo').length;
    msg.textContent = n > 0 ? ('⚠ ' + n + ' ' + LBL.todo) : LBL.none;
  }

  function load() {
    if (!box || !perIn) { return; }
    var shopId = shopSel ? shopSel.value : 0;
    if (!shopId) { return; }
    loadBt.disabled = true;
    var old = loadBt.textContent;
    loadBt.textContent = LBL.wait;
    fetch(ROOT + '/agenda/levers?shop_id=' + encodeURIComponent(shopId) + '&period=' + encodeURIComponent(perIn.value),
          { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) {
        loadBt.disabled = false;
        loadBt.textContent = old || LBL.load;
        if (!j || !j.levers) { msg.textContent = LBL.err; return; }
        // Applique le statut de chaque levier sur sa pastille (couleur + « à travailler »).
        box.querySelectorAll('.tf').forEach(function (btn) {
          var k = btn.getAttribute('data-lever');
          var st = (j.levers[k] && j.levers[k].status) || 'nd';
          btn.className = 'tf st-' + st + ((st === 'mid' || st === 'bad') ? ' todo' : '')
            + (btn.classList.contains('picked') ? ' picked' : '');
          btn.setAttribute('data-status', st);
        });
        summarize();
      })
      .catch(function () { loadBt.disabled = false; loadBt.textContent = old || LBL.load; msg.textContent = LBL.err; });
  }

  if (loadBt) { loadBt.addEventListener('click', load); }
  if (perIn)  { perIn.addEventListener('change', load); }
  if (shopSel && perIn) { shopSel.addEventListener('change', load); }
  wireAll();
  summarize();

  // Checklist : mémorise le libellé (utile si la liste du jour change ensuite).
  var clSel = document.getElementById('checklist-sel');
  var clName = document.getElementById('checklist-name');
  if (clSel && clName) {
    var syncCl = function () {
      var o = clSel.options[clSel.selectedIndex];
      clName.value = (clSel.value && o) ? o.textContent.trim() : '';
    };
    clSel.addEventListener('change', syncCl);
    syncCl();
  }
})();
</script>
{% endblock %}
