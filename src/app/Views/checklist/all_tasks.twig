{% extends "layouts/mobile_base.twig" %}

{% import "components/_icons.twig" as icons %}
{% set active_nav = 'tasks' %}
{% set today_date = today ?? ('now' | date('Y-m-d')) %}
{% set t = totals ?? {} %}

{% block title %}{{ translations.all_tasks_title ?? 'Toutes les tâches' }} — Panel consultant{% endblock %}
{% block page_title %}{{ translations.all_tasks_title ?? 'Toutes les tâches' }}{% endblock %}
{# Le compte du jour monte dans l'en-tête : il vivait en bas des filtres, sur
   une ligne qu'on ne lit qu'en la cherchant. #}
{% block page_subtitle %}{{ date|date('d.m.Y') }}{% if (t.total ?? 0) > 0 %} ·
    {{ t.total }} {{ translations.tasks_l ?? 'tâches' }} ·
    {{ t.shops ?? 0 }} {{ translations.shops_l ?? 'boutiques' }}{% endif %}{% endblock %}

{% block topbar_actions %}
<div class="d-flex align-items-center gap-1">
    {% set prev_date = date | date_modify('-1 day') | date('Y-m-d') %}
    <a href="{{ ROOT }}/checklists/tasks?date={{ prev_date }}" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:32px;height:32px;">{{ icons.svg('chevron-left') }}</a>
    <button type="button" class="btn btn-sm btn-light rounded-pill px-2" style="font-size:.75rem;font-weight:700;min-width:80px;" onclick="document.getElementById('atDate').showPicker()">{{ date|date('d.m.Y') }}</button>
    <input type="date" id="atDate" value="{{ date }}" max="{{ today_date }}" style="position:absolute;opacity:0;pointer-events:none;width:0;height:0;" onchange="window.location.href='{{ ROOT }}/checklists/tasks?date='+this.value">
    {% set next_date = date | date_modify('+1 day') | date('Y-m-d') %}
    {% if next_date <= today_date %}<a href="{{ ROOT }}/checklists/tasks?date={{ next_date }}" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:32px;height:32px;">{{ icons.svg('chevron-right') }}</a>{% endif %}
</div>
{% endblock %}

{% block head %}
{% include "checklist/_review_modal_style.twig" %}
<style>
    /* ── La barre d'outils, REPLIÉE ──────────────────────────────────────
       Sept barres se succédaient avant la première tâche : segment, lien,
       encart, recherche, deux lignes de filtres, bande de boutiques, ligne de
       compte. Elles tiennent désormais en UNE ligne qui annonce son état ; le
       détail s'ouvre au besoin. Ce qui est actif reste écrit dessous — replier
       ne doit pas cacher ce qui filtre. */
    .nq-tools { position:sticky; top:0; z-index:6; background:var(--c-bg); padding:6px 0 8px; }
    .nq-bar { display:flex; align-items:center; gap:9px; min-height:44px; padding:0 12px;
              border-radius:12px; background:#fff; border:1px solid rgba(0,0,0,.07); }
    .nq-bar .lo { flex-shrink:0; display:flex; color:#a2988c; }
    .nq-search { flex:1; min-width:0; border:0; background:none; padding:0; font-size:.82rem;
                 color:#241f1c; font-family:inherit; min-height:42px; }
    .nq-search:focus { outline:none; }
    .nq-search::placeholder { color:#a2988c; }
    .nq-toggle { flex-shrink:0; display:inline-flex; align-items:center; gap:5px; border:0;
                 background:none; font-family:inherit; font-size:.7rem; font-weight:800;
                 color:#8D1D2C; min-height:42px; padding:0 2px; cursor:pointer;
                 -webkit-tap-highlight-color:transparent; }
    .nq-toggle .car { transition:transform .15s ease; display:inline-flex; }
    .nq-tools.ouvert .nq-toggle .car { transform:rotate(180deg); }
    .nq-toggle .pastille { background:#f4dfe2; border-radius:999px; padding:2px 8px; }
    .nq-toggle .pastille.vide { background:#f1ece4; color:#8a827a; }

    /* Ce qui filtre, en clair, quand le détail est replié. */
    .nq-resume { font-size:.66rem; color:#8a827a; margin:6px 4px 0; line-height:1.4; }
    .nq-resume b { color:#57504a; font-weight:800; }
    .nq-tools.ouvert .nq-resume { display:none; }

    .nq-panel { padding-top:9px; }
    .nq-panel[hidden] { display:none !important; }
    .nq-filters { display:flex; flex-wrap:wrap; gap:6px; }
    .nq-f { flex-shrink:0; min-height:36px; display:inline-flex; align-items:center; gap:5px; padding:0 11px;
            border-radius:999px; font-size:.72rem; font-weight:800; background:#fff; color:#6c757d;
            border:1px solid rgba(0,0,0,.07); cursor:pointer; -webkit-tap-highlight-color:transparent; }
    .nq-f.on { background:#241f1c; color:#fff; border-color:#241f1c; }
    .nq-f .n { font-weight:900; }
    .nq-f .n:empty { display:none; }
    /* Un bouton cyclique n'a pas l'air d'un bouton : la petite flèche dit que
       l'appui fait tourner l'état plutôt que de le cocher. */
    .nq-cyc { border:0; font-family:inherit; }
    .nq-cyc::after { content:"⟳"; font-size:.78rem; opacity:.5; margin-left:1px; }
    .nq-cyc:not(.on) { border:1px solid rgba(0,0,0,.07); }
    /* Le périmètre se distingue de l'état : ce ne sont pas des choix qui
       s'excluent, ce sont deux robinets qu'on ouvre ou qu'on ferme. */
    .nq-f.nq-scope { border-style:dashed; }
    .nq-f.nq-scope.on { background:#F2C9A0; color:#6b3410; border-color:#e0b184; border-style:solid; }
    .nq-sep { flex-shrink:0; width:1px; align-self:stretch; margin:4px 2px;
              background:rgba(0,0,0,.12); }
    .nq-count { font-size:.66rem; color:#8a827a; margin:8px 4px 2px; }
    .nq-count[hidden] { display:none !important; }

    /* Bande des boutiques : elle défile. Trente boutiques empilées mangeraient
       l'écran ; en ligne, on en voit trois et on pousse. */
    .nq-shops { display:flex; gap:6px; overflow-x:auto; margin-top:7px; padding-bottom:2px;
                -webkit-overflow-scrolling:touch; scrollbar-width:none; }
    .nq-shops::-webkit-scrollbar { display:none; }
    .nq-sh { flex-shrink:0; min-height:34px; display:inline-flex; align-items:center; gap:5px;
             padding:0 12px; border-radius:999px; border:1px solid rgba(0,0,0,.07);
             background:#fff; color:#57504a; font-size:.71rem; font-weight:700;
             font-family:inherit; cursor:pointer; -webkit-tap-highlight-color:transparent; }
    .nq-sh .nm { max-width:11ch; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .nq-sh .n { font-weight:900; color:#8D1D2C; }
    .nq-sh .n:empty { display:none; }
    .nq-sh.on { background:#241f1c; border-color:#241f1c; color:#fff; }
    .nq-sh.on .n { color:#F2C9A0; }
    .nq-sh.creuse { opacity:.42; }

    /* ── L'action principale : la SEULE surface rubis pleine de l'écran ──
       C'est ce qui la rend visible. Quand tout est rouge, plus rien ne l'est. */
    .nq-start { display:flex; align-items:center; gap:11px; min-height:56px; margin:0 0 4px;
                padding:12px 15px; border-radius:14px; background:#8D1D2C; color:#fff;
                box-shadow:0 10px 24px -18px rgba(141,29,44,.7); }
    .nq-start .ico { flex-shrink:0; display:flex; }
    .nq-start .txt { flex:1; min-width:0; }
    .nq-start .eyebrow { display:block; font-size:10px; font-weight:800; letter-spacing:.1em;
                         text-transform:uppercase; opacity:.75; margin-bottom:2px; }
    .nq-start .big { display:block; font-size:.95rem; font-weight:800; letter-spacing:-.015em; }
    .nq-start .car { flex-shrink:0; font-size:1.2rem; opacity:.7; }
    .nq-start.vide { background:#e9e4dc; color:#6f665c; border:1px solid rgba(0,0,0,.06);
                     box-shadow:none; }
    .nq-start.vide .ico { color:#9a9086; }
    .nq-start.vide .eyebrow { color:#8a827a; opacity:1; }
    .nq-start.vide .car { color:#b3aaa0; }

    /* ── Un seul niveau de carte ─────────────────────────────────────────
       La boutique était un bandeau rubis plein, la checklist une boîte grise,
       la tâche une troisième surface : trois fonds emboîtés pour une hiérarchie
       qui tient à la typographie. Une carte, un en-tête clair à barre de
       couleur, un intertitre, des lignes. */
    /* PAS d'`overflow:hidden` ici : il ferait de la carte le bloc de référence
       du collant, et l'en-tête de boutique irait se coller EN BAS de sa propre
       carte, sous les checklists. C'est l'en-tête qui porte son arrondi. */
    .nq-card { background:#fff; border:1px solid rgba(36,26,22,.08); border-radius:14px;
               margin-top:12px; box-shadow:0 1px 2px rgba(70,40,25,.05); }
    .nq-shop { position:sticky; top:var(--nq-tools-h, 64px); z-index:5; display:flex;
               align-items:center; gap:8px; background:#fff; color:#241f1c;
               border-left:3px solid #ded6cb; padding:0 12px 0 11px; min-height:46px;
               font-size:.86rem; font-weight:800; letter-spacing:-.015em;
               cursor:pointer; list-style:none; -webkit-tap-highlight-color:transparent;
               border-bottom:1px solid #f2ede6; border-radius:13px 13px 0 0; }
    .nq-shop.s-ok  { border-left-color:#2D7A3E; }
    .nq-shop.s-mid { border-left-color:#C17A2A; }
    .nq-shop.s-bad { border-left-color:#8D1D2C; }
    .nq-shop::-webkit-details-marker { display:none; }
    .nq-shop .nm { flex-shrink:0; }
    .nq-shop .v { font-weight:600; color:#a2988c; font-size:.66rem; min-width:0; overflow:hidden;
                  text-overflow:ellipsis; white-space:nowrap; }
    .nq-shop .r { margin-left:auto; font-weight:900; flex-shrink:0; font-size:.78rem;
                  font-variant-numeric:tabular-nums; }
    .nq-shop .badge { flex-shrink:0; background:#f4dfe2; color:#8D1D2C; border-radius:999px;
                      padding:2px 8px; font-size:.62rem; font-weight:800; white-space:nowrap; }
    .nq-shop .car, .nq-cl .car { flex-shrink:0; display:flex; transition:transform .15s ease;
                                 color:#b3aaa0; }
    .nq-shop-g:not([open]) > .nq-shop .car,
    .nq-cl-g:not([open]) > .nq-cl .car { transform:rotate(-90deg); }
    .nq-shop-g:not([open]) > .nq-shop { border-bottom:0; border-radius:13px; }
    /* La dernière ligne d'une carte en porte l'arrondi bas. */
    .nq-row.last { border-bottom-right-radius:13px; }

    /* La checklist : un INTERTITRE, plus une boîte. */
    .nq-cl { display:flex; align-items:center; gap:7px; background:none; padding:0 12px 0 14px;
             min-height:34px; font-size:.62rem; font-weight:800; text-transform:uppercase;
             letter-spacing:.07em; color:#a2988c; cursor:pointer; list-style:none;
             -webkit-tap-highlight-color:transparent; margin-top:4px; }
    .nq-cl::-webkit-details-marker { display:none; }
    .nq-cl .n { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .nq-cl .badge { flex-shrink:0; background:#f4dfe2; color:#8D1D2C; border-radius:999px;
                    padding:1px 7px; font-size:.6rem; font-weight:800; }
    .nq-cl .c { margin-left:auto; color:#8a827a; flex-shrink:0; font-variant-numeric:tabular-nums; }

    /* La tâche : une barre de 2 px dit son état, sans fond ni bordure. */
    .nq-row { display:flex; align-items:center; gap:10px; background:#fff;
              border-left:2px solid transparent; margin-left:14px; padding:0 12px 0 9px;
              min-height:48px; text-align:left; }
    .nq-row + .nq-row { border-top:1px solid #f6f2ec; }
    .nq-row[data-state="todo"] { border-left-color:#8D1D2C; }
    .nq-row[data-state="ok"]   { border-left-color:#2D7A3E; }
    .nq-row[data-state="ko"]   { border-left-color:#c0182b; }
    .nq-row[data-state="done"] { border-left-color:#ded6cb; }
    .nq-row[data-state="na"]   { border-left-color:#efe9e1; }
    .nq-row.task-openable { cursor:pointer; -webkit-tap-highlight-color:transparent; }
    .nq-row.task-openable:active { background:#fbfcfe; }
    /* Deux fois le même piège : `display:flex` posé par une classe l'emporte
       sur les règles du navigateur, aussi bien celle de `[hidden]` que celle
       qui replie un `<details>` fermé. */
    .nq-row[hidden], .nq-cl[hidden], .nq-shop[hidden] { display:none !important; }
    .nq-shop-g:not([open]) > *:not(summary),
    .nq-cl-g:not([open]) > *:not(summary) { display:none !important; }
    .nq-b { flex:1; min-width:0; padding:7px 0; }
    .nq-n { font-size:.8rem; font-weight:700; color:#241f1c; line-height:1.25; }
    .nq-m { font-size:.63rem; color:#a2988c; margin-top:1px;
            overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .nq-m b { color:#991b1b; font-weight:800; }
    /* Verdict et note occupent chacun une COLONNE de largeur fixe, pour que
       l'œil descende la liste en ligne droite. */
    .nq-right { flex-shrink:0; width:142px; display:flex; align-items:center;
                justify-content:space-between; }
    .nq-act { min-height:32px; width:100px; display:inline-flex; align-items:center;
              justify-content:center; padding:0 6px; border-radius:999px;
              font-size:.68rem; font-weight:800; white-space:nowrap; }
    .nq-act.todo { background:#8D1D2C; color:#fff; }
    .nq-act.ok   { background:rgba(45,122,62,.12); color:#2D7A3E; }
    .nq-act.ko   { background:rgba(192,24,43,.1); color:#c0182b; }
    .nq-act.na   { background:#f2eee8; color:#a2988c; }
    .nq-rate { flex-shrink:0; width:34px; text-align:right; font-size:.82rem;
               font-weight:900; color:#b8860b; font-variant-numeric:tabular-nums; }
    .nq-empty { background:#fff; border-radius:14px; padding:26px 18px; text-align:center;
                color:#a2988c; font-size:.82rem; margin-top:12px; }
    .nq-warn { background:#fff6e6; border:1px solid #f0d9a8; border-radius:12px; padding:9px 12px;
               font-size:.7rem; color:#8a5806; margin-top:10px; }
</style>
{% endblock %}

{% block content %}
<div class="page-content-loaded">

    {# Les deux faces du terrain. Elles remplacent le bouton retour : « mes
       tâches » n'est plus un écran d'où l'on vient, c'est l'autre face. #}
    {% include "components/_field_segments.twig" with { seg: 'network' } %}

    {# Ce qui n'est pas encore parti chez l'API. Muette tant qu'il n'y a rien
       à signaler — file vide et réseau présent. #}
    {% include "checklist/_review_queue.twig" %}

    {# La liste sert à CHOISIR. Quand la décision est prise — « je fais ma
       tournée » — choisir devient du travail perdu : ce bouton lance la file,
       une tâche à la fois.

       Il reste TOUJOURS visible. Le masquer quand la file est vide rendait la
       fonction introuvable les jours où tout était déjà contrôlé — c'est-à-dire
       précisément les jours où on cherche à comprendre pourquoi il n'y a rien
       à faire. Il change d'apparence, pas d'existence. #}
    {% set a_faire = totals.to_review ?? 0 %}
    <a href="{{ ROOT }}/checklists/review?date={{ date }}"
       class="nq-start{{ a_faire > 0 ? '' : ' vide' }}">
        <span class="ico">{{ icons.svg(a_faire > 0 ? 'square-check' : 'check-check', 20) }}</span>
        <span class="txt">
            {% if a_faire > 0 %}
                <span class="eyebrow">{{ translations.start_eyebrow ?? 'Une tâche à la fois' }}</span>
                <span class="big">{{ translations.start_cta ?? 'Contrôler' }} ({{ a_faire }})</span>
            {% else %}
                {# Le compteur est écrit même à zéro : « 0 tâche à vérifier »
                   est une réponse, « Tout est contrôlé » est une conclusion —
                   et on veut voir le chiffre sur lequel elle repose. #}
                <span class="eyebrow">{{ translations.start_eyebrow_done ?? 'Contrôle en série' }}</span>
                <span class="big">0 {{ translations.start_none ?? 'tâche à vérifier' }}</span>
            {% endif %}
        </span>
        <span class="car">›</span>
    </a>

    {# Une seule barre : la recherche reste à portée, les filtres se replient
       derrière un compteur qui dit combien sont actifs, et ce qu'ils font est
       écrit en clair dessous. Replier ne doit pas cacher ce qui filtre. #}
    <div class="nq-tools" id="nqTools">
        <div class="nq-bar">
            <span class="lo">{{ icons.svg('search', 15) }}</span>
            <input type="search" class="nq-search" id="nqSearch" autocomplete="off"
                   placeholder="{{ translations.search_task ?? 'Rechercher…' }}">
            <button type="button" class="nq-toggle" id="nqToggle" aria-expanded="false"
                    aria-controls="nqPanel">
                <span class="pastille" id="nqActifs"></span>
                <span class="car">{{ icons.svg('chevron-down', 13) }}</span>
            </button>
        </div>

        <div class="nq-resume" id="nqResume"></div>

        <div class="nq-panel" id="nqPanel" hidden>
            {# Deux boutons CYCLIQUES plutôt que cinq pastilles. Chaque bouton
               porte une DIMENSION et affiche l'état courant avec son compte ;
               l'appui passe à l'état suivant.

                 Avis        : à évaluer → conformes → non conformes → tous
                 Réalisation : toutes → faites → non faites

               Les nombres sont comptés à l'écran : un compteur qui ne
               correspond pas à ce qu'on obtient en appuyant est pire que pas
               de compteur. #}
            <div class="nq-filters" id="nqFilters">
                <button type="button" class="nq-f nq-cyc on" data-c="ctrl">
                    <span class="lb"></span><b class="n"></b>
                </button>
                <button type="button" class="nq-f nq-cyc" data-c="real">
                    <span class="lb"></span><b class="n"></b>
                </button>
                <span class="nq-sep" aria-hidden="true"></span>
                <span class="nq-f nq-scope{{ scope_mandatory ? ' on' : '' }}" data-s="mandatory">{{ translations.f_mandatory_one ?? 'Obligatoire' }}</span>
                <span class="nq-f nq-scope{{ scope_photo ? ' on' : '' }}" data-s="photo">{{ translations.f_photo_one ?? 'Photo' }}</span>
            </div>

            {% if shops|length > 1 %}
                <div class="nq-shops" id="nqShops">
                    <button type="button" class="nq-sh on" data-shop="">{{ translations.f_all_shops ?? 'Toutes' }}</button>
                    {% for s in shops %}
                        <button type="button" class="nq-sh" data-shop="{{ s.shop_id }}">
                            <span class="nm">{{ s.shop_name }}</span><b class="n"></b>
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    {# Le total a rejoint l'en-tête ; ne reste ici que ce qui BOUGE avec les
       filtres, plus la note moyenne du jour. Muette quand elle n'a rien à
       ajouter. #}
    <div class="nq-count" id="nqCount">
        <span id="nqShown" data-tpl="{{ translations.n_shown ?? '%d affichée(s)' }}"></span>
        {%- if t.avg_rating is defined and t.avg_rating is not null %}
            {{ translations.avg_rating_l ?? 'note moyenne' }} <b>{{ t.avg_rating|number_format(1, ',', ' ') }}/5</b>
            ({{ t.rated }} {{ translations.rated_l ?? 'évaluées' }})
        {%- endif %}
    </div>

    {% if (diag.truncated ?? 0) > 0 %}
        <div class="nq-warn">{{ translations.truncated_shops ?? 'Liste tronquée :' }}
            <b>{{ diag.truncated }}</b> {{ translations.truncated_shops_2 ??
            'boutique(s) ne sont pas lues pour tenir le temps de chargement. Le plafond est réglable en configuration.' }}</div>
    {% endif %}

    {# Deux niveaux dépliables. La boutique s'ouvre par défaut, la checklist
       reste fermée : 170 tâches déroulées d'un coup ne se lisent pas. Le
       filtre rouvre ce qu'il faut — voir le script. #}
    {% for s in shops %}
        {# La couleur passe du FOND à une barre de 3 px : un bandeau saturé par
           boutique donnait à la liste l'allure d'une alerte permanente. Mêmes
           seuils que le rapport Checklist, lus en configuration. #}
        {% set c = s.completion %}
        {% set etat = c is null ? '' : (c >= (green_pct|default(90)) ? ' s-ok'
                    : (c >= (orange_pct|default(75)) ? ' s-mid' : ' s-bad')) %}
        <details class="nq-shop-g nq-card" open>
            <summary class="nq-shop{{ etat }}">
                <span class="car">{{ icons.svg('chevron-down', 14) }}</span>
                <span class="nm">{{ s.shop_name }}</span>
                <span class="v">{{ s.shop_city }}</span>
                <span class="badge js-todo" data-l="{{ translations.to_review_short ?? 'à évaluer' }}" hidden></span>
                <span class="r">{{ c is not null ? (c|round) ~ ' %' : '—' }}</span>
            </summary>
        {% for g in s.checklists %}
            <details class="nq-cl-g">
                <summary class="nq-cl" data-shop="{{ s.shop_id }}">
                    <span class="car">{{ icons.svg('chevron-down', 12) }}</span>
                    <span class="n">{{ g.name != '' ? g.name : (translations.no_checklist ?? 'Sans checklist') }}</span>
                    <span class="badge js-todo" hidden></span>
                    <span class="c">{{ g.done }}/{{ g.total }}</span>
                </summary>
            {% for task in g.tasks %}
                {# Une tâche faite s'ouvre pour être évaluée ; une tâche non
                   faite n'a rien à évaluer et n'est donc pas actionnable.
                   Même convention que _task_item.twig : un div qui se comporte
                   en bouton, que la modale reconnaît à `.task-openable`. #}
                {% set open = task.is_done %}
                <div{% if open %} tabindex="0" role="button"{% endif %}
                    class="nq-row{{ open ? ' task-openable' : '' }}"
                    data-shop="{{ s.shop_id }}"
                    data-name="{{ (task.name ~ ' ' ~ s.shop_name ~ ' ' ~ g.name)|lower }}"
                    data-state="{{ task.review_state }}"
                    data-done="{{ open ? {
                        att: task.attachment_id, file: task.attachment_filename, name: task.name,
                        by: task.completed_by, at: task.completed_at, note: task.note,
                        task_id: task.task_id, checklist_id: task.checklist_id,
                        completion_id: task.completion_id, rating: task.review_rating,
                        comment: task.review_comment, accepted: task.review_accepted
                    }|json_encode : '' }}"
                    data-mandatory="{{ task.is_mandatory ? 1 : 0 }}"
                    data-photo="{{ task.requires_photo ? 1 : 0 }}">
                    <span class="nq-b">
                        <span class="nq-n d-block">{{ task.name }}</span>
                        <span class="nq-m d-block">
                            {%- if task.is_mandatory %}<b>● {{ translations.mandatory_one ?? 'Obligatoire' }}</b> · {% endif -%}
                            {%- if task.requires_photo %}{{ translations.photo_one ?? 'Photo' }} · {% endif -%}
                            {%- if task.completed_by %}{{ task.completed_by }}{% if task.completed_at|length >= 16 %} · {{ task.completed_at|slice(11, 5) }}{% endif %}
                            {%- else %}{{ translations.not_done ?? 'Non faite' }}{% endif -%}
                        </span>
                    </span>
                    <span class="nq-right">
                        <span class="nq-rate js-rev-rating">{{ task.review_rating is not null ? task.review_rating ~ '/5' : '' }}</span>
                        {% if not task.is_done %}
                            <span class="nq-act na">{{ task.status == 'SKIPPED' ? (translations.skipped_one ?? 'Ignorée') : (translations.not_done ?? 'Non faite') }}</span>
                        {% elseif task.review_state == 'ok' %}
                            <span class="js-rev-chip nq-act ok">{{ translations.modal_ok ?? 'Conforme' }}</span>
                        {% elseif task.review_state == 'ko' %}
                            <span class="js-rev-chip nq-act ko">{{ translations.modal_ko ?? 'Non conforme' }}</span>
                        {% elseif task.review_state == 'done' %}
                            {# Hors périmètre d'évaluation : faite, et rien à
                               juger. Elle reste ouvrable — on peut vouloir
                               regarder — mais elle n'encombre pas la file. #}
                            <span class="js-rev-chip nq-act na">{{ translations.done_one ?? 'Faite' }}</span>
                        {% else %}
                            <span class="js-rev-chip nq-act todo">{{ translations.evaluate ?? 'Évaluer' }}</span>
                        {% endif %}
                    </span>
                </div>
            {% endfor %}
            </details>
        {% endfor %}
        </details>
    {% else %}
        <div class="nq-empty">{{ translations.none_for_day ?? 'Aucune tâche pour ce jour.' }}</div>
    {% endfor %}

    <div class="nq-empty" id="nqNoMatch" hidden>{{ translations.no_match ?? 'Aucune tâche ne correspond à ce filtre.' }}</div>
</div>

{% include "checklist/_review_modal.twig" %}
{% endblock %}

{% block scripts %}
<script>
/* Filtres et recherche : tout est déjà dans la page. Un aller-retour serveur
   par filtre ferait attendre pour cacher des lignes déjà présentes. */
(function () {
    var rows   = [].slice.call(document.querySelectorAll('.nq-row'));
    var shown  = document.getElementById('nqShown');
    var none   = document.getElementById('nqNoMatch');
    var search = document.getElementById('nqSearch');
    var barre  = document.getElementById('nqFilters');
    var tpl    = shown ? (shown.getAttribute('data-tpl') || '%d') : '%d';

    /* Deux dimensions cycliques. L'état neutre porte le nom de la dimension —
       « Avis : tous » — sinon deux boutons relâchés côte à côte ne disent plus
       lequel commande quoi. */
    var DIM = {
        ctrl: { i: 0, etats: [
            { v: 'todo', l: {{ (translations.f_to_review ?? 'À évaluer')|json_encode|raw }} },
            { v: 'ok',   l: {{ (translations.f_ok ?? 'Conformes')|json_encode|raw }} },
            { v: 'ko',   l: {{ (translations.f_nc ?? 'Non conformes')|json_encode|raw }} },
            { v: 'any',  l: {{ (translations.f_ctrl_any ?? 'Avis')|json_encode|raw }} }
        ] },
        real: { i: 0, etats: [
            { v: 'any',    l: {{ (translations.f_real_any ?? 'État')|json_encode|raw }} },
            { v: 'done',   l: {{ (translations.f_done ?? 'Faites')|json_encode|raw }} },
            { v: 'undone', l: {{ (translations.f_undone ?? 'Non faites')|json_encode|raw }} }
        ] }
    };
    var val = function (d) { return DIM[d].etats[DIM[d].i].v; };

    // Périmètre pré-activé, d'après la configuration : obligatoire et avec
    // photo. Sans photo il n'y a rien à vérifier ; hors obligatoire, rien à
    // exiger. Le consultant peut relâcher l'un ou l'autre d'un doigt.
    var perim = {
        mandatory: barre.querySelector('[data-s="mandatory"]').classList.contains('on'),
        photo:     barre.querySelector('[data-s="photo"]').classList.contains('on')
    };

    /* Boutique choisie dans la bande ('' = toutes). Une troisième dimension,
       qui se combine aux deux autres comme le périmètre. */
    var bande = document.getElementById('nqShops');
    var boutique = '';

    /** Une vue restreinte : le dépliage automatique n'a de sens que là. */
    function actif() {
        return val('ctrl') !== 'any' || val('real') !== 'any' || boutique !== ''
            || perim.mandatory || perim.photo || (search.value || '').trim() !== '';
    }

    /** Le périmètre, la boutique et la recherche — ce qui s'applique à TOUT. */
    function dansPerimetre(r) {
        if (boutique !== '' && r.getAttribute('data-shop') !== boutique) { return false; }
        if (perim.mandatory && r.getAttribute('data-mandatory') !== '1') { return false; }
        if (perim.photo     && r.getAttribute('data-photo') !== '1')     { return false; }
        var q = (search.value || '').trim().toLowerCase();
        return q === '' || (r.getAttribute('data-name') || '').indexOf(q) !== -1;
    }

    /** Ce qu'une boutique donnerait, tous les AUTRES filtres appliqués. */
    function pourBoutique(id) {
        return rows.filter(function (r) {
            if (id !== '' && r.getAttribute('data-shop') !== id) { return false; }
            if (perim.mandatory && r.getAttribute('data-mandatory') !== '1') { return false; }
            if (perim.photo     && r.getAttribute('data-photo') !== '1')     { return false; }
            var q = (search.value || '').trim().toLowerCase();
            if (q !== '' && (r.getAttribute('data-name') || '').indexOf(q) === -1) { return false; }
            return dansCtrl(r, val('ctrl')) && dansReal(r, val('real'));
        }).length;
    }

    /** L'avis : à évaluer, conforme, non conforme — ou peu importe. */
    function dansCtrl(r, v) {
        if (v === 'any') { return true; }
        return r.getAttribute('data-state') === v;
    }

    /** La réalisation : faite (quel que soit l'avis) ou non faite. */
    function dansReal(r, v) {
        var st = r.getAttribute('data-state');
        if (v === 'done')   { return st !== 'na'; }
        if (v === 'undone') { return st === 'na'; }
        return true;
    }

    function garde(r) {
        return dansPerimetre(r) && dansCtrl(r, val('ctrl')) && dansReal(r, val('real'));
    }

    /** Chaque bouton affiche l'état courant ET ce qu'il donnerait. */
    function peindre() {
        [].slice.call(barre.querySelectorAll('.nq-cyc')).forEach(function (b) {
            var d = b.getAttribute('data-c');
            var e = DIM[d].etats[DIM[d].i];
            b.querySelector('.lb').textContent = e.l;
            b.classList.toggle('on', e.v !== 'any');
            // Le compte de CETTE dimension, les autres filtres appliqués.
            var n = rows.filter(function (r) {
                if (!dansPerimetre(r)) { return false; }
                return d === 'ctrl'
                    ? dansCtrl(r, e.v) && dansReal(r, val('real'))
                    : dansReal(r, e.v) && dansCtrl(r, val('ctrl'));
            }).length;
            b.querySelector('.n').textContent = e.v === 'any' ? '' : n;
        });
        if (!bande) { return; }
        // Chaque boutique annonce ce qu'elle donnerait — et s'efface si elle ne
        // donnerait rien, sans devenir inatteignable pour autant.
        [].slice.call(bande.querySelectorAll('.nq-sh')).forEach(function (b) {
            var id = b.getAttribute('data-shop');
            var n = pourBoutique(id);
            var c = b.querySelector('.n');
            if (c) { c.textContent = n; }
            b.classList.toggle('on', id === boutique);
            b.classList.toggle('creuse', n === 0 && id !== boutique);
        });
    }

    /* Ce qui est actif, en clair. Replier les filtres ne doit pas cacher ce
       qu'ils font : sans cette ligne, un écran filtré ressemble à un écran
       vide, et on cherche pourquoi il manque des tâches. */
    var pastille = document.getElementById('nqActifs');
    var resume   = document.getElementById('nqResume');
    var LBL = {
        mandatory: {{ (translations.f_mandatory_one ?? 'Obligatoire')|json_encode|raw }},
        photo:     {{ (translations.f_photo_one ?? 'Photo')|json_encode|raw }},
        un:        {{ (translations.n_filters_one ?? '1 filtre')|json_encode|raw }},
        n:         {{ (translations.n_filters ?? '%d filtres')|json_encode|raw }},
        aucun:     {{ (translations.n_filters_none ?? 'Filtrer')|json_encode|raw }},
        tout:      {{ (translations.f_no_filter ?? 'Toutes les tâches du jour')|json_encode|raw }}
    };

    function resumer() {
        var mots = [];
        if (val('ctrl') !== 'any') { mots.push(DIM.ctrl.etats[DIM.ctrl.i].l); }
        if (val('real') !== 'any') { mots.push(DIM.real.etats[DIM.real.i].l); }
        if (perim.mandatory) { mots.push(LBL.mandatory); }
        if (perim.photo)     { mots.push(LBL.photo); }
        if (boutique !== '' && bande) {
            var b = bande.querySelector('.nq-sh[data-shop="' + boutique + '"] .nm');
            if (b) { mots.push(b.textContent.trim()); }
        }
        var n = mots.length;
        pastille.textContent = n === 0 ? LBL.aucun
            : (n === 1 ? LBL.un : LBL.n.replace('%d', n));
        pastille.classList.toggle('vide', n === 0);
        resume.innerHTML = n === 0 ? LBL.tout
            : mots.map(function (m) {
                return '<b>' + m.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</b>';
              }).join(' · ');
    }

    function appliquer() {
        peindre();
        resumer();
        var vus = 0;
        rows.forEach(function (r) {
            var ok = garde(r);
            r.hidden = !ok;
            if (ok) { vus++; }
        });

        // Un groupe sans aucune ligne retenue n'annonce plus rien : il devient
        // un titre creux. On le masque plutôt que de laisser croire à un
        // contenu replié.
        [].slice.call(document.querySelectorAll('.nq-cl-g')).forEach(function (g) {
            var lignes = [].slice.call(g.querySelectorAll('.nq-row'));
            var retenues = lignes.filter(function (r) { return !r.hidden; });
            g.hidden = retenues.length === 0;
            // Un filtre actif rouvre ce qu'il a trouvé : filtrer puis ne rien
            // voir parce que tout est replié serait un cul-de-sac. Sans filtre,
            // les checklists restent fermées — cent-soixante-dix tâches
            // déroulées ne se lisent pas.
            g.open = actif() ? retenues.length > 0 : false;
            var c = g.querySelector('.nq-cl .c');
            if (c) {
                c.textContent = actif() ? retenues.length : (c.getAttribute('data-base') || c.textContent);
            }
            badge(g, retenues);
        });
        [].slice.call(document.querySelectorAll('.nq-shop-g')).forEach(function (g) {
            var retenues = [].slice.call(g.querySelectorAll('.nq-row')).filter(function (r) { return !r.hidden; });
            g.hidden = retenues.length === 0;
            if (actif()) { g.open = true; }
            badge(g, retenues);
        });

        if (none) { none.hidden = vus > 0; }
        if (shown) {
            shown.innerHTML = actif() ? tpl.replace('%d', '<b>' + vus + '</b>') + ' · ' : '';
        }
        var ligne = document.getElementById('nqCount');
        if (ligne) { ligne.hidden = ligne.textContent.trim() === ''; }
    }

    /** « n à évaluer » sur l'en-tête d'un groupe, au périmètre courant. */
    function badge(groupe, retenues) {
        var b = groupe.querySelector(':scope > summary .js-todo');
        if (!b) { return; }
        var n = retenues.filter(function (r) { return r.getAttribute('data-state') === 'todo'; }).length;
        b.hidden = n === 0;
        b.textContent = b.hasAttribute('data-l') ? n + ' ' + b.getAttribute('data-l') : n;
    }

    /* Hauteur réelle des outils collants : le bandeau de boutique s'y cale.
       Recalculée au redimensionnement — la barre passe d'une à deux lignes
       selon la largeur. */
    var outils = document.querySelector('.nq-tools');
    function majOffset() {
        document.documentElement.style.setProperty('--nq-tools-h', outils.offsetHeight + 'px');
    }
    // Un `resize` de fenêtre ne suffit pas : la barre change de hauteur quand
    // les polices arrivent ou qu'un libellé s'allonge, sans que la fenêtre
    // bouge. On observe l'élément lui-même — mesuré une fois au chargement, il
    // restait à 106 px alors qu'il en faisait 150.
    if (window.ResizeObserver) {
        new ResizeObserver(majOffset).observe(outils);
    } else {
        window.addEventListener('resize', majOffset);
    }
    majOffset();

    // Compteur d'origine mémorisé : filtrer le remplace par le nombre montré,
    // et revenir à la vue complète doit rendre le vrai fait/total.
    [].slice.call(document.querySelectorAll('.nq-cl .c')).forEach(function (c) {
        c.setAttribute('data-base', c.textContent.trim());
    });

    barre.addEventListener('click', function (e) {
        var b = e.target.closest('.nq-f');
        if (!b) { return; }
        var d = b.getAttribute('data-c');
        if (d) {
            DIM[d].i = (DIM[d].i + 1) % DIM[d].etats.length;   // l'état suivant
        } else {
            var p = b.getAttribute('data-s');
            perim[p] = !perim[p];                               // une bascule
            b.classList.toggle('on', perim[p]);
        }
        appliquer();
    });
    if (bande) {
        bande.addEventListener('click', function (e) {
            var b = e.target.closest('.nq-sh');
            if (!b) { return; }
            var id = b.getAttribute('data-shop');
            // Re-cliquer la boutique courante la désélectionne : sortir d'un
            // filtre doit coûter le même geste que d'y entrer.
            boutique = (id === boutique) ? '' : id;
            appliquer();
        });
    }
    search.addEventListener('input', appliquer);

    // Le panneau est REPLIÉ au départ : il occupait la moitié de l'écran en
    // permanence pour des réglages qu'on touche une fois par tournée.
    var outilsBoite = document.getElementById('nqTools');
    var panneau = document.getElementById('nqPanel');
    document.getElementById('nqToggle').addEventListener('click', function () {
        var ouvert = panneau.hidden;
        panneau.hidden = !ouvert;
        outilsBoite.classList.toggle('ouvert', ouvert);
        this.setAttribute('aria-expanded', ouvert ? 'true' : 'false');
        majOffset();
    });

    appliquer();
})();
</script>
