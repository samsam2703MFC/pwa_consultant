{# Pilotage de la modale d'évaluation — voir _review_modal.twig. #}
<script>
/* Réalisation d'une tâche : photo + note + avis. L'URL signée de la pièce
   jointe est demandée AU CLIC — une par tâche au chargement de la page
   ferait autant d'appels pour des photos que personne n'ouvrira. */
(function () {
    var modal = document.getElementById('dnModal');
    if (!modal) { return; }
    var ROOT = window.__consultantRoot || '';
    var L = {
        note:    {{ (translations.modal_note ?? 'Note de la personne')|json_encode|raw }},
        noNote:  {{ (translations.modal_no_note ?? 'Aucune note laissée.')|json_encode|raw }},
        review:  {{ (translations.modal_review ?? 'Avis du consultant')|json_encode|raw }},
        loading: {{ (translations.modal_loading ?? 'Chargement de la photo…')|json_encode|raw }},
        failed:  {{ (translations.modal_failed ?? 'Photo indisponible.')|json_encode|raw }},
        open:    {{ (translations.modal_open ?? 'Ouvrir dans un nouvel onglet')|json_encode|raw }},
        saving:  {{ (translations.modal_saving ?? 'Enregistrement…')|json_encode|raw }},
        saved:   {{ (translations.modal_saved ?? 'Évaluation enregistrée.')|json_encode|raw }},
        needRate:{{ (translations.modal_need_rate ?? 'Choisissez une note de 1 à 5.')|json_encode|raw }},
        savedNoJournal: {{ (translations.modal_saved_no_journal ?? "Avis enregistré, mais son auteur n'a pas pu être consigné.")|json_encode|raw }},
        verified: {{ (translations.verified ?? 'Vérifié')|json_encode|raw }},
        conform:    {{ (translations.modal_ok ?? 'Conforme')|json_encode|raw }},
        notConform: {{ (translations.modal_ko ?? 'Non conforme')|json_encode|raw }}
    };
    /* Boutique de la page. Sur la liste réseau il n'y en a pas : chaque carte
       porte la sienne dans `data-shop`, et c'est elle qui fait foi. Envoyer
       l'avis à la mauvaise boutique le rendrait invisible là où il a été posé
       et le ferait apparaître ailleurs. */
    var SHOP = {{ id_shop|default(0)|json_encode|raw }};
    function shopOf(card) {
        return (card && parseInt(card.getAttribute('data-shop'), 10)) || SHOP;
    }
    var DATE = {{ (date ?? '')|json_encode|raw }};
    /* Notes posées d'office par « Conforme » / « Non conforme ». Le consultant
       contrôle des dizaines de tâches : lui faire poser une note ET un verdict
       pour chacune double le geste. Il reste libre de corriger aux étoiles. */
    var RATE_OK = {{ rating_ok|default(4)|json_encode|raw }};
    var RATE_KO = {{ rating_ko|default(2)|json_encode|raw }};
    var current = null, rating = 0, ratingManual = false, accepted = null, openSeq = 0, openedCard = null;

    function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function close() { modal.hidden = true; }

    function msg(text, ok) {
        var el = document.getElementById('dnMsg');
        if (!text) { el.hidden = true; el.textContent = ''; return; }
        el.hidden = false;
        el.className = 'dn-msg ' + (ok ? 'ok' : 'ko');
        el.textContent = text;
    }
    /**
     * @param n       note de 0 (aucune) à 5
     * @param manuel  vrai si le consultant l'a posée aux étoiles. Une note
     *                manuelle n'est plus remplacée par celle du verdict.
     */
    function setRating(n, manuel) {
        rating = n || 0;
        ratingManual = !!manuel;
        document.querySelectorAll('#dnStars .st').forEach(function (b) {
            var v = parseInt(b.getAttribute('data-n'), 10);
            b.classList.toggle('on', v <= rating);
            b.setAttribute('aria-checked', v === rating ? 'true' : 'false');
        });
    }
    /**
     * Inscrit « Vérifié par <qui> le <quand> » sur la tâche sans recharger la
     * page : la ligne vient du journal local, et le serveur ne la renverra
     * qu'au prochain chargement.
     */
    function stampReview() {
        if (!openedCard) { return; }

        // Liste réseau : la ligne porte une pastille de verdict et une note.
        // Les laisser sur « À évaluer » après un enregistrement ferait
        // recommencer le travail qu'on vient de faire.
        var chip = openedCard.querySelector('.js-rev-chip');
        if (chip) {
            var ko = accepted === false;
            chip.className = 'js-rev-chip nq-act ' + (ko ? 'ko' : 'ok');
            chip.textContent = ko ? L.notConform : L.conform;
            var note = openedCard.querySelector('.js-rev-rating');
            if (note) { note.textContent = rating ? rating + '/5' : ''; }
            openedCard.classList.remove('is-todo');
            return;
        }

        var line = openedCard.querySelector('.task-rev');
        if (!line) {
            line = document.createElement('div');
            line.className = 'task-rev';
            var see = openedCard.querySelector('.task-see');
            var host = see ? null : openedCard.querySelector('.flex-grow-1');
            if (see) { see.parentNode.insertBefore(line, see); }
            else if (host) { host.appendChild(line); }
            else { openedCard.appendChild(line); }
        }
        line.classList.toggle('ko', accepted === false);
        line.textContent = L.verified;
    }

    function setAccepted(v) {
        accepted = v;
        document.querySelectorAll('.dn-acc .ac').forEach(function (b) {
            b.classList.toggle('on', accepted !== null && String(accepted ? 1 : 0) === b.getAttribute('data-acc'));
        });
    }

    function open(card) {
        var d;
        try { d = JSON.parse(card.getAttribute('data-done')); } catch (e) { return; }
        if (!d) { return; }
        openedCard = card;

        document.getElementById('dnTitle').textContent = d.name || '';
        var who = (d.by ? d.by : '') + (d.at ? ' · ' + String(d.at).slice(0, 16).replace('T', ' ') : '');
        document.getElementById('dnWho').textContent = who;

        // La note est TOUJOURS affichée : sans encart, un champ vide côté API
        // ressemble à un bug d'affichage.
        var extra = '<div class="sect">' + esc(L.note) + '</div>'
            + (d.note ? '<div class="txt">' + esc(d.note) + '</div>'
                      : '<div class="txt empty">' + esc(L.noNote) + '</div>');
        document.getElementById('dnExtra').innerHTML = extra;

        // Évaluation existante rechargée dans le formulaire. La note n'est pas
        // marquée « manuelle » : changer de verdict sur une tâche déjà évaluée
        // doit refaire descendre la note, sinon une tâche passée à « non
        // conforme » garderait un 4 et la NC serait comptée mineure.
        current = d;
        setRating(d.rating != null ? parseInt(d.rating, 10) : 0);
        setAccepted(d.accepted == null ? null : (String(d.accepted) === '1' || d.accepted === true));
        document.getElementById('dnComment').value = d.comment || '';
        msg(null);

        var ph = document.getElementById('dnPhoto');
        // Le lien « ouvrir » est un élément UNIQUE, réutilisé : en créer un à
        // chaque ouverture les empilait sous la photo.
        var link = document.getElementById('dnOpen');
        link.hidden = true;
        link.removeAttribute('href');
        link.textContent = L.open;
        modal.hidden = false;

        // Toutes les tâches ne demandent pas de photo. Sur la liste réseau,
        // elles sont pourtant toutes à évaluer : sans cette sortie, la modale
        // s'ouvrait sur un « Chargement de la photo… » qui n'arrivait jamais.
        if (!d.att) {
            ph.innerHTML = '';
            openSeq++;
            return;
        }
        ph.innerHTML = '<div class="msg">' + esc(L.loading) + '</div>';

        // Jeton d'ouverture : une réponse arrivée en retard ne doit pas écraser
        // la photo d'une tâche ouverte entre-temps.
        var token = ++openSeq;
        fetch(ROOT + '/helpdesk/attachments/' + encodeURIComponent(d.att) + '/url',
              { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (j) {
                if (token !== openSeq) { return; }
                var url = j && j.data && j.data.url;
                if (!url) { throw new Error('no url'); }
                ph.innerHTML = '<img src="' + esc(url) + '" alt="' + esc(d.file || d.name) + '" loading="lazy">';
                link.href = url;
                link.hidden = false;
            })
            .catch(function () {
                if (token !== openSeq) { return; }
                ph.innerHTML = '<div class="msg">' + esc(L.failed) + '</div>';
            });
    }

    // ── Évaluation : étoiles, conformité, enregistrement ──
    document.querySelectorAll('#dnStars .st').forEach(function (b) {
        b.addEventListener('click', function () { setRating(parseInt(b.getAttribute('data-n'), 10), true); msg(null); });
    });
    document.getElementById('dnClear').addEventListener('click', function () { setRating(0); setAccepted(null); msg(null); });
    document.querySelectorAll('.dn-acc .ac').forEach(function (b) {
        b.addEventListener('click', function () {
            var v = b.getAttribute('data-acc') === '1';
            var retire = (accepted === v);            // re-clic = on retire le choix
            setAccepted(retire ? null : v);
            // Le verdict pose la note — mais il n'écrase pas celle que le
            // consultant a posée aux étoiles : s'il a mis 5 puis coché
            // « conforme », il voulait 5, pas la note d'office.
            if (!ratingManual) {
                setRating(retire ? 0 : (v ? RATE_OK : RATE_KO));
            }
            msg(null);
        });
    });
    document.getElementById('dnSave').addEventListener('click', function () {
        if (!current) { return; }
        if (!rating) { msg(L.needRate, false); return; }
        var btn = this;
        var comment = document.getElementById('dnComment').value || null;
        btn.disabled = true;
        msg(L.saving, true);
        // Le contrat d'envoi vit dans _review_submit.twig : la modale et la
        // pile de contrôle postent exactement la même chose.
        window.tfbReview.submit({
            shop_id:       shopOf(openedCard),
            checklist_id:  current.checklist_id,
            task_id:       current.task_id,
            date:          DATE,
            completion_id: current.completion_id,
            rating:        rating,
            accepted:      accepted,
            comment:       comment
        })
            .then(function (res) {
                // L'avis est parti à l'API. Le nom du vérificateur, lui, vient
                // du journal local : s'il n'a pas pu être écrit, la ligne
                // « Vérifié par » restera anonyme — autant le dire tout de suite.
                if (!res.journal) {
                    // Avertissement à lire : la modale reste ouverte.
                    msg(L.savedNoJournal + (res.journalError ? ' — ' + res.journalError : ''), false);
                } else {
                    msg(L.saved, true);
                    stampReview();
                    // Le contrôle est terminé : on rend la liste au consultant
                    // sans lui faire fermer la modale à la main. Le court délai
                    // laisse voir la confirmation. Le jeton d'ouverture évite
                    // de refermer une AUTRE tâche ouverte entre-temps.
                    var token = openSeq;
                    setTimeout(function () { if (openSeq === token) { close(); } }, 800);
                }
            })
            .catch(function (e) { msg(String(e.message || e), false); })
            .then(function () { btn.disabled = false; });
    });

    document.addEventListener('click', function (e) {
        var card = e.target.closest && e.target.closest('.task-openable[data-done]');
        if (card) { open(card); }
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) { close(); return; }
        if (e.key === 'Enter' && e.target.closest) {
            var card = e.target.closest('.task-openable[data-done]');
            if (card) { open(card); }
        }
    });
    document.getElementById('dnBg').addEventListener('click', close);
    document.getElementById('dnClose').addEventListener('click', close);
})();
</script>
