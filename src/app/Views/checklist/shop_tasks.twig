{% extends "layouts/mobile_base.twig" %}

{% import "components/_icons.twig" as icons %}
{% set active_nav = 'checklists' %}
{% set summary = data.summary ?? {} %}
{% set tasks = data.tasks ?? [] %}
{% set trend = data.trend ?? [] %}
{% set today_date = today ?? ('now' | date('Y-m-d')) %}
{% set id_shop = id_shop ?? shop_id %}

{% block title %}{{ translations.shop_tasks_title ?? 'Tâches de la boutique' }} — Consultant Panel{% endblock %}
{% block page_title %}{{ translations.shop_tasks_title ?? 'Tâches de la boutique' }}{% endblock %}
{% block page_subtitle %}{{ date | date('d.m.Y') }}{% endblock %}

{% block topbar_actions %}
<div class="d-flex align-items-center gap-1">
    {% set prev_date = date | date_modify('-1 day') | date('Y-m-d') %}
    <a href="{{ ROOT }}/checklists/shops/{{ id_shop }}/tasks?date={{ prev_date }}" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:32px;height:32px;"><span style="font-size:.8rem;">{{ icons.svg('chevron-left') }}</span></a>
    <button type="button" class="btn btn-sm btn-light rounded-pill px-2" style="font-size:.75rem;font-weight:700;min-width:80px;" onclick="document.getElementById('stDatePicker').showPicker()"><span class="me-1">{{ icons.svg('calendar') }}</span>{{ date | date('d.m.Y') }}</button>
    <input type="date" id="stDatePicker" value="{{ date }}" max="{{ today_date }}" style="position:absolute;opacity:0;pointer-events:none;width:0;height:0;" onchange="window.location.href='{{ ROOT }}/checklists/shops/{{ id_shop }}/tasks?date='+this.value">
    {% set next_date = date | date_modify('+1 day') | date('Y-m-d') %}
    {% if next_date <= today_date %}<a href="{{ ROOT }}/checklists/shops/{{ id_shop }}/tasks?date={{ next_date }}" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:32px;height:32px;"><span style="font-size:.8rem;">{{ icons.svg('chevron-right') }}</span></a>{% endif %}
</div>
{% endblock %}

{% block head %}
<style>
    .rate-card { background:#fff; border-radius:16px; padding:14px; margin-bottom:12px; box-shadow:0 2px 8px rgba(0,0,0,.06); }
    .rate-num { font-size:2rem; font-weight:900; line-height:1; }
    .rate-track { height:8px; border-radius:4px; background:#eef0f5; overflow:hidden; margin:8px 0; }
    .rate-fill { height:100%; border-radius:4px; }
    .rate-fill.ex { background:linear-gradient(90deg,#27ae60,#2ecc71); }
    .rate-fill.ok { background:linear-gradient(90deg,#f39c12,#f1c40f); }
    .rate-fill.no { background:linear-gradient(90deg,#e74c3c,#c0392b); }
    .summary-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:12px; }
    .sum-cell { background:#fff; border-radius:12px; padding:10px 6px; text-align:center; box-shadow:0 1px 6px rgba(0,0,0,.05); }
    .sum-val { font-size:1.2rem; font-weight:900; line-height:1; }
    .sum-lbl { font-size:.6rem; color:#6c757d; margin-top:3px; }
    .trend-card { background:#fff; border-radius:16px; padding:14px; margin-bottom:12px; box-shadow:0 2px 8px rgba(0,0,0,.06); }
    .trend-bars { display:flex; gap:6px; align-items:flex-end; height:56px; }
    .trend-col { flex:1; display:flex; flex-direction:column; align-items:center; gap:3px; }
    .trend-bar { width:100%; border-radius:4px 4px 0 0; min-height:4px; background:#e9ecef; }
    .trend-bar.ex { background:#2ecc71; } .trend-bar.ok { background:#f1c40f; } .trend-bar.no { background:#e74c3c; }
    .trend-dot { width:6px; height:6px; border-radius:50%; background:#ffc107; } .trend-dot.closed { background:#27ae60; }
    .trend-label { font-size:.56rem; color:#adb5bd; text-transform:uppercase; }
    .section-title { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:#6c757d; padding:8px 4px 6px; }
    .task-card { background:#fff; border-radius:14px; padding:12px; margin-bottom:8px; box-shadow:0 1px 5px rgba(0,0,0,.05); display:flex; align-items:flex-start; gap:12px; }
    .task-status-icon { width:34px; height:34px; border-radius:10px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:1rem; }
    .status-done { background:#d1fae5; color:#065f46; } .status-skipped { background:#fef3c7; color:#92400e; } .status-failed { background:#fee2e2; color:#991b1b; } .status-pending { background:#f0f0f5; color:#6c757d; }
    .task-name { font-size:.88rem; font-weight:800; color:#212529; }
    .task-meta { font-size:.7rem; color:#adb5bd; margin-top:3px; }
    .task-badge { display:inline-flex; align-items:center; gap:3px; padding:1px 6px; border-radius:8px; font-size:.62rem; font-weight:700; margin-right:4px; }
    .badge-mandatory { background:#fee2e2; color:#991b1b; } .badge-photo { background:#e0e7ff; color:#3730a3; } .badge-time { background:#f0fdf4; color:#166534; }
    .task-by { font-size:.68rem; color:#6c757d; margin-top:4px; }
    .task-note { font-size:.72rem; color:#6c757d; background:#f8f9fa; border-radius:6px; padding:4px 8px; margin-top:4px; font-style:italic; }
    .empty-state { text-align:center; padding:32px 20px; color:#adb5bd; }

    /* Accordéon : une checklist → drop-list de ses tâches */
    .cl-group { background:#fff; border-radius:14px; margin-bottom:8px; box-shadow:0 1px 5px rgba(0,0,0,.05); overflow:hidden; }
    .cl-head { display:flex; align-items:center; gap:8px; min-height:52px; padding:10px 12px; cursor:pointer; list-style:none; -webkit-tap-highlight-color:transparent; }
    .cl-head::-webkit-details-marker { display:none; }
    .cl-ico { width:30px; height:30px; border-radius:9px; flex-shrink:0; display:flex; align-items:center; justify-content:center; background:#eef2ff; color:#435ebe; }
    .cl-name { flex:1; min-width:0; font-size:.86rem; font-weight:800; color:#212529; line-height:1.25; }
    .cl-flag { display:inline-flex; align-items:center; gap:3px; flex-shrink:0; padding:2px 7px; border-radius:999px; font-size:.66rem; font-weight:800; background:#fee2e2; color:#991b1b; }
    .cl-count { flex-shrink:0; padding:3px 8px; border-radius:999px; font-size:.7rem; font-weight:800; background:#f0f0f5; color:#6c757d; }
    .cl-count.part { background:#fef3c7; color:#92400e; }
    .cl-count.all { background:#d1fae5; color:#065f46; }
    .cl-caret { flex-shrink:0; color:#adb5bd; transition:transform .15s ease; display:flex; }
    .cl-group[open] .cl-caret { transform:rotate(180deg); }
    .cl-group[open] .cl-head { border-bottom:1px solid #f1f3f5; }
    .cl-body { padding:8px 8px 4px; background:#fafbfc; }
    .cl-body .task-card { box-shadow:none; border:1px solid #f1f3f5; }

    /* Avis du consultant : une seule ligne de texte, sans fond ni ornement. */
    .task-rev { display:flex; align-items:center; gap:5px; margin-top:5px;
                font-size:.66rem; font-weight:600; color:#2D7A3E; }
    .task-rev.ko { color:#c0182b; }

    /* Tâche faite avec photo : carte cliquable + modale de réalisation */
    .task-openable { cursor:pointer; }
    .task-openable:hover { background:#fbfcfe; }
    .task-see { display:inline-flex; align-items:center; gap:4px; margin-top:5px; font-size:.68rem;
                font-weight:800; color:#435ebe; }
    .dn-modal { position:fixed; inset:0; z-index:1080; display:flex; align-items:center;
                justify-content:center; padding:14px; }
    .dn-modal[hidden] { display:none; }
    .dn-modal .bg { position:absolute; inset:0; background:rgba(24,18,14,.55); }
    .dn-modal .card { position:relative; background:#fff; border-radius:16px; width:100%;
                      max-width:400px; max-height:88vh; overflow:auto; padding:14px 16px 16px;
                      box-shadow:0 18px 50px -12px rgba(0,0,0,.4); }
    .dn-modal .hd { display:flex; align-items:flex-start; gap:8px; margin-bottom:10px; }
    .dn-modal .ti { flex:1; font-size:.92rem; font-weight:800; color:#8D1D2C; line-height:1.3; }
    .dn-modal .x { flex-shrink:0; width:30px; height:30px; border:0; border-radius:50%;
                   background:#f1ece4; color:#5f574f; font-size:1rem; line-height:1; cursor:pointer; }
    .dn-modal .who { font-size:.72rem; color:#6c757d; margin-bottom:8px; }
    .dn-modal .ph { border-radius:12px; overflow:hidden; border:1px solid rgba(0,0,0,.08);
                    background:#f6f3ee; min-height:120px; display:flex; align-items:center;
                    justify-content:center; }
    .dn-modal .ph img { width:100%; height:auto; display:block; }
    .dn-modal .ph .msg { font-size:.74rem; color:#9a9086; padding:26px 12px; text-align:center; }
    .dn-modal .sect { font-size:.64rem; font-weight:800; text-transform:uppercase;
                      letter-spacing:.05em; color:#8D1D2C; margin:12px 0 4px; }
    .dn-modal .txt { font-size:.8rem; color:#241f1c; line-height:1.5; background:#faf7f2;
                     border-radius:8px; padding:8px 10px; }
    .dn-modal .lnk { display:block; text-align:center; margin-top:10px; font-size:.76rem;
                     font-weight:800; color:#435ebe; }
    .dn-modal .lnk[hidden] { display:none; }
    .dn-modal .txt.empty { color:#9a9086; font-style:italic; }

    /* Évaluation : étoiles, conformité, commentaire */
    .dn-stars { display:flex; align-items:center; gap:2px; }
    .dn-stars .st { border:0; background:none; padding:0 2px; font-size:1.5rem; line-height:1;
                    color:#ddd6cb; cursor:pointer; }
    .dn-stars .st.on { color:#C9A227; }
    .dn-clear { margin-left:8px; font-size:.66rem; color:#9a9086; cursor:pointer;
                text-decoration:underline; }
    .dn-acc { display:flex; gap:6px; margin-top:8px; }
    .dn-acc .ac { flex:1; border:1.5px solid #e7ded2; background:#fff; border-radius:999px;
                  padding:6px 10px; font-size:.72rem; font-weight:800; color:#7a7168; cursor:pointer; }
    .dn-acc .ac.ok.on { background:#2D7A3E; border-color:#2D7A3E; color:#fff; }
    .dn-acc .ac.no.on { background:#8D1D2C; border-color:#8D1D2C; color:#fff; }
    .dn-cm { width:100%; margin-top:8px; border:1.5px solid #e7ded2; border-radius:10px;
             padding:8px 10px; font-size:.78rem; font-family:inherit; resize:vertical; }
    .dn-save { width:100%; margin-top:8px; border:0; border-radius:999px; background:#8D1D2C;
               color:#fff; font-size:.8rem; font-weight:800; padding:10px; cursor:pointer; }
    .dn-save[disabled] { opacity:.55; cursor:default; }
    .dn-msg { margin-top:8px; font-size:.72rem; border-radius:8px; padding:7px 9px; }
    .dn-msg[hidden] { display:none; }
    .dn-msg.ok { background:rgba(45,122,62,.1); color:#2D7A3E; }
    .dn-msg.ko { background:rgba(192,24,43,.1); color:#c0182b; }

</style>
{% endblock %}

{% block content %}
<div id="shop-checklists-skeleton" aria-hidden="true">
    <div class="skeleton-hero" style="min-height:90px;border-radius:16px;"></div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px;">
        <div class="skeleton-card" style="padding:12px;min-height:70px;"></div>
        <div class="skeleton-card" style="padding:12px;min-height:70px;"></div>
        <div class="skeleton-card" style="padding:12px;min-height:70px;"></div>
        <div class="skeleton-card" style="padding:12px;min-height:70px;"></div>
    </div>
    <div class="skeleton-card" style="min-height:70px;margin-bottom:8px;"></div>
    <div class="skeleton-card"><div class="skeleton-line"></div><div class="skeleton-line" style="width:80%;"></div><div class="skeleton-line" style="width:60%;"></div></div>
</div>

<div id="shop-checklists-content" style="display:none;" class="page-content-loaded">
    <a href="{{ ROOT }}/checklists?date={{ date }}" class="app-back-btn">{{ icons.svg('chevron-left', 16) }}<span>{{ translations.back_to_ranking ?? 'Retour au classement' }}</span></a>


    {% set cr = summary.completion_rate ?? null %}
    {% set rate_class = cr is not null ? (cr >= 80 ? 'ex' : (cr >= 50 ? 'ok' : 'no')) : 'no' %}
    <div class="rate-card">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div style="font-size:.7rem;color:#6c757d;text-transform:uppercase;letter-spacing:.06em;">{{ translations.realization ?? 'Réalisation' }}</div>
                <div class="rate-num" style="color:{{ cr is not null ? (cr >= 80 ? '#27ae60' : (cr >= 50 ? '#e67e22' : '#e74c3c')) : '#adb5bd' }}">{{ cr is not null ? cr ~ '%' : '—' }}</div>
            </div>
            <div style="text-align:right;font-size:.78rem;color:#6c757d;">{{ summary.tasks_done ?? 0 }} / {{ summary.tasks_total ?? 0 }}<br>{{ translations.tasks_done_suffix ?? 'tâches faites' }}</div>
        </div>
        <div class="rate-track"><div class="rate-fill {{ rate_class }}" style="width:{{ cr ?? 0 }}%"></div></div>
        <div style="font-size:.7rem;color:#adb5bd;">{{ summary.tasks_pending ?? 0 }} {{ translations.pending ?? 'attente' }}{% if (summary.tasks_skipped ?? 0) > 0 %} · {{ summary.tasks_skipped }} {{ translations.skipped_pl ?? 'ignorées' }}{% endif %}{% if (summary.tasks_failed ?? 0) > 0 %} · {{ summary.tasks_failed }} {{ translations.failed_pl ?? 'échecs' }}{% endif %}</div>
    </div>

    <div class="summary-grid">
        <div class="sum-cell"><div class="sum-val" style="color:#27ae60;">{{ summary.tasks_done ?? 0 }}</div><div class="sum-lbl">{{ translations.state_done ?? 'faites' }}</div></div>
        <div class="sum-cell"><div class="sum-val" style="color:#435ebe;">{{ summary.tasks_pending ?? 0 }}</div><div class="sum-lbl">{{ translations.state_pending ?? 'attente' }}</div></div>
        <div class="sum-cell"><div class="sum-val" style="color:#e67e22;">{{ summary.tasks_skipped ?? 0 }}</div><div class="sum-lbl">{{ translations.state_skipped ?? 'ignorée' }}</div></div>
        <div class="sum-cell"><div class="sum-val" style="color:#e74c3c;">{{ summary.tasks_failed ?? 0 }}</div><div class="sum-lbl">{{ translations.state_failed ?? 'échec' }}</div></div>
    </div>

    {% if trend | length > 0 %}
        <div class="trend-card">
            <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#6c757d;margin-bottom:10px;"><span class="me-1">{{ icons.svg('bar-chart') }}</span>{{ translations.last_7_days ?? '7 derniers jours' }}</div>
            <div class="trend-bars">
                {% for tr in trend %}
                    {% set tr_class = tr.completion_rate >= 80 ? 'ex' : (tr.completion_rate >= 50 ? 'ok' : (tr.completion_rate > 0 ? 'no' : '')) %}
                    {% set bar_h = (tr.completion_rate * 0.56) | round %}
                    <div class="trend-col"><div class="trend-bar {{ tr_class }}" style="height:{{ bar_h }}px;"></div><div class="trend-dot {{ tr.day_closed ? 'closed' : '' }}"></div><div class="trend-label">{{ tr.day | date('D') | slice(0,1) }}</div></div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% set checklist_groups = checklist_groups|default([]) %}
    {% if checklist_groups | length > 0 %}
        <div class="section-title"><span class="me-1">{{ icons.svg('list-checks') }}</span>{{ translations.checklists_of_day ?? 'Checklists du jour' }}</div>
        {% for g in checklist_groups %}
            <details class="cl-group">
                <summary class="cl-head">
                    <span class="cl-ico">{{ icons.svg('clipboard-check') }}</span>
                    <span class="cl-name">{{ g.name != '' ? g.name : (translations.no_checklist ?? 'Sans checklist') }}</span>
                    {% if g.mandatory_pending > 0 %}<span class="cl-flag" title="{{ translations.mandatory_tasks ?? 'Tâches obligatoires' }}">{{ icons.svg('circle-alert') }}{{ g.mandatory_pending }}</span>{% endif %}
                    <span class="cl-count {{ g.done >= g.total ? 'all' : (g.done > 0 ? 'part' : '') }}">{{ g.done }}/{{ g.total }}</span>
                    <span class="cl-caret">{{ icons.svg('chevron-down') }}</span>
                </summary>
                <div class="cl-body">
                    {% for t in g.tasks %}{% include 'checklist/_task_item.twig' with { 't': t, 'hide_checklist': true } %}{% endfor %}
                </div>
            </details>
        {% endfor %}
    {% else %}
        <div class="empty-state"><span style="font-size:2rem;">{{ icons.svg('check-check') }}</span><p class="mt-2 mb-0">{{ translations.none_for_day ?? 'Aucune tâche pour ce jour.' }}</p></div>
    {% endif %}
</div>

{# Réalisation d'une tâche : photo, note et avis. #}
<div class="dn-modal" id="dnModal" hidden>
    <div class="bg" id="dnBg"></div>
    <div class="card">
        <div class="hd">
            <div class="ti" id="dnTitle"></div>
            <button type="button" class="x" id="dnClose" aria-label="{{ translations.close ?? 'Fermer' }}">✕</button>
        </div>
        <div class="who" id="dnWho"></div>
        <div class="ph" id="dnPhoto"></div>
        <a class="lnk" id="dnOpen" target="_blank" rel="noopener" hidden></a>
        <div id="dnExtra"></div>

        {# Évaluation par le consultant : note sur 5, conformité, commentaire. #}
        <div class="sect">{{ translations.modal_rate ?? 'Votre évaluation' }}</div>
        <div class="dn-stars" id="dnStars" role="radiogroup" aria-label="{{ translations.modal_rate ?? 'Votre évaluation' }}">
            {% for n in 1..5 %}
                <button type="button" class="st" data-n="{{ n }}" role="radio" aria-checked="false" aria-label="{{ n }}/5">★</button>
            {% endfor %}
            <span class="dn-clear" id="dnClear">{{ translations.modal_clear ?? 'effacer' }}</span>
        </div>
        <div class="dn-acc">
            <button type="button" class="ac ok" data-acc="1">{{ translations.modal_ok ?? 'Conforme' }}</button>
            <button type="button" class="ac no" data-acc="0">{{ translations.modal_ko ?? 'Non conforme' }}</button>
        </div>
        <textarea class="dn-cm" id="dnComment" rows="2"
                  placeholder="{{ translations.modal_comment ?? 'Commentaire (facultatif)' }}"></textarea>
        <button type="button" class="dn-save" id="dnSave">{{ translations.modal_save ?? 'Enregistrer l\'évaluation' }}</button>
        <div class="dn-msg" id="dnMsg" hidden></div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
const shopChecklistSkeleton = document.getElementById('shop-checklists-skeleton');
const shopChecklistContent = document.getElementById('shop-checklists-content');
if (shopChecklistSkeleton) shopChecklistSkeleton.style.display = 'none';
if (shopChecklistContent) shopChecklistContent.style.display = '';

/* Réalisation d'une tâche : photo + note + avis. L'URL signée de la pièce
   jointe est demandée AU CLIC — une par tâche au chargement de la page
   ferait autant d'appels pour des photos que personne n'ouvrira. */
(function () {
    var modal = document.getElementById('dnModal');
    if (!modal) { return; }
    var ROOT = window.__consultantRoot || '';
    var L = {
        note:    {{ (translations.modal_note ?? 'Note de la personne')|json_encode|raw }},
        noNote:  {{ (translations.modal_no_note ?? 'Aucune note laissée.')|json_encode|raw }},
        review:  {{ (translations.modal_review ?? 'Avis du consultant')|json_encode|raw }},
        loading: {{ (translations.modal_loading ?? 'Chargement de la photo…')|json_encode|raw }},
        failed:  {{ (translations.modal_failed ?? 'Photo indisponible.')|json_encode|raw }},
        open:    {{ (translations.modal_open ?? 'Ouvrir dans un nouvel onglet')|json_encode|raw }},
        saving:  {{ (translations.modal_saving ?? 'Enregistrement…')|json_encode|raw }},
        saved:   {{ (translations.modal_saved ?? 'Évaluation enregistrée.')|json_encode|raw }},
        needRate:{{ (translations.modal_need_rate ?? 'Choisissez une note de 1 à 5.')|json_encode|raw }}
    };
    var SHOP = {{ id_shop|default(0)|json_encode|raw }};
    var DATE = {{ (date ?? '')|json_encode|raw }};
    var current = null, rating = 0, accepted = null, openSeq = 0;

    function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function close() { modal.hidden = true; }

    function msg(text, ok) {
        var el = document.getElementById('dnMsg');
        if (!text) { el.hidden = true; el.textContent = ''; return; }
        el.hidden = false;
        el.className = 'dn-msg ' + (ok ? 'ok' : 'ko');
        el.textContent = text;
    }
    function setRating(n) {
        rating = n || 0;
        document.querySelectorAll('#dnStars .st').forEach(function (b) {
            var v = parseInt(b.getAttribute('data-n'), 10);
            b.classList.toggle('on', v <= rating);
            b.setAttribute('aria-checked', v === rating ? 'true' : 'false');
        });
    }
    function setAccepted(v) {
        accepted = v;
        document.querySelectorAll('.dn-acc .ac').forEach(function (b) {
            b.classList.toggle('on', accepted !== null && String(accepted ? 1 : 0) === b.getAttribute('data-acc'));
        });
    }

    function open(card) {
        var d;
        try { d = JSON.parse(card.getAttribute('data-done')); } catch (e) { return; }
        if (!d) { return; }

        document.getElementById('dnTitle').textContent = d.name || '';
        var who = (d.by ? d.by : '') + (d.at ? ' · ' + String(d.at).slice(0, 16).replace('T', ' ') : '');
        document.getElementById('dnWho').textContent = who;

        // La note est TOUJOURS affichée : sans encart, un champ vide côté API
        // ressemble à un bug d'affichage.
        var extra = '<div class="sect">' + esc(L.note) + '</div>'
            + (d.note ? '<div class="txt">' + esc(d.note) + '</div>'
                      : '<div class="txt empty">' + esc(L.noNote) + '</div>');
        document.getElementById('dnExtra').innerHTML = extra;

        // Évaluation existante rechargée dans le formulaire.
        current = d;
        setRating(d.rating != null ? parseInt(d.rating, 10) : 0);
        setAccepted(d.accepted == null ? null : (String(d.accepted) === '1' || d.accepted === true));
        document.getElementById('dnComment').value = d.comment || '';
        msg(null);

        var ph = document.getElementById('dnPhoto');
        // Le lien « ouvrir » est un élément UNIQUE, réutilisé : en créer un à
        // chaque ouverture les empilait sous la photo.
        var link = document.getElementById('dnOpen');
        link.hidden = true;
        link.removeAttribute('href');
        link.textContent = L.open;
        ph.innerHTML = '<div class="msg">' + esc(L.loading) + '</div>';
        modal.hidden = false;

        // Jeton d'ouverture : une réponse arrivée en retard ne doit pas écraser
        // la photo d'une tâche ouverte entre-temps.
        var token = ++openSeq;
        fetch(ROOT + '/helpdesk/attachments/' + encodeURIComponent(d.att) + '/url',
              { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (j) {
                if (token !== openSeq) { return; }
                var url = j && j.data && j.data.url;
                if (!url) { throw new Error('no url'); }
                ph.innerHTML = '<img src="' + esc(url) + '" alt="' + esc(d.file || d.name) + '" loading="lazy">';
                link.href = url;
                link.hidden = false;
            })
            .catch(function () {
                if (token !== openSeq) { return; }
                ph.innerHTML = '<div class="msg">' + esc(L.failed) + '</div>';
            });
    }

    // ── Évaluation : étoiles, conformité, enregistrement ──
    document.querySelectorAll('#dnStars .st').forEach(function (b) {
        b.addEventListener('click', function () { setRating(parseInt(b.getAttribute('data-n'), 10)); msg(null); });
    });
    document.getElementById('dnClear').addEventListener('click', function () { setRating(0); setAccepted(null); msg(null); });
    document.querySelectorAll('.dn-acc .ac').forEach(function (b) {
        b.addEventListener('click', function () {
            var v = b.getAttribute('data-acc') === '1';
            setAccepted(accepted === v ? null : v);   // re-clic = on retire le choix
            msg(null);
        });
    });
    document.getElementById('dnSave').addEventListener('click', function () {
        if (!current) { return; }
        if (!rating) { msg(L.needRate, false); return; }
        var btn = this;
        var comment = document.getElementById('dnComment').value || null;
        btn.disabled = true;
        msg(L.saving, true);
        fetch(ROOT + '/checklists/reviews', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            // checklist_id, task_id et review_date sont EXIGÉS par
            // ChecklistService::submitTaskReview avant tout appel à l'API.
            // Les variantes review_* accompagnent les champs d'évaluation :
            // l'API expose ces noms-là en lecture.
            body: JSON.stringify({
                shop_id:            SHOP,
                checklist_id:       current.checklist_id,
                task_id:            current.task_id,
                review_date:        DATE,
                completion_id:      current.completion_id,
                rating:             rating,
                review_rating:      rating,
                comment:            comment,
                review_comment:     comment,
                is_accepted:        accepted === null ? true : accepted,
                review_is_accepted: accepted === null ? true : accepted
            })
        })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
            .then(function (p) {
                if (!p.ok || !(p.j && p.j.success)) {
                    // Message du backend affiché tel quel, avec le corps de sa
                    // réponse : si le format attendu diffère, on lit lequel au
                    // lieu de le deviner.
                    var j = p.j || {};
                    var txt = (typeof j.error === 'string' && j.error) ? j.error : 'Erreur';
                    // code 0 = la requête n'a pas abouti : c'est le motif de
                    // transport qui explique, pas le statut ni le corps.
                    txt += ' (HTTP ' + (j.code == null ? '?' : j.code) + ')';
                    if (j.transport) { txt += ' — ' + j.transport; }
                    // Corps de la réponse de l'API, décodé ou brut : c'est là
                    // que se trouve le nom des champs manquants.
                    var body = j.detail ? JSON.stringify(j.detail) : (j.raw || '');
                    if (body) { txt += ' — ' + body; }
                    if (j.sent) { txt += ' | envoyé : ' + j.sent.join(', '); }
                    throw new Error(txt);
                }
                msg(L.saved, true);
                current.rating = rating;
                current.comment = comment;
                current.accepted = accepted;
            })
            .catch(function (e) { msg(String(e.message || e), false); })
            .then(function () { btn.disabled = false; });
    });

    document.addEventListener('click', function (e) {
        var card = e.target.closest && e.target.closest('.task-openable[data-done]');
        if (card) { open(card); }
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) { close(); return; }
        if (e.key === 'Enter' && e.target.closest) {
            var card = e.target.closest('.task-openable[data-done]');
            if (card) { open(card); }
        }
    });
    document.getElementById('dnBg').addEventListener('click', close);
    document.getElementById('dnClose').addEventListener('click', close);
})();
</script>
{% endblock %}
