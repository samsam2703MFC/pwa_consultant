{% extends "layouts/mobile_base.twig" %}

{#
  « Mes tâches réseau » — les tâches confiées au consultant par la direction.

  Elles vivent dans le back office CEO. Le consultant n'avait aucune vue
  dessus : la direction créait la tâche, cochait « rendue » en son nom, puis la
  notait. Le seul geste rendu ici est celui qui manquait — annoncer soi-même la
  remise, et y joindre un mot. La note reste à la direction.
#}

{% block title %}{{ translations.network_tasks ?? 'Mes tâches réseau' }} — Consultant Panel{% endblock %}
{% block page_title %}{{ translations.network_tasks ?? 'Mes tâches réseau' }}{% endblock %}
{% block page_subtitle %}{{ translations.network_tasks_sub ?? 'Confiées par la direction' }}{% endblock %}

{% block head %}
<style>
    .nt-sum { display:flex; gap:8px; margin-bottom:14px; }
    .nt-sum .c { flex:1; background:#fff; border-radius:14px; padding:10px 12px;
                 box-shadow:0 2px 10px rgba(0,0,0,.06); }
    .nt-sum .c b { display:block; font-size:1.35rem; line-height:1.1; }
    .nt-sum .c span { font-size:.62rem; text-transform:uppercase; letter-spacing:.05em;
                      color:#7a7168; font-weight:800; }

    .nt-grp { margin-bottom:16px; }
    .nt-grp > h2 { display:flex; align-items:center; gap:7px; font-size:.64rem; font-weight:800;
                   text-transform:uppercase; letter-spacing:.07em; margin:0 0 7px 2px; }
    .nt-grp > h2 i { width:7px; height:7px; border-radius:50%; }
    .nt-grp > h2 em { font-style:normal; color:#9a9086; font-weight:700; }

    .nt-card { background:#fff; border-radius:14px; padding:12px 13px; margin-bottom:8px;
               box-shadow:0 2px 10px rgba(0,0,0,.06); }
    .nt-card .t1 { font-size:.86rem; font-weight:800; color:#241f1c; line-height:1.3; }
    .nt-card .t2 { font-size:.7rem; color:#7a7168; margin-top:2px; }
    .nt-card .att { font-size:.74rem; color:#4a433d; line-height:1.5; background:#faf7f2;
                    border-radius:9px; padding:8px 10px; margin-top:8px; }
    .nt-meta { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:7px; }
    .nt-chip { font-size:.62rem; font-weight:800; border-radius:999px; padding:2px 8px; white-space:nowrap; }
    .nt-chip.due { background:#f1ece4; color:#5f574f; }
    .nt-chip.late { background:rgba(141,29,44,.10); color:#8D1D2C; }
    .nt-chip.wait { background:rgba(67,94,190,.10); color:#435ebe; }
    .nt-chip.mine { background:rgba(45,122,62,.10); color:#2D7A3E; }

    .nt-lv { display:inline-flex; align-items:center; gap:5px; font-size:.64rem; font-weight:800;
             border-radius:999px; padding:2px 9px 2px 3px; }
    .nt-lv i { width:16px; height:16px; border-radius:50%; color:#fff; font-style:normal;
               font-size:.58rem; display:flex; align-items:center; justify-content:center; }

    .nt-form { margin-top:9px; }
    .nt-form textarea { width:100%; border:1.5px solid #e7ded2; border-radius:10px; padding:8px 10px;
                        font-size:.78rem; font-family:inherit; resize:vertical; }
    .nt-act { display:flex; gap:6px; margin-top:7px; }
    .nt-act button { flex:1; border:0; border-radius:999px; padding:9px; font-size:.76rem;
                     font-weight:800; cursor:pointer; }
    .nt-act .go { background:#8D1D2C; color:#fff; }
    .nt-act .undo { flex:0 0 auto; padding:9px 14px; background:#fff; color:#7a7168;
                    border:1.5px solid #e7ded2; }
    .nt-msg { font-size:.7rem; border-radius:9px; padding:7px 9px; margin-top:7px; }
    .nt-msg.ok { background:rgba(45,122,62,.1); color:#2D7A3E; }
    .nt-msg.ko { background:rgba(192,24,43,.1); color:#c0182b; }
    .nt-empty { background:#fff; border-radius:14px; padding:20px 16px; text-align:center;
                font-size:.78rem; color:#7a7168; line-height:1.6; box-shadow:0 2px 10px rgba(0,0,0,.06); }
</style>
{% endblock %}

{% block content %}
{% set niveaux = {
    5: {'nom': 'Exemplaire',              'c': '#C9A227'},
    4: {'nom': 'Conforme',                'c': '#2D7A3E'},
    3: {'nom': 'Non conforme — mineur',   'c': '#D97706'},
    2: {'nom': 'Non conforme — majeur',   'c': '#C0182B'},
    1: {'nom': 'Non conforme — critique', 'c': '#8D1D2C'}
} %}

{% if not identifie %}
    <div class="nt-empty">
        Votre session ne porte pas d'identifiant consultant.<br>
        Reconnectez-vous depuis l'ERP pour voir vos tâches.
    </div>
{% elseif not cockpit_ok %}
    {# Écran vide pour deux raisons très différentes : le dire évite de faire
       chercher une panne qui n'existe pas. #}
    <div class="nt-empty">
        Les tâches réseau ne sont pas disponibles sur cette installation.<br>
        <span style="color:#9a9086">Le back office n'est pas branché sur cette base.</span>
    </div>
{% elseif groupes is empty %}
    <div class="nt-empty">
        Aucune tâche réseau ne vous est confiée pour l'instant.
    </div>
{% else %}
    <div class="nt-sum">
        <div class="c"><b style="color:{{ compteurs.retard > 0 ? '#8D1D2C' : '#241f1c' }}">{{ compteurs.a_faire }}</b><span>À faire</span></div>
        <div class="c"><b style="color:#435ebe">{{ compteurs.attente }}</b><span>En attente</span></div>
        <div class="c"><b style="color:#2D7A3E">{{ compteurs.evaluees }}</b><span>Évaluées</span></div>
    </div>

    {% for g in groupes %}
        <div class="nt-grp">
            <h2 style="color:{{ g.couleur }}"><i style="background:{{ g.couleur }}"></i>{{ g.titre }} <em>{{ g.n }}</em></h2>

            {% for t in g.items %}
                <div class="nt-card" data-task="{{ t.id }}">
                    <div class="t1">{{ t.nom }}</div>
                    <div class="t2">{{ t.projet }}</div>

                    {% if t.attendu %}<div class="att">{{ t.attendu }}</div>{% endif %}

                    <div class="nt-meta">
                        {% if t.note is not null %}
                            {% set n = niveaux[t.note] %}
                            <span class="nt-lv" style="background:{{ n.c }}1f;color:{{ n.c }}">
                                <i style="background:{{ n.c }}">{{ t.note }}</i>{{ n.nom }}
                            </span>
                            {% if t.evaluee_par %}<span class="nt-chip due">par {{ t.evaluee_par }}</span>{% endif %}
                        {% elseif t.rendue %}
                            <span class="nt-chip wait">{{ t.annoncee ? 'Annoncée le ' ~ t.rendue_le : 'Cochée par la direction' }}</span>
                        {% elseif t.en_retard %}
                            <span class="nt-chip late">En retard de {{ -t.jours }} jour{{ -t.jours > 1 ? 's' : '' }}</span>
                        {% else %}
                            <span class="nt-chip due">Pour le {{ t.echeance }}{% if t.jours is not null %} · {{ t.jours }} j{% endif %}</span>
                        {% endif %}
                        {% if t.annoncee and t.note is null %}<span class="nt-chip mine">annoncée par vous</span>{% endif %}
                    </div>

                    {% if t.mot %}<div class="att" style="background:#fdfaf6">« {{ t.mot }} »</div>{% endif %}

                    {% if t.note is null %}
                        <div class="nt-form">
                            {% if not t.rendue %}
                                <textarea rows="2" placeholder="{{ translations.delivery_note ?? 'Un mot sur ce que vous remettez (facultatif)' }}"></textarea>
                                <div class="nt-act">
                                    <button type="button" class="go" data-do="remise">{{ translations.declare_delivery ?? 'Annoncer la remise' }}</button>
                                </div>
                            {% else %}
                                <div class="nt-act">
                                    <button type="button" class="undo" data-do="annuler">{{ translations.undo_delivery ?? 'Annuler la remise' }}</button>
                                </div>
                            {% endif %}
                            <div class="nt-msg" hidden></div>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endif %}
{% endblock %}

{% block scripts %}
<script>
(function () {
    'use strict';
    var ROOT = {{ ROOT|default('')|json_encode|raw }};

    // Un seul écouteur pour tout l'écran : les cartes sont nombreuses et
    // rechargées après chaque geste.
    document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-do]');
        if (!b) { return; }
        var carte = b.closest('.nt-card');
        if (!carte) { return; }

        var quoi = b.getAttribute('data-do');
        var msg  = carte.querySelector('.nt-msg');
        var zone = carte.querySelector('textarea');
        var fd   = new FormData();
        fd.append('task_id', carte.getAttribute('data-task'));
        if (zone) { fd.append('mot', zone.value); }

        b.disabled = true;
        fetch(ROOT + '/mes-taches-reseau/' + (quoi === 'remise' ? 'remise' : 'annuler'), {
            method: 'POST', body: fd, credentials: 'same-origin'
        }).then(function (r) {
            return r.json().catch(function () { return { ok: false, message: 'réponse illisible' }; });
        }).then(function (j) {
            if (msg) {
                msg.hidden = false;
                msg.className = 'nt-msg ' + (j.ok ? 'ok' : 'ko');
                msg.textContent = j.message || (j.ok ? 'Enregistré' : 'Échec');
            }
            // On recharge : l'état de la tâche change de groupe, et le recalculer
            // ici finirait par diverger de ce que le serveur a réellement gardé.
            if (j.ok) { setTimeout(function () { location.reload(); }, 700); }
            else { b.disabled = false; }
        }).catch(function (err) {
            if (msg) {
                msg.hidden = false;
                msg.className = 'nt-msg ko';
                msg.textContent = 'Envoi impossible — ' + err.message;
            }
            b.disabled = false;
        });
    });
})();
</script>
{% endblock %}
