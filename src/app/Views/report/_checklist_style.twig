{# Styles communs aux deux rapports Checklist Tâches (hebdo + mensuel).
   Repris de report/view.twig — même charte, mêmes tailles, même impression. #}
<style>
    .ck { max-width:820px; margin:0 auto; color:#212529; }

    .ck-head { border-bottom:2px solid #8D1D2C; padding-bottom:10px; margin-bottom:16px; }
    .ck-kicker { font-size:.64rem; font-weight:800; letter-spacing:.09em; text-transform:uppercase;
                 color:#8D1D2C; background:rgba(141,29,44,.08); display:inline-block;
                 padding:3px 9px; border-radius:999px; margin-bottom:7px; }
    .ck-title { font-size:1.22rem; font-weight:800; color:#8D1D2C; margin:0 0 7px; }
    .ck-meta { display:flex; flex-wrap:wrap; gap:3px 18px; font-size:.78rem; color:#495057; }
    .ck-meta b { color:#241f1c; font-weight:700; }
    .ck-chips { display:flex; flex-wrap:wrap; gap:5px; margin-top:9px; }
    .ck-chip { font-size:.68rem; font-weight:700; padding:3px 9px; border-radius:999px;
               background:#F2C9A0; color:#6b3410; }

    .ck-sec { margin-top:20px; }
    .ck-sec-h { font-size:.7rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase;
                color:#6c757d; margin:0 0 9px; display:flex; align-items:center; gap:7px; }
    .ck-sec-h::after { content:""; flex:1; height:1px; background:rgba(0,0,0,.09); }

    .ck-kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:9px; }
    .ck-kpis.k4 { grid-template-columns:repeat(4,1fr); }
    .ck-kpi { border:1px solid rgba(0,0,0,.09); border-radius:12px; padding:10px 11px;
              background:#fff; position:relative; overflow:hidden; }
    .ck-kpi::before { content:""; position:absolute; left:0; top:0; bottom:0; width:3px; background:#8D1D2C; }
    .ck-kpi.k-ok::before  { background:#1f9d55; }
    .ck-kpi.k-mid::before { background:#e08e0b; }
    .ck-kpi.k-ko::before  { background:#c0392b; }
    .ck-kpi-v { font-size:1.32rem; font-weight:800; line-height:1.05; }
    .ck-kpi-l { font-size:.68rem; color:#6c757d; margin-top:3px; line-height:1.25; }
    .ck-kpi-sub { font-size:.66rem; color:#6c757d; margin-top:5px; padding-top:5px;
                  border-top:1px dashed rgba(0,0,0,.09); }
    .ck-kpi-sub b { color:#241f1c; }
    .ck-trend { font-size:.68rem; font-weight:800; margin-left:5px; }
    .ck-t-up { color:#1f9d55; } .ck-t-dn { color:#c0392b; } .ck-t-fl { color:#6c757d; }

    .ck-days { display:grid; grid-template-columns:repeat(6,1fr); gap:7px; }
    .ck-day { border:1px solid rgba(0,0,0,.09); border-radius:11px; padding:8px 5px;
              text-align:center; background:#fff; border-top:3px solid rgba(0,0,0,.09); }
    .ck-day.d-ok  { border-top-color:#1f9d55; } .ck-day.d-ok .ck-day-p  { color:#1f9d55; }
    .ck-day.d-mid { border-top-color:#e08e0b; } .ck-day.d-mid .ck-day-p { color:#e08e0b; }
    .ck-day.d-ko  { border-top-color:#c0392b; } .ck-day.d-ko .ck-day-p  { color:#c0392b; }
    .ck-day-n { font-size:.66rem; font-weight:800; text-transform:uppercase; letter-spacing:.04em; color:#6c757d; }
    .ck-day-d { font-size:.6rem; color:#a2988c; margin-bottom:5px; }
    .ck-day-p { font-size:1.02rem; font-weight:800; line-height:1.1; }
    .ck-day-c { font-size:.62rem; color:#6c757d; margin-top:2px; }
    .ck-day-nc { font-size:.62rem; font-weight:800; margin-top:4px; padding-top:4px;
                 border-top:1px solid #f3efe9; color:#c0392b; }
    .ck-day-nc.zero { color:#1f9d55; }

    .ck-tw { overflow-x:auto; -webkit-overflow-scrolling:touch; border:1px solid rgba(0,0,0,.09); border-radius:12px; }
    .ck-tbl { width:100%; border-collapse:collapse; font-size:.78rem; }
    .ck-tbl th { background:#8D1D2C; color:#fff; text-align:left; padding:7px 9px; font-size:.66rem;
                 text-transform:uppercase; letter-spacing:.04em; font-weight:700; white-space:nowrap; }
    .ck-tbl td { padding:7px 9px; border-top:1px solid rgba(0,0,0,.09); vertical-align:middle; }
    .ck-tbl td.num, .ck-tbl th.num { text-align:center; white-space:nowrap; }
    .ck-tbl tr.tot td { background:#faf7f3; font-weight:800; border-top:2px solid #241f1c; }
    .ck-pill { display:inline-block; font-size:.7rem; font-weight:800; padding:2px 8px;
               border-radius:999px; min-width:52px; text-align:center; }
    .ck-p-ok  { background:rgba(31,157,85,.13); color:#14663a; }
    .ck-p-mid { background:rgba(224,142,11,.15); color:#8a5806; }
    .ck-p-ko  { background:rgba(192,57,43,.13); color:#8f2318; }
    .ck-p-na  { background:rgba(0,0,0,.05); color:#8a827a; }

    /* Non-conformités dépliables. La zone cliquable fait 44 px de haut :
       elle est manipulée au pouce sur un téléphone, en boutique. */
    .ck-nc-toggle { cursor:pointer; font-size:.72rem; font-weight:700; color:#8D1D2C;
                    display:inline-flex; align-items:center; gap:5px; min-height:44px;
                    list-style:none; -webkit-tap-highlight-color:transparent; }
    .ck-nc-toggle::-webkit-details-marker { display:none; }
    .ck-nc-toggle .car { transition:transform .15s; }
    details[open] > .ck-nc-toggle .car { transform:rotate(90deg); }
    .ck-nc-list { margin:4px 0 2px; padding:0; list-style:none; }
    .ck-nc-item { display:flex; align-items:flex-start; gap:8px; padding:6px 9px;
                  border-radius:9px; background:#faf7f3; margin-bottom:5px; }
    .ck-sev { font-size:.6rem; font-weight:800; padding:2px 7px; border-radius:999px;
              white-space:nowrap; flex-shrink:0; margin-top:1px; }
    .ck-sev-maj { background:rgba(192,57,43,.14); color:#8f2318; }
    .ck-sev-min { background:rgba(224,142,11,.16); color:#8a5806; }
    .ck-sev-lift { background:rgba(31,157,85,.14); color:#14663a; }
    .ck-nc-txt { font-size:.74rem; min-width:0; flex:1; }
    .ck-nc-rate { font-size:.66rem; font-weight:800; color:#b8860b; white-space:nowrap;
                  flex-shrink:0; margin-top:1px; }

    /* Constats terrain : photo, titre, puis le commentaire du consultant sur
       DEUX lignes. Une seule ligne coupait la phrase au tiers sur téléphone. */
    .ck-feed { display:flex; flex-direction:column; gap:8px; }
    .ck-fd { display:flex; align-items:flex-start; gap:10px; padding:9px 11px 9px 9px; background:#fff;
             border:1px solid rgba(0,0,0,.09); border-left:4px solid #6c757d; border-radius:11px; }
    .ck-fd.f-maj  { border-left-color:#c0392b; }
    .ck-fd.f-min  { border-left-color:#e08e0b; }
    .ck-fd.f-lift { border-left-color:#1f9d55; }
    .ck-fd-img { width:52px; height:52px; border-radius:9px; flex-shrink:0; object-fit:cover;
                 background:#efe9e1; border:none; padding:0; cursor:pointer; }
    .ck-fd-img[disabled] { cursor:default; }
    .ck-fd-b { flex:1; min-width:0; }
    .ck-fd-t { font-size:.8rem; font-weight:700; line-height:1.25; }
    .ck-fd-m { display:flex; align-items:center; gap:7px; margin-top:2px; font-size:.66rem;
               color:#6c757d; flex-wrap:wrap; }
    .ck-fd-c { font-size:.7rem; color:#57504a; margin-top:3px; font-style:italic; line-height:1.35;
               display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .ck-stars { flex-shrink:0; font-size:.72rem; letter-spacing:.5px; color:#d8cfc4; margin-top:2px; }
    .ck-stars b { color:#e0a11b; font-weight:400; }

    .ck-bars { border:1px solid rgba(0,0,0,.09); border-radius:13px; overflow:hidden; background:#fff; }
    .ck-bar-row { display:flex; align-items:center; gap:10px; padding:9px 11px; }
    .ck-bar-row + .ck-bar-row { border-top:1px solid #f3efe9; }
    .ck-bar-n { flex:1; min-width:0; font-size:.74rem; font-weight:800; text-transform:uppercase;
                letter-spacing:.02em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .ck-bar { width:88px; height:7px; border-radius:99px; background:#f0ebe4; overflow:hidden; flex-shrink:0; }
    .ck-bar i { display:block; height:100%; border-radius:99px; }
    .ck-bar-v { font-size:.78rem; font-weight:800; width:48px; text-align:right; flex-shrink:0; }

    .ck-note { font-size:.68rem; color:#8a827a; margin-top:9px; font-style:italic; }
    .ck-legend { display:flex; flex-wrap:wrap; gap:4px 14px; margin-top:8px; font-size:.65rem; color:#6c757d; }
    .ck-legend i { width:9px; height:9px; border-radius:3px; display:inline-block; margin-right:4px; }
    .ck-empty { font-size:.78rem; color:#8a827a; padding:14px; text-align:center;
                border:1px dashed rgba(0,0,0,.12); border-radius:12px; }

    /* Ossature d'impression. Le bandeau de rappel doit revenir en haut de
       CHAQUE feuille : un `thead` est le seul mécanisme que le navigateur
       recopie en réservant la place — un élément `position:fixed` se recopie
       aussi mais chevauche le texte. À l'écran, le tableau est déplié en
       blocs et le bandeau masqué : rien ne change. */
    .ck-sheet, .ck-sheet > tbody, .ck-sheet > tbody > tr,
    .ck-sheet > tbody > tr > td { display:block; }
    .ck-sheet > thead { display:none; }
    .ck-runhead { display:none; }
    /* Le navigateur donne 1 px de remplissage à toute cellule : sans cette
       règle, l'ossature décale le rapport d'un pixel et lui retire deux
       pixels de large. Le sélecteur descend en ligne directe — `.ck-sheet td`
       toucherait aussi les cellules des tableaux du rapport, qui perdraient
       leur propre remplissage. */
    .ck-sheet { border-spacing:0; width:100%; }
    .ck-sheet > thead > tr > td, .ck-sheet > tbody > tr > td { padding:0; }

    /* Navigation de période : cibles au pouce, comme le reste de l'app. */
    .ck-nav { display:flex; align-items:center; gap:8px; margin-bottom:12px; }
    .ck-nav a, .ck-nav span.cur { min-height:44px; display:inline-flex; align-items:center;
        padding:0 14px; border-radius:999px; font-size:.78rem; font-weight:700; text-decoration:none; }
    .ck-nav a { background:#fff; border:1px solid rgba(141,29,44,.2); color:#8D1D2C; }
    .ck-nav span.cur { flex:1; justify-content:center; color:#6c757d; }

    @media (max-width:520px) {
        .ck-kpis, .ck-kpis.k4 { grid-template-columns:repeat(2,1fr); }
        .ck-days { grid-template-columns:repeat(3,1fr); }
    }

    /* ── Impression / « Enregistrer en PDF » ──────────────────────────────
       Le rapport finit en PDF chez le franchisé : une feuille A4 est un
       format fixe, pas une fenêtre qu'on fait défiler. Masquer la navigation
       ne suffit donc pas — il faut aussi une échelle typographique en points,
       des coupures de page choisies, et un rappel de l'identité du rapport
       sur chaque feuille.
       Les classes masquées sont celles du gabarit mobile_base — les mêmes que
       le rapport de gestion. Les avoir devinées laissait la barre de
       navigation et la barre d'onglets sur le papier. */
    @media print {
        /* Format déclaré : sans `size`, la feuille est celle de l'imprimante
           et les marges celles du navigateur — trois rendus pour trois
           postes. 184 mm de colonne utile. */
        @page { size:A4 portrait; margin:12mm 13mm; }

        .app-topbar, .app-tabbar-bar, .app-nav-sheet, .app-nav-backdrop,
        .app-back-btn, #nav-progress, #pwa-banner, #pwa-ios-tip,
        .ck-noprint { display:none !important; }
        body { background:#fff !important; orphans:3; widows:3; }
        main.app-content, .app-content { padding:0 !important; }
        a[href] { color:inherit; text-decoration:none; }

        /* Tout le rapport est dimensionné en rem : redéfinir la racine le met
           à l'échelle du papier d'un seul geste. L'écran part de 16 px, soit
           12 pt, pour une colonne de 820 px ; la colonne A4 en fait 184 mm,
           soit 696 px — 15 % de moins. Même nombre de signes par ligne. */
        html { font-size:10.5pt; }
        .ck { max-width:none; margin:0; }

        /* Bandeau répété en tête de feuille : à partir de la page 2,
           l'en-tête du rapport n'est plus là pour dire de quelle boutique et
           de quelle période il s'agit. */
        .ck-sheet { display:table !important; width:100%; }
        .ck-sheet > thead { display:table-header-group !important; }
        .ck-sheet > tbody { display:table-row-group; }
        .ck-sheet > thead > tr, .ck-sheet > tbody > tr { display:table-row; }
        .ck-sheet > thead > tr > td, .ck-sheet > tbody > tr > td {
            display:table-cell; padding:0; }
        .ck-runhead { display:flex !important; align-items:baseline; gap:9px;
            font-size:.6rem; color:#8a827a; padding-bottom:1.8mm; margin-bottom:4mm;
            border-bottom:.5pt solid rgba(0,0,0,.22); }
        .ck-runhead b { color:#8D1D2C; font-weight:800; text-transform:uppercase;
            letter-spacing:.04em; }
        .ck-runhead .sp { margin-left:auto; white-space:nowrap; }

        /* Un conteneur à défilement coupe ce qui dépasse au lieu de le
           reporter : sur papier il n'y a rien à faire défiler. Son cadre
           arrondi disparaît aussi — coupé en deux par un saut de page, il
           dessinait deux moitiés de boîte. Le tableau porte son propre filet. */
        .ck-tw { overflow:visible !important; border:0; border-radius:0; }
        .ck-tbl { width:100% !important; border:.5pt solid rgba(0,0,0,.18); }
        .ck-tbl th, .ck-tbl td { padding:1.5mm 2mm; }

        /* Ce qui n'a aucun sens coupé en deux reste insécable ; les SECTIONS,
           elles, coulent. Une section insécable saute à la feuille suivante
           dès qu'elle ne tient plus et laisse une demi-page blanche — c'est
           ce qui produisait une troisième feuille presque vide. */
        .ck-sec { break-inside:auto; margin-top:6mm; }
        .ck-sec-h, .ck-head { break-after:avoid; }

        /* L'écran laisse respirer parce qu'on fait défiler ; la feuille, elle,
           se paie à l'unité. Un interligne de constat plus serré, c'est une
           demi-feuille de moins sur un mois chargé. */
        .ck-feed { gap:5px; }
        .ck-fd { padding:6px 9px 6px 8px; }
        .ck-fd-img { width:44px; height:44px; }
        .ck-bar-row { padding:6px 11px; }
        .ck-kpi { padding:8px 10px; }
        .ck-kpis, .ck-days, .ck-kpi, .ck-day, .ck-fd, .ck-bar-row,
        .ck-nc-item, .ck-tbl tr { break-inside:avoid; }
        /* Les constats et les barres de conformité restent d'un seul tenant
           TANT QUE c'est possible : un constat seul en bas de feuille, ses
           onze frères au verso, se lit comme une section coupée en deux. Le
           navigateur ignore la règle quand le bloc dépasse la hauteur d'une
           feuille — il coupe alors, faute de mieux, et remplit les pages. Un
           tableau, lui, se coupe volontiers : ses lignes restent entières et
           son en-tête est répété. */
        .ck-feed, .ck-bars { break-inside:avoid; }
        .ck-tw { break-inside:auto; }
        thead { display:table-header-group; }   /* en-tête répété par page */

        /* Le détail des NC est replié à l'écran ; imprimé replié, le PDF
           envoyé au franchisé n'aurait que des compteurs. Le script l'ouvre
           avant impression, la règle couvre les navigateurs sans onbeforeprint. */
        details > .ck-nc-list { display:block !important; }
        .ck-nc-toggle { min-height:0; }

        /* Le commentaire du consultant est tronqué à deux lignes à l'écran
           pour que les cartes restent alignées. Sur papier, la phrase coupée
           est perdue pour de bon : on la donne en entier. */
        .ck-fd-c { display:block; -webkit-line-clamp:none; overflow:visible; }

        /* Les pastilles et les barres gardent leurs couleurs sur papier :
           sans cela, vert et rouge deviennent deux gris identiques. */
        .ck, .ck * { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
    }
</style>
