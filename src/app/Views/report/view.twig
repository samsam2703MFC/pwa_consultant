{% extends "layouts/mobile_base.twig" %}
{% import "components/_icons.twig" as icons %}
{% set active_nav = 'reports' %}

{% block title %}{{ translations.title ?? 'Rapport' }} — Consultant Panel{% endblock %}
{% block page_title %}{{ translations.title ?? 'Rapport' }}{% endblock %}
{% block page_subtitle %}{{ report.type_label ?? '' }}{% endblock %}

{% block head %}
<style>
    .rpt { max-width:820px; margin:0 auto; color:#212529; }
    .rpt-head { border-bottom:2px solid #8D1D2C; padding-bottom:10px; margin-bottom:16px; }
    .rpt-title { font-size:1.25rem; font-weight:800; color:#8D1D2C; margin:0 0 6px; }
    .rpt-meta { display:flex; flex-wrap:wrap; gap:4px 18px; font-size:.8rem; color:#495057; }
    .rpt-meta b { color:#212529; font-weight:700; }

    .rpt-shop { margin:0 0 22px; border:1px solid rgba(0,0,0,.1); border-radius:14px; overflow:hidden; }
    .rpt-shop-name { background:rgba(141,29,44,.08); color:#8D1D2C; font-weight:800; font-size:.98rem; padding:10px 14px; }
    .rpt-shop-body { padding:12px 14px; }

    .rpt-sec { margin-top:14px; }
    .rpt-sec:first-child { margin-top:0; }
    .rpt-sec-h { font-size:.72rem; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:#6c757d; margin:0 0 8px; display:flex; align-items:center; gap:6px; }

    .rpt-kpis { display:flex; flex-wrap:wrap; gap:10px; }
    .rpt-kpi { flex:1; min-width:120px; background:#fff; border:1px solid rgba(0,0,0,.08); border-radius:12px; padding:10px 12px; }
    .rpt-kpi-v { font-size:1.15rem; font-weight:800; color:#212529; line-height:1.1; }
    .rpt-kpi-l { font-size:.72rem; color:#6c757d; margin-top:3px; }

    /* Leviers HEXm : une seule carte, lignes séparées par un filet (mêmes
       identité/couleurs officielles que l'écran HEXm). */
    .rpt-hexm { margin-top:14px; background:#fff; border:1px solid rgba(0,0,0,.09); border-radius:14px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.04); }
    .rpt-lev { display:flex; align-items:center; gap:11px; padding:11px 14px; }
    .rpt-lev + .rpt-lev { border-top:1px solid #f2ede5; }
    .rpt-lev--soon { background:#fcfbf9; }
    .rpt-lev-badge { width:26px; height:26px; border-radius:8px; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:#fff; font-size:.8rem; font-weight:800; }
    .rpt-lev-nm { flex:1; min-width:0; font-size:.74rem; font-weight:800; text-transform:uppercase; letter-spacing:.02em; color:#241f1c; }
    .rpt-lev--soon .rpt-lev-nm { color:#8a827a; }
    .rpt-lev-kpis { flex-shrink:0; display:flex; flex-direction:column; align-items:flex-end; gap:5px; }
    .rpt-lev-kpi { text-align:right; line-height:1.2; }
    .rpt-lev-kpi i { display:block; color:#7a7168; font-style:normal; font-size:.66rem; }
    .rpt-lev-kpi b { color:#241f1c; font-weight:800; font-size:.86rem; }
    .rpt-lev-soon { font-size:.72rem; color:#b8b0a6; font-style:italic; }
    /* Statut ✓ bon / ⚠ attention / ● danger vs moyenne réseau (comme HEXm). */
    .rpt-lev-st { flex-shrink:0; width:18px; text-align:center; font-size:.9rem; font-weight:900; line-height:1; }
    .rpt-v-ok, .rpt-lev.rpt-st-ok .rpt-lev-st   { color:#2D7A3E; }
    .rpt-v-mid, .rpt-lev.rpt-st-mid .rpt-lev-st { color:#e67e22; }
    .rpt-v-bad, .rpt-lev.rpt-st-bad .rpt-lev-st { color:#c0182b; }
    .rpt-hexm-legend { display:flex; flex-wrap:wrap; gap:4px 12px; margin-top:7px; font-size:.66rem; color:#7a7168; }
    .rpt-hexm-legend .rpt-st-ok { color:#2D7A3E; } .rpt-hexm-legend .rpt-st-mid { color:#e67e22; } .rpt-hexm-legend .rpt-st-bad { color:#c0182b; }

    .rpt-tbl-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
    .rpt-tbl { width:100%; border-collapse:collapse; font-size:.82rem; }
    .rpt-tbl th, .rpt-tbl td { text-align:left; padding:6px 8px; border-bottom:1px solid rgba(0,0,0,.07); }
    .rpt-tbl th { font-size:.7rem; text-transform:uppercase; letter-spacing:.03em; color:#6c757d; font-weight:700; }
    .rpt-tbl td.num, .rpt-tbl th.num { text-align:center; white-space:nowrap; }
    /* Tableau franchisé sur DEUX lignes par indicateur : les DONNÉES
       (N-1, réalisé, cible) puis les POURCENTAGES (évolution vs N-1,
       niveau vs objectif). Le libellé est fusionné sur les deux lignes. */
    .rpt-cell-main { font-weight:800; }
    .rpt-up { color:#2D7A3E; } .rpt-down { color:#c0182b; }
    .rpt-fr-data td { border-bottom:0; padding-bottom:1px; }
    .rpt-fr-label { border-bottom:1px solid rgba(0,0,0,.07); vertical-align:middle; font-weight:700; }
    .rpt-fr-pct td { border-bottom:1px solid rgba(0,0,0,.07); padding-top:0; font-size:.72rem; font-weight:700; }
    .rpt-fr-dash { color:#adb5bd; }

    .rpt-note { border-left:3px solid rgba(141,29,44,.25); padding:2px 0 2px 10px; margin-bottom:10px; }
    .rpt-note-meta { font-size:.72rem; color:#8D1D2C; font-weight:700; }
    .rpt-note-text { font-size:.85rem; color:#333; margin:2px 0 0; white-space:pre-wrap; word-break:break-word; }
    .rpt-thumbs { display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
    .rpt-thumb { width:64px; height:64px; object-fit:cover; border-radius:8px; border:1px solid rgba(0,0,0,.1); }

    /* Commentaires (filles) sous une note (mère). */
    .rpt-replies { margin:7px 0 0 6px; padding-left:11px; border-left:2px solid #ece3d8; display:flex; flex-direction:column; gap:8px; }
    .rpt-reply-meta { font-size:.68rem; font-weight:700; color:#7a7168; }
    .rpt-reply-text { font-size:.8rem; color:#333; margin:1px 0 0; white-space:pre-wrap; word-break:break-word; }

    /* Campagnes commerciales : CA réalisé vs target (barre) + leads/conversion. */
    .rpt-camp { border:1px solid rgba(0,0,0,.08); border-radius:12px; padding:9px 11px; margin-bottom:8px; }
    .rpt-camp-h { display:flex; align-items:baseline; gap:8px; }
    .rpt-camp-nm { font-weight:800; font-size:.85rem; color:#212529; }
    .rpt-camp-type { font-size:.6rem; font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:#7a7168; }
    .rpt-camp-pct { margin-left:auto; font-weight:800; font-size:.85rem; }
    .rpt-camp-bar { height:8px; border-radius:5px; background:#f0e9df; margin:6px 0 4px; position:relative; overflow:hidden; }
    .rpt-camp-bar i { position:absolute; left:0; top:0; bottom:0; border-radius:5px; }
    .rpt-fill-ok { background:#2D7A3E; } .rpt-fill-mid { background:#e67e22; } .rpt-fill-bad { background:#c0182b; } .rpt-fill-nd { background:#cfc7bb; }
    .rpt-camp-meta { font-size:.72rem; color:#7a7168; }
    .rpt-camp-meta b { color:#241f1c; font-weight:800; }

    .rpt-supplier { font-weight:800; font-size:.82rem; color:#212529; margin:8px 0 3px; }
    .rpt-empty { font-size:.82rem; color:#adb5bd; font-style:italic; }
    .rpt-badge { display:inline-block; font-size:.66rem; font-weight:700; border-radius:8px; padding:1px 7px; background:rgba(67,94,190,.12); color:#435ebe; }

    .rpt-actions { display:flex; gap:10px; margin-bottom:16px; }

    /* ── Vue RÉSEAU « toutes les boutiques » : 3 onglets (toggle) ── */
    .rpt-tabs { display:flex; gap:5px; margin-bottom:14px; background:#f2ede5; border-radius:12px; padding:4px; }
    .rpt-tab { flex:1; border:0; background:transparent; border-radius:9px; padding:8px 6px; font-size:.72rem; font-weight:800; color:#7a7168; cursor:pointer; -webkit-tap-highlight-color:transparent; }
    .rpt-tab.is-active { background:#fff; color:#8D1D2C; box-shadow:0 1px 4px rgba(0,0,0,.10); }
    .rpt-tabview { margin-bottom:26px; }
    .rpt-tabview[hidden] { display:none; }
    .rpt-print-title { display:none; font-size:.95rem; font-weight:800; color:#8D1D2C; border-bottom:1px solid rgba(141,29,44,.2); padding-bottom:5px; margin:2px 0 12px; }
    /* Pastille de statut (carré arrondi lettré) */
    .rpt-dot { display:inline-flex; align-items:center; justify-content:center; width:20px; height:20px; border-radius:6px; color:#fff; font-size:.7rem; font-weight:900; }
    .rpt-dot.st-ok { background:#2D7A3E; } .rpt-dot.st-mid { background:#e67e22; } .rpt-dot.st-bad { background:#c0182b; } .rpt-dot.st-nd { background:#c9c2b8; }
    /* Heatmap boutiques × leviers */
    .rpt-heat { border-collapse:separate; border-spacing:3px; font-size:.72rem; }
    .rpt-heat th { font-size:.64rem; color:#6c757d; font-weight:800; padding:2px 3px; text-align:center; }
    .rpt-heat td.nm { text-align:left; font-weight:700; white-space:nowrap; padding-right:6px; font-size:.72rem; }
    .rpt-heat-cell { display:flex; align-items:center; justify-content:center; width:26px; height:22px; border-radius:5px; color:#fff; font-weight:800; }
    .rpt-heat-cell.st-ok { background:#2D7A3E; } .rpt-heat-cell.st-mid { background:#e67e22; } .rpt-heat-cell.st-bad { background:#c0182b; } .rpt-heat-cell.st-nd { background:#efe9e0; color:#c9c2b8; }
    /* Synthèse dirigeant */
    .rpt-syn-h { font-size:.74rem; font-weight:800; margin:14px 0 6px; }
    .rpt-syn-item { display:flex; gap:8px; align-items:baseline; font-size:.82rem; padding:3px 0; }
    .rpt-syn-item b { color:#212529; }
    .rpt-chip { flex-shrink:0; font-size:.66rem; font-weight:800; border-radius:8px; padding:2px 8px; background:rgba(141,29,44,.09); color:#8D1D2C; }
    /* Lettres des 6 leviers (T R E F L O) colorées par statut de la boutique. */
    .rpt-treflo { white-space:nowrap; margin-left:6px; }
    .rpt-treflo b { font-weight:900; font-size:.72rem; letter-spacing:.5px; margin-left:2px; }
    .rpt-treflo .tf-ok { color:#2D7A3E; } .rpt-treflo .tf-mid { color:#e67e22; } .rpt-treflo .tf-bad { color:#c0182b; } .rpt-treflo .tf-nd { color:#cfc7bb; }

    /* Impression / « Enregistrer en PDF » : on ne garde que le rapport. */
    @media print {
        .app-topbar, .app-tabbar-bar, .app-nav-sheet, .app-nav-backdrop,
        #nav-progress, #pwa-banner, #pwa-ios-tip, .rpt-noprint { display:none !important; }
        body { background:#fff !important; }
        main.app-content, .app-content { padding:0 !important; }
        .rpt-shop { break-inside:avoid; box-shadow:none; }
        a[href] { color:inherit; text-decoration:none; }
        /* À l'impression : on déplie les 3 onglets réseau et on titre chacun. */
        .rpt-tabview, .rpt-tabview[hidden] { display:block !important; break-inside:avoid; }
        .rpt-print-title { display:block !important; }
        @page { margin:14mm 12mm; }
    }
</style>
{% endblock %}

{% block content %}
<div class="page-content-loaded">

    <div class="rpt-actions rpt-noprint">
        <a href="{{ ROOT }}/reports" class="app-back-btn" style="margin-bottom:0;">
            {{ icons.svg('chevron-left', 16) }}<span>{{ translations.back ?? 'Rapports' }}</span>
        </a>
        <button type="button" onclick="window.print()" class="btn btn-primary rounded-pill px-3 fw-700 ms-auto" style="font-size:.82rem;">
            <span class="me-1">{{ icons.svg('download', 16) }}</span>{{ translations.print_pdf ?? 'Imprimer / PDF' }}
        </button>
    </div>

    {% if report.shops is not defined %}
        <div class="rpt-empty">{{ translations.no_data ?? 'Données indisponibles.' }}</div>
    {% else %}
    <div class="rpt">

        {# ── En-tête ── #}
        <div class="rpt-head">
            <h1 class="rpt-title">
                {{ report.type == 'month' ? (translations.report_monthly ?? 'Rapport mensuel') : (translations.report_weekly ?? 'Rapport hebdomadaire') }}
            </h1>
            <div class="rpt-meta">
                <span><b>{{ translations.period ?? 'Période' }} :</b> {{ report.period.label }}</span>
                <span><b>{{ translations.scope ?? 'Périmètre' }} :</b> {{ report.scope.label }}</span>
                {% if report.consultant %}<span><b>{{ translations.consultant ?? 'Consultant' }} :</b> {{ report.consultant }}</span>{% endif %}
                <span><b>{{ translations.generated_at ?? 'Généré le' }} :</b> {{ report.generated_at }}</span>
            </div>
        </div>

        {% if report.network %}
        {# ══ Vue RÉSEAU consolidée (toutes les boutiques) — 3 onglets ══ #}
        {% set net = report.network %}
        {% set st_icon = {'ok': '✓', 'mid': '⚠', 'bad': '●', 'nd': '·'} %}
        <div class="rpt-tabs rpt-noprint" role="tablist">
            <button type="button" class="rpt-tab is-active" data-tab="dash">{{ translations.tab_dashboard ?? 'Tableau de bord' }}</button>
            <button type="button" class="rpt-tab" data-tab="heat">{{ translations.tab_heatmap ?? 'Heatmap' }}</button>
            <button type="button" class="rpt-tab" data-tab="synth">{{ translations.tab_summary ?? 'Synthèse' }}</button>
        </div>

        {# KPI réseau — communs, en tête de chaque onglet à l'impression #}
        {% set net_kpis %}
            <div class="rpt-kpis">
                <div class="rpt-kpi"><div class="rpt-kpi-v">{{ (net.kpis.ca ?? 0)|number_format(0, ',', ' ') }} {{ currency_symbol }}</div><div class="rpt-kpi-l">{{ translations.turnover ?? "Chiffre d'affaires" }}</div></div>
                <div class="rpt-kpi"><div class="rpt-kpi-v">{{ (net.kpis.tickets ?? 0)|number_format(0, ',', ' ') }}</div><div class="rpt-kpi-l">{{ translations.tickets ?? 'Tickets' }}</div></div>
                <div class="rpt-kpi"><div class="rpt-kpi-v">{{ net.kpis.basket is not null ? (net.kpis.basket|number_format(2, ',', ' ') ~ ' ' ~ currency_symbol) : '—' }}</div><div class="rpt-kpi-l">{{ translations.avg_basket ?? 'Panier moyen' }}</div></div>
                <div class="rpt-kpi"><div class="rpt-kpi-v {{ net.kpis.evo is not null ? (net.kpis.evo >= 0 ? 'rpt-up' : 'rpt-down') }}">{{ net.kpis.evo is not null ? ((net.kpis.evo >= 0 ? '+' : '') ~ (net.kpis.evo|number_format(1, ',', ' ')) ~ ' %') : '—' }}</div><div class="rpt-kpi-l">{{ translations.ca ?? 'CA' }} vs N-1</div></div>
            </div>
        {% endset %}

        {# ── Onglet 1 : Tableau de bord + classement ── #}
        <div class="rpt-tabview" data-tab="dash">
            <div class="rpt-print-title">{{ translations.tab_dashboard ?? 'Tableau de bord' }}</div>
            {{ net_kpis }}
            <div class="rpt-tbl-wrap" style="margin-top:12px;">
                <table class="rpt-tbl">
                    <thead><tr>
                        <th class="num">{{ translations.health ?? 'Santé' }}</th>
                        <th>{{ translations.shop ?? 'Boutique' }}</th>
                        <th class="num">{{ translations.ca ?? 'CA' }}</th>
                        <th class="num">{{ translations.n1 ?? 'N-1' }}</th>
                        <th class="num">{{ translations.avg_basket ?? 'Panier' }}</th>
                        <th class="num">{{ translations.network ?? 'Réseau' }}</th>
                    </tr></thead>
                    <tbody>
                    {% for s in net.shops %}
                        <tr>
                            <td class="num"><span class="rpt-dot st-{{ s.status }}">{{ st_icon[s.status] ?? '·' }}</span></td>
                            <td>{{ s.name }}</td>
                            <td class="num">{{ s.ca|number_format(0, ',', ' ') }} {{ currency_symbol }}</td>
                            <td class="num">{% if s.evo is not null %}<span class="{{ s.evo >= 0 ? 'rpt-up' : 'rpt-down' }}">{{ s.evo >= 0 ? '▲ +' : '▼ −' }}{{ (s.evo < 0 ? -s.evo : s.evo)|number_format(1, ',', ' ') }} %</span>{% else %}—{% endif %}</td>
                            <td class="num">{{ s.basket is not null ? (s.basket|number_format(2, ',', ' ') ~ ' ' ~ currency_symbol) : '—' }}</td>
                            <td class="num">{% if s.delta_basket is not null %}<span class="{{ s.delta_basket >= 0 ? 'rpt-up' : 'rpt-down' }}">{{ s.delta_basket >= 0 ? '▲ +' : '▼ −' }}{{ (s.delta_basket < 0 ? -s.delta_basket : s.delta_basket)|number_format(0, ',', ' ') }} %</span>{% else %}—{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="rpt-hexm-legend" style="margin-top:8px;">
                <span>{{ translations.objectives_reached ?? 'Objectifs atteints' }} — {{ translations.tickets ?? 'Clients' }} {{ net.objectives.clients }} · {{ translations.avg_basket ?? 'Panier' }} {{ net.objectives.basket }} · B2B {{ net.objectives.b2b }}</span>
            </div>
        </div>

        {# ── Onglet 2 : Heatmap santé (boutiques × leviers) ── #}
        <div class="rpt-tabview" data-tab="heat" hidden>
            <div class="rpt-print-title">{{ translations.tab_heatmap ?? 'Heatmap' }}</div>
            {{ net_kpis }}
            <div class="rpt-tbl-wrap" style="margin-top:12px;">
                <table class="rpt-heat">
                    <thead><tr><th class="nm"></th>{% for d in net.lever_defs %}<th title="{{ d.name }}">{{ d.letter }}</th>{% endfor %}</tr></thead>
                    <tbody>
                    {% for s in net.shops %}
                        <tr>
                            <td class="nm">{{ s.name }}</td>
                            {% for d in net.lever_defs %}
                                {% set stt = s.levers[d.key] ?? 'nd' %}
                                <td><div class="rpt-heat-cell st-{{ stt }}">{{ st_icon[stt] ?? '·' }}</div></td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="rpt-hexm-legend" style="margin-top:8px;">
                {% for d in net.lever_defs %}<span>{{ d.letter }} = {{ d.name }}</span>{% endfor %}
            </div>
            <div class="rpt-hexm-legend">
                <span class="rpt-st-ok">✓ {{ translations.legend_good ?? 'bon' }}</span>
                <span class="rpt-st-mid">⚠ {{ translations.legend_mid ?? 'attention' }}</span>
                <span class="rpt-st-bad">● {{ translations.legend_bad ?? 'danger' }}</span>
                <span>{{ translations.legend_vs ?? 'vs moyenne réseau' }}</span>
            </div>
        </div>

        {# ── Onglet 3 : Synthèse dirigeant ── #}
        <div class="rpt-tabview" data-tab="synth" hidden>
            <div class="rpt-print-title">{{ translations.tab_summary ?? 'Synthèse' }}</div>
            {{ net_kpis }}
            {% if net.attention is not empty %}
                <div class="rpt-syn-h rpt-st-bad">⚠ {{ translations.attention_points ?? "Points d'attention" }}</div>
                {% for a in net.attention %}
                    <div class="rpt-syn-item"><span class="rpt-dot st-bad">●</span><div><b>{{ a.name }}</b> — {{ a.reasons|join(' · ') }}</div></div>
                {% endfor %}
            {% endif %}
            {% if net.strong is not empty %}
                <div class="rpt-syn-h rpt-st-ok">✓ {{ translations.strong_points ?? 'Points forts' }}</div>
                {% for s in net.strong %}
                    <div class="rpt-syn-item"><span class="rpt-dot st-ok">▲</span><div><b>{{ s.name }}</b> — {{ translations.turnover ?? 'CA' }} {{ s.evo >= 0 ? '+' : '' }}{{ s.evo|number_format(1, ',', ' ') }} %</div></div>
                {% endfor %}
            {% endif %}
            {% if net.top is not empty %}
                <div class="rpt-syn-h">{{ translations.ranking ?? 'Palmarès' }}</div>
                <div class="rpt-syn-item"><span class="rpt-chip">Top</span></div>
                {% for t in net.top %}
                    <div class="rpt-syn-item">
                        <span class="rpt-dot st-{{ t.status }}">{{ st_icon[t.status] ?? '·' }}</span>
                        <div><b>{{ t.name }}</b> {{ t.evo >= 0 ? '+' : '' }}{{ t.evo|number_format(1, ',', ' ') }} %<span class="rpt-treflo">{% for d in net.lever_defs %}<b class="tf-{{ t.levers[d.key] ?? 'nd' }}" title="{{ d.name }}">{{ d.letter }}</b>{% endfor %}</span></div>
                    </div>
                {% endfor %}
                <div class="rpt-syn-item"><span class="rpt-chip">Flop</span></div>
                {% for t in net.flop %}
                    <div class="rpt-syn-item">
                        <span class="rpt-dot st-{{ t.status }}">{{ st_icon[t.status] ?? '·' }}</span>
                        <div><b>{{ t.name }}</b> {{ t.evo >= 0 ? '+' : '' }}{{ t.evo|number_format(1, ',', ' ') }} %<span class="rpt-treflo">{% for d in net.lever_defs %}<b class="tf-{{ t.levers[d.key] ?? 'nd' }}" title="{{ d.name }}">{{ d.letter }}</b>{% endfor %}</span></div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        {# ── Réclamations réseau (résumé) ── #}
        <div class="rpt-shop">
            <div class="rpt-shop-name">{{ icons.svg('circle-alert', 15) }} {{ translations.supplier_claims ?? 'Réclamations fournisseurs' }} — {{ translations.network ?? 'Réseau' }} ({{ net.claims_total }})</div>
            <div class="rpt-shop-body">
                {% if net.claims_top is empty %}
                    <div class="rpt-empty">{{ translations.no_claims ?? 'Aucune réclamation sur la période.' }}</div>
                {% else %}
                    <table class="rpt-tbl"><tbody>
                    {% for sup, cnt in net.claims_top %}
                        <tr><td>{{ icons.svg('package', 13) }} {{ sup }}</td><td class="num"><span class="rpt-badge">{{ cnt }}</span></td></tr>
                    {% endfor %}
                    </tbody></table>
                {% endif %}
            </div>
        </div>

        {# ── Campagnes commerciales réseau (rapport mensuel) ── #}
        {% if net.campaigns is defined and net.campaigns is not empty %}
        <div class="rpt-shop">
            <div class="rpt-shop-name">{{ icons.svg('tag', 15) }} {{ translations.campaigns ?? 'Campagnes commerciales' }} — {{ translations.network ?? 'Réseau' }}{% if net.campaigns_totals.pct is not null %} · {{ net.campaigns_totals.pct|number_format(0, ',', ' ') }} %{% endif %}</div>
            <div class="rpt-shop-body">
                {% for c in net.campaigns %}
                    {% set cst = c.pct is null ? 'nd' : (c.pct >= 95 ? 'ok' : (c.pct >= 80 ? 'mid' : 'bad')) %}
                    <div class="rpt-camp">
                        <div class="rpt-camp-h">
                            <span class="rpt-camp-nm">{{ c.name }}</span>
                            {% if c.type %}<span class="rpt-camp-type">{{ c.type }}</span>{% endif %}
                            <span class="rpt-camp-pct rpt-v-{{ cst }}">{{ c.pct is not null ? (c.pct|number_format(0, ',', ' ') ~ ' %') : '—' }}</span>
                        </div>
                        {% if c.target is not null %}
                            <div class="rpt-camp-bar"><i class="rpt-fill-{{ cst }}" style="width:{{ c.pct is null ? 0 : (c.pct > 100 ? 100 : c.pct)|round }}%;"></i></div>
                            <div class="rpt-camp-meta">{{ translations.turnover ?? 'CA' }} <b>{{ (c.actual ?? 0)|number_format(0, ',', ' ') }} {{ currency_symbol }}</b> / {{ c.target|number_format(0, ',', ' ') }} {{ currency_symbol }} · {{ c.shops }} {{ translations.shop ?? 'boutique' }}(s)</div>
                        {% endif %}
                        {% if c.leads_generated is not null %}
                            <div class="rpt-camp-meta">{{ translations.leads ?? 'Leads' }} <b>{{ c.leads_generated }}</b> → <b>{{ c.leads_opened ?? 0 }}</b>{% if c.conv is not null %} ({{ c.conv|number_format(0, ',', ' ') }} % {{ translations.conversion ?? 'conversion' }}){% endif %}</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% else %}
        {# ── Sections par boutique ── #}
        {% for shop in report.shops %}
        <div class="rpt-shop">
            <div class="rpt-shop-name">{{ shop.name }}</div>
            <div class="rpt-shop-body">

                {# Performance & leviers HEXm #}
                <div class="rpt-sec">
                    <div class="rpt-sec-h">{{ icons.svg('hexm', 14) }}{{ translations.performance ?? 'Performance (Hexm)' }}</div>
                    <div class="rpt-kpis">
                        <div class="rpt-kpi">
                            <div class="rpt-kpi-v">{{ (shop.kpis.ca ?? 0)|number_format(0, ',', ' ') }} {{ currency_symbol }}</div>
                            <div class="rpt-kpi-l">{{ translations.turnover ?? "Chiffre d'affaires" }}</div>
                        </div>
                        <div class="rpt-kpi">
                            <div class="rpt-kpi-v">{{ (shop.kpis.tickets ?? 0)|number_format(0, ',', ' ') }}</div>
                            <div class="rpt-kpi-l">{{ translations.tickets ?? 'Tickets' }}</div>
                        </div>
                        <div class="rpt-kpi">
                            <div class="rpt-kpi-v">{{ shop.kpis.avg_basket is not null ? (shop.kpis.avg_basket|number_format(2, ',', ' ') ~ ' ' ~ currency_symbol) : '—' }}</div>
                            <div class="rpt-kpi-l">{{ translations.avg_basket ?? 'Panier moyen' }}</div>
                        </div>
                        <div class="rpt-kpi">
                            <div class="rpt-kpi-v">{{ shop.kpis.products_per_ticket is not null ? shop.kpis.products_per_ticket|number_format(2, ',', ' ') : '—' }}</div>
                            <div class="rpt-kpi-l">{{ translations.products_per_ticket ?? 'Produits / ticket' }}</div>
                        </div>
                    </div>

                    {# Les 6 leviers HEXm (vrais tags/couleurs officiels), résultat de la
                       période et statut ✓/⚠/● vs moyenne réseau (comme l'écran HEXm). #}
                    {% if shop.hexm.levers is defined %}
                        {% set st_icon = {'ok': '✓', 'mid': '⚠', 'bad': '●'} %}
                        <div class="rpt-hexm">
                            {% for lev in shop.hexm.levers %}
                                {% set shown = false %}
                                {% for k in lev.kpis %}{% if k.value is not null %}{% set shown = true %}{% endif %}{% endfor %}
                                <div class="rpt-lev rpt-st-{{ lev.status }}{{ shown ? '' : ' rpt-lev--soon' }}">
                                    <span class="rpt-lev-badge" style="background:{{ lev.color }};">{{ lev.letter ?? lev.num }}</span>
                                    <span class="rpt-lev-nm">{{ lev.tag_name ?? lev.name }}</span>
                                    <span class="rpt-lev-kpis">
                                        {% if shown %}
                                            {% for k in lev.kpis %}{% if k.value is not null %}<span class="rpt-lev-kpi"><i>{{ k.label }}</i><b class="rpt-v-{{ k.status }}">{{ k.value }}</b></span>{% endif %}{% endfor %}
                                        {% else %}
                                            <span class="rpt-lev-soon">{{ translations.data_soon ?? 'données à venir' }}</span>
                                        {% endif %}
                                    </span>
                                    <span class="rpt-lev-st">{{ shown ? (st_icon[lev.status] ?? '') : '' }}</span>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="rpt-hexm-legend">
                            <span class="rpt-st-ok">✓ {{ translations.legend_good ?? 'bon' }}</span>
                            <span class="rpt-st-mid">⚠ {{ translations.legend_mid ?? 'attention' }}</span>
                            <span class="rpt-st-bad">● {{ translations.legend_bad ?? 'danger' }}</span>
                            <span>{{ translations.legend_vs ?? 'vs moyenne réseau' }}</span>
                        </div>
                    {% endif %}
                </div>

                {# Objectifs franchisé : Clients / Panier / B2B — réalisé vs N-1 vs objectif #}
                <div class="rpt-sec">
                    <div class="rpt-sec-h">{{ icons.svg('target', 14) }}{{ translations.targets ?? 'Objectifs' }}{% if shop.targets_label %} — {{ shop.targets_label }}{% endif %}</div>
                    {% if shop.franchise is defined and shop.franchise is not empty %}
                        <div class="rpt-tbl-wrap">
                        <table class="rpt-tbl">
                            <thead><tr>
                                <th>{{ translations.kpi ?? 'Indicateur' }}</th>
                                <th class="num">{{ translations.n1 ?? 'N-1' }}</th>
                                <th class="num">{{ translations.actual ?? 'Réalisé' }}</th>
                                <th class="num">{{ translations.network ?? 'Réseau' }}</th>
                                <th class="num">{{ translations.objective ?? 'Objectif' }}</th>
                            </tr></thead>
                            <tbody>
                            {% for k in shop.franchise %}
                                {% set dec = (k.unit == 'amount') ? 2 : 0 %}
                                {% set u = (k.unit == 'amount') ? ' ' ~ currency_symbol : (k.unit == 'pct' ? ' %' : '') %}
                                {# Ligne 1 — les données : N-1, réalisé, moyenne réseau, cible. #}
                                <tr class="rpt-fr-data">
                                    <td rowspan="2" class="rpt-fr-label">{{ k.label }}</td>
                                    <td class="num">{{ k.n1 is not null ? (k.n1|number_format(dec, ',', ' ') ~ u) : '—' }}</td>
                                    <td class="num rpt-cell-main">{{ k.val is not null ? (k.val|number_format(dec, ',', ' ') ~ u) : '—' }}</td>
                                    <td class="num">{{ k.net is not null ? (k.net|number_format(dec, ',', ' ') ~ u) : '—' }}</td>
                                    <td class="num">{{ k.obj is not null ? (k.obj|number_format(dec, ',', ' ') ~ u) : '—' }}</td>
                                </tr>
                                {# Ligne 2 — les pourcentages : évolution vs N-1, écart vs réseau, niveau vs objectif. #}
                                <tr class="rpt-fr-pct">
                                    <td class="num"></td>
                                    <td class="num">{% if k.evo is not null %}<span class="{{ k.evo >= 0 ? 'rpt-up' : 'rpt-down' }}">{{ k.evo >= 0 ? '▲ +' : '▼ −' }}{{ (k.evo < 0 ? -k.evo : k.evo)|number_format(1, ',', ' ') }} %</span>{% else %}<span class="rpt-fr-dash">—</span>{% endif %}</td>
                                    <td class="num">{% if k.delta is not null %}<span class="{{ k.delta >= 0 ? 'rpt-up' : 'rpt-down' }}">{{ k.delta >= 0 ? '▲ +' : '▼ −' }}{{ (k.delta < 0 ? -k.delta : k.delta)|number_format(0, ',', ' ') }} %</span>{% else %}<span class="rpt-fr-dash">—</span>{% endif %}</td>
                                    <td class="num">{% if k.pct is not null %}<span class="rpt-v-{{ k.status }}">{{ k.pct|number_format(0, ',', ' ') }} %</span>{% else %}<span class="rpt-fr-dash">—</span>{% endif %}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        </div>
                        <div class="rpt-hexm-legend">
                            <span><span class="rpt-up">▲</span>/<span class="rpt-down">▼</span> {{ translations.legend_evo ?? 'évol. vs N-1' }} · {{ translations.legend_vs ?? 'vs moyenne réseau' }}</span>
                            <span class="rpt-st-ok">✓ {{ translations.legend_good ?? 'bon' }}</span>
                            <span class="rpt-st-mid">⚠ {{ translations.legend_mid ?? 'attention' }}</span>
                            <span class="rpt-st-bad">● {{ translations.legend_bad ?? 'danger' }}</span>
                            <span>{{ translations.legend_vs_obj ?? 'vs objectif' }}</span>
                        </div>
                    {% else %}
                        <div class="rpt-empty">{{ translations.no_targets ?? 'Aucun objectif défini.' }}</div>
                    {% endif %}
                </div>

                {# Notes & photos #}
                <div class="rpt-sec">
                    <div class="rpt-sec-h">{{ icons.svg('square-pen', 14) }}{{ translations.notes_photos ?? 'Notes & photos' }} ({{ shop.notes|length }})</div>
                    {% if shop.notes is empty %}
                        <div class="rpt-empty">{{ translations.no_notes ?? 'Aucune note sur la période.' }}</div>
                    {% else %}
                        {% for n in shop.notes %}
                        <div class="rpt-note">
                            <div class="rpt-note-meta">
                                {{ n.created_at|slice(0,16)|replace({'T': ' '}) }}
                                {% if n.type_name %}· <span class="rpt-badge">{{ n.type_name }}</span>{% endif %}
                            </div>
                            {% if n.content %}<p class="rpt-note-text">{{ n.content }}</p>{% endif %}
                            {% if n.photos_view is not empty %}
                                <div class="rpt-thumbs">
                                    {% for p in n.photos_view %}<img class="rpt-thumb" src="{{ p.url }}" alt="{{ translations.photo_alt ?? 'photo' }}" loading="lazy">{% endfor %}
                                </div>
                            {% endif %}
                            {# Commentaires (filles) de la note #}
                            {% if n.comments_view is defined and n.comments_view is not empty %}
                                <div class="rpt-replies">
                                    {% for c in n.comments_view %}
                                    <div class="rpt-reply">
                                        <div class="rpt-reply-meta">{{ c.author ?: (translations.consultant ?? 'Consultant') }} · {{ (c.created_at ?? '')|slice(0,16)|replace({'T': ' '}) }}</div>
                                        {% if c.content %}<p class="rpt-reply-text">{{ c.content }}</p>{% endif %}
                                        {% if c.photos_view is not empty %}
                                            <div class="rpt-thumbs">
                                                {% for p in c.photos_view %}<img class="rpt-thumb" src="{{ p.url }}" alt="{{ translations.photo_alt ?? 'photo' }}" loading="lazy">{% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                        {% endfor %}
                    {% endif %}
                </div>

                {# Réclamations fournisseurs #}
                <div class="rpt-sec">
                    <div class="rpt-sec-h">{{ icons.svg('circle-alert', 14) }}{{ translations.supplier_claims ?? 'Réclamations fournisseurs' }}</div>
                    {% if shop.claims_by_supplier is empty %}
                        <div class="rpt-empty">{{ translations.no_claims ?? 'Aucune réclamation sur la période.' }}</div>
                    {% else %}
                        {% for supplier, claims in shop.claims_by_supplier %}
                            <div class="rpt-supplier">{{ icons.svg('package', 13) }} {{ supplier }} ({{ claims|length }})</div>
                            <table class="rpt-tbl">
                                <tbody>
                                {% for c in claims %}
                                    <tr>
                                        <td style="width:88px;white-space:nowrap;color:#6c757d;">{{ (c.reported_at ?? '')|slice(0,10) }}</td>
                                        <td>{{ c.material_name ?? c.complaint_key ?? '—' }}{% if c.qty is defined and c.qty %} <span style="color:#6c757d;">({{ c.qty }}{{ c.unit_name is defined ? ' ' ~ c.unit_name : '' }})</span>{% endif %}</td>
                                        <td class="num"><span class="rpt-badge">{{ c.status ?? 'NEW' }}</span></td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        {% endfor %}
                    {% endif %}
                </div>

                {# Campagnes commerciales (rapport mensuel) #}
                {% if shop.campaigns is defined and shop.campaigns is not empty %}
                <div class="rpt-sec">
                    <div class="rpt-sec-h">{{ icons.svg('tag', 14) }}{{ translations.campaigns ?? 'Campagnes commerciales' }}</div>
                    {% for c in shop.campaigns %}
                        {% set cst = c.pct is null ? 'nd' : (c.pct >= 95 ? 'ok' : (c.pct >= 80 ? 'mid' : 'bad')) %}
                        <div class="rpt-camp">
                            <div class="rpt-camp-h">
                                <span class="rpt-camp-nm">{{ c.name }}</span>
                                {% if c.type %}<span class="rpt-camp-type">{{ c.type }}</span>{% endif %}
                                <span class="rpt-camp-pct rpt-v-{{ cst }}">{{ c.pct is not null ? (c.pct|number_format(0, ',', ' ') ~ ' %') : '—' }}</span>
                            </div>
                            {% if c.target is not null %}
                                <div class="rpt-camp-bar"><i class="rpt-fill-{{ cst }}" style="width:{{ c.pct is null ? 0 : (c.pct > 100 ? 100 : c.pct)|round }}%;"></i></div>
                                <div class="rpt-camp-meta">{{ translations.turnover ?? 'CA' }} <b>{{ (c.actual ?? 0)|number_format(0, ',', ' ') }} {{ currency_symbol }}</b> / {{ c.target|number_format(0, ',', ' ') }} {{ currency_symbol }}</div>
                            {% endif %}
                            {% if c.leads_generated is not null %}
                                <div class="rpt-camp-meta">{{ translations.leads ?? 'Leads' }} <b>{{ c.leads_generated }}</b> → <b>{{ c.leads_opened ?? 0 }}</b>{% if c.conv is not null %} ({{ c.conv|number_format(0, ',', ' ') }} % {{ translations.conversion ?? 'conversion' }}){% endif %}</div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                {% endif %}

            </div>
        </div>
        {% endfor %}
        {% endif %}

        {# ── Demandes (Helpdesk) ── #}
        <div class="rpt-shop">
            <div class="rpt-shop-name">{{ icons.svg('life-buoy', 15) }} {{ translations.demandes ?? 'Demandes (Helpdesk)' }} ({{ report.demandes|length }})</div>
            <div class="rpt-shop-body">
                {% if report.demandes is empty %}
                    <div class="rpt-empty">{{ translations.no_demandes ?? 'Aucune demande sur la période.' }}</div>
                {% else %}
                    <table class="rpt-tbl">
                        <thead><tr>
                            <th style="width:78px;">{{ translations.date ?? 'Date' }}</th>
                            <th>{{ translations.request ?? 'Demande' }}</th>
                            <th>{{ translations.shop ?? 'Boutique' }}</th>
                            <th class="num">{{ translations.status ?? 'Statut' }}</th>
                        </tr></thead>
                        <tbody>
                        {% for d in report.demandes %}
                            <tr>
                                <td style="white-space:nowrap;color:#6c757d;">{{ (d.created_at ?? '')|slice(0,10) }}</td>
                                <td>
                                    <b>{{ d.title ?? d.ref ?? d.subject ?? ('#' ~ (d.id ?? '')) }}</b>
                                    {% if d.requester_name is defined and d.requester_name %}<br><span style="color:#6c757d;font-size:.72rem;">{{ translations.requested_by ?? 'Demandé par' }} {{ d.requester_name }}</span>{% endif %}
                                </td>
                                <td style="font-size:.78rem;">{{ d.shop_name ?? '—' }}</td>
                                <td class="num"><span class="rpt-badge">{{ d.status ?? '—' }}</span></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>

        {# ── Tâches réalisées ── #}
        <div class="rpt-shop">
            <div class="rpt-shop-name">{{ icons.svg('square-check', 15) }} {{ translations.tasks_done ?? 'Tâches réalisées' }} ({{ report.tasks_done|length }})</div>
            <div class="rpt-shop-body">
                {% if report.tasks_done is empty %}
                    <div class="rpt-empty">{{ translations.no_tasks_done ?? 'Aucune tâche réalisée sur la période.' }}</div>
                {% else %}
                    <table class="rpt-tbl">
                        <thead><tr>
                            <th style="width:88px;">{{ translations.date ?? 'Date' }}</th>
                            <th>{{ translations.task ?? 'Tâche' }}</th>
                        </tr></thead>
                        <tbody>
                        {% for t in report.tasks_done %}
                            <tr>
                                <td style="white-space:nowrap;color:#6c757d;">{{ (t.completed_at ?? '')|slice(0,10) }}</td>
                                <td>{{ t.name }}{% if t.category %} <span style="color:#6c757d;font-size:.74rem;">· {{ t.category }}</span>{% endif %}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>

    </div>
    {% endif %}

</div>

{# Onglets de la vue réseau : bascule client-side (toggle). #}
<script>
(function () {
    var tabs = document.querySelectorAll('.rpt-tab');
    var views = document.querySelectorAll('.rpt-tabview');
    tabs.forEach(function (t) {
        t.addEventListener('click', function () {
            var name = t.getAttribute('data-tab');
            tabs.forEach(function (x) { x.classList.toggle('is-active', x === t); });
            views.forEach(function (v) { v.hidden = v.getAttribute('data-tab') !== name; });
        });
    });
})();
</script>
{% endblock %}
